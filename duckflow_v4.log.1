<<<
# DUCKFLOW CORE SYSTEM
# Created: 2026-02-23 23:32:29
# Description: Main orchestration engine for Duckflow system

from companion.modules.pacemaker import Pacemaker
from companion.modules.command_handler import CommandHandler
from companion.modules.sub_llm_manager import SubLLMManager
from companion.modules.session_manager import SessionManager
from companion.modules.model_manager import ModelManager
from companion.modules.archive import ArchiveManager
from companion.modules.memory import MemoryManager
from companion.state.agent_state import AgentState
from companion.state.transition_controller import TransitionController
from companion.execution.task_executor import TaskExecutor
from companion.logging.log_manager import LogManager
from companion.utils.parser import parse_sym_ops
from companion.output.human_formatter import HumanFormatter
from companion.security.file_protector import FileProtector
from companion.modules.pecking_order import PeckingOrder

import os
import sys
import time
import json
from datetime import datetime

class DuckflowCore:
    """
    The main orchestration engine that manages the dual-loop system
    and coordinates all components.
    """
    
    def __init__(self):
        # Initialize state management
        self.state = AgentState()
        self.transition_controller = TransitionController()
        
        # Initialize managers
        self.pacemaker = Pacemaker()
        self.command_handler = CommandHandler()
        self.sub_llm_manager = SubLLMManager()
        self.session_manager = SessionManager()
        self.model_manager = ModelManager()
        self.archive_manager = ArchiveManager()
        self.memory_manager = MemoryManager()
        self.log_manager = LogManager()
        self.file_protector = FileProtector()
        self.pecking_order = PeckingOrder()
        
        # Initialize execution
        self.task_executor = TaskExecutor(
            state=self.state,
            transition_controller=self.transition_controller,
            sub_llm_manager=self.sub_llm_manager,
            pacemaker=self.pacemaker,
            log_manager=self.log_manager,
            pecking_order=self.pecking_order
        )
        
        # Initialize output formatter
        self.formatter = HumanFormatter()
        
        # Session tracking
        self.session_id = None
        self.is_running = False
        
    def initialize_session(self):
        """Initialize a new session"""
        self.session_id = self.session_manager.create_session()
        self.log_manager.initialize(self.session_id)
        self.state.session_id = self.session_id
        
        # Load conversation memory
        self.memory_manager.load_memory(self.session_id)
        
        self.log_manager.log("SYSTEM", f"Session {self.session_id} initialized")
        
    def handle_user_input(self, user_input: str):
        """Process user input and execute tasks"""
        if not self.session_id:
            self.initialize_session()
            
        # Parse user input
        parsed = self.parse_input(user_input)
        
        # Update state
        self.state.update_from_input(parsed)
        
        # Log user input
        self.log_manager.log("USER", user_input)
        
        # Execute task
        result = self.execute_task(parsed)
        
        # Save session
        self.session_manager.save_session(self.state)
        self.memory_manager.save_memory(self.session_id, self.state)
        
        return result
        
    def parse_input(self, user_input: str) -> dict:
        """Parse user input into structured format"""
        # Use parser utility
        parsed = parse_sym_ops(user_input)
        
        # Check for commands
        if parsed.get('action') == 'command':
            return self.command_handler.handle(parsed)
            
        return parsed
        
    def execute_task(self, parsed_input: dict) -> str:
        """Execute the task based on parsed input"""
        # Validate input with pecking order
        if not self.pecking_order.validate_task(parsed_input):
            return "Task validation failed: Insufficient permissions or invalid task"
        
        # Execute task
        result = self.task_executor.execute(parsed_input)
        
        # Format output
        formatted = self.formatter.format(result)
        
        # Archive result
        self.archive_manager.archive_result(result)
        
        return formatted
        
    def run_loop(self):
        """Main execution loop"""
        self.is_running = True
        self.initialize_session()
        
        self.formatter.welcome_message()
        
        try:
            while self.is_running:
                # Get user input
                user_input = input("\n>> ")
                
                if user_input.lower() in ['exit', 'quit']:
                    self.is_running = False
                    break
                    
                # Process input
                result = self.handle_user_input(user_input)
                
                # Display result
                print(result)
                
        except KeyboardInterrupt:
            print("\n\nInterrupted by user")
        except Exception as e:
            print(f"\n\nError: {str(e)}")
            self.log_manager.log("ERROR", str(e))
        finally:
            self.shutdown()
            
    def shutdown(self):
        """Shutdown the system gracefully"""
        self.log_manager.log("SYSTEM", "Shutting down")
        self.session_manager.save_session(self.state)
        self.memory_manager.save_memory(self.session_id, self.state)
        self.is_running = False
        print("Goodbye!")
        
    def run_command_mode(self, command: str):
        """Run in single command mode"""
        self.initialize_session()
        result = self.handle_user_input(command)
        print(result)
        self.shutdown()

if __name__ == "__main__":
    core = DuckflowCore()
    
    if len(sys.argv) > 1:
        # Command mode
        command = " ".join(sys.argv[1:])
        core.run_command_mode(command)
    else:
        # Interactive mode
        core.run_loop()
