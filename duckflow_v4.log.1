                    logger.error(f"Error executing action {action.name}: {e}", exc_info=True)
                    error_msg = f"Error executing action '{action.name}': {str(e)}"
                    ui.print_result(error_msg, is_error=True)
                    self.state.last_action_result = error_msg
                    
                    # Add error to conversation history
                    error_context = (
                        f"[Error executing action '{action.name}'] "
                        f"Error: {str(e)}. "
                        f"Please analyze the error and try a different approach or ask the user for guidance."
                    )
                    self.state.add_message("assistant", error_context)
                    
                    # Update Pacemaker vitals (error)
                    self.pacemaker.update_vitals(action, error_msg, is_error=True)
                    
                    results.append(error_msg)
            else:
                error_msg = f"Tool '{action.name}' not found"
                ui.print_result(error_msg, is_error=True)
                self.state.last_action_result = error_msg
                results.append(error_msg)
                
                # Add error to conversation history
                error_context = (
                    f"[Error: Tool not found '{action.name}'] "
                    f"Available tools: {list(self.tools.keys())}. "
                    LLM should recognize that this tool is not available and try a different approach."
                )
                self.state.add_message("assistant", error_text)
        
        # Record all results
        self.state.last_action_result = f"Actions completed: {len(results)} results"
        
        # If the last action was a response, don't add to history (already handled)
        # If the last action was NOT a response, add a summary to history for next LLM cycle
        if action_list.actions and action_list.actions[-1].name != "response":
            summary = f"Actions executed: {', '.join([a.name for a in action_list.actions])}."
            self.state.add_message("assistant", summary)
        
        return results

