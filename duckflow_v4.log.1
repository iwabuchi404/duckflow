content: import logging
from typing import Optional, List
from companion.state.agent_state import AgentState, AgentPhase
from companion.ui import ui

logger = logging.getLogger(__name__)

class Intervention:
    """
    Pacemaker intervention event.
    Generated when the autonomous loop exceeds safety/health thresholds.
    """
    def __init__(self, type: str, message: str):
        self.type = type
        self.message = message

class DuckPacemaker:
    """
    Pacemaker monitors the health of the autonomous loop.
    It tracks loop count, duration, and action success rate.
    It can trigger duck_call (user intervention) if thresholds are exceeded.
    """
    def __init__(self, state: AgentState):
        self.state = state
        self.loop_count = 0
        self.max_loops = 10  # Default, can be overridden
        self.error_rate = 0.0
        self.consecutive_errors = 0
        self.consecutive_successes = 0
        self.intervention_history: List[Intervention] = []

    def calculate_max_loops(self) -> int:
        """
        Calculate maximum loops based on current state.
        """
        # Default to 10 loops
        base_max = 10
        
        # If there's an active plan, allow more loops
        if self.state.plan and self.state.plan.steps:
            base_max = 20
        
        # If there's a task list, allow even more
        if self.state.tasks and len(self.state.tasks) > 0:
            base_max = 30
        
        # If there's a complex task (multiple steps and tasks), allow even more
        if (self.state.plan and len(self.state.plan.steps) > 3) or (self.state.tasks and len(self.state.tasks) > 5):
            base_max = 50
        
        # Cap at 50 to prevent infinite loops
        if base_max > 50:
            base_max = 50
        
        # Override from environment or config if needed (not implemented yet)
        # Could also check if user has set a custom limit
        
        return base_max

    def check_health(self) -> Optional[Intervention]:
        """
        Check if the loop is healthy.
        Returns Intervention if intervention is needed, None otherwise.
        """
        # Check 1: Max loops exceeded
        if self.loop_count > self.max_loops:
            msg = f"Max loops ({self.max_loops}) exceeded. Current: {self.loop_count}"
            logger.warning(msg)
            return Intervention("MAX_LOOPS_EXCEEDED", msg)
        
        # Check 2: High error rate
        if self.error_rate > 0.5 and self.loop_count > 3:
            msg = f"High error rate ({self.error_rate:.2f}). Loop count: {self.loop_count}"
            logger.warning(msg)
            return Intervention("HIGH_ERROR_RATE", msg)
        
        # Check 3: Consecutive errors
        if self.consecutive_errors >= 3:
            msg = f"Consecutive errors: {self.consecutive_errors}"
            logger.warning(msg)
            return Intervention("CONSECUTIVE_ERRORS", msg)
        
        # No intervention needed
        return None

    def update_vitals(self, action, result, is_error: bool = False):
        """
        Update pacemaker vitals based on action execution result.
        """
        if is_error:
            self.consecutive_errors += 1
            self.consecutive_successes = 0
        else:
            self.consecutive_successes += 1
            self.consecutive_errors = 0
        
        # Calculate error rate (simple rolling average)
        # This is a simplified calculation
        total_actions = self.consecutive_errors + self.consecutive_successes
        if total_actions > 0:
            self.error_rate = self.consecutive_errors / total_actions

    def reset(self):
        """
        Reset counters for next session.
        """
        self.loop_count = 0
        self.error_rate = 0.0
        self.consecutive_errors = 0
        self.consecutive_successes = 0

    def intervene(self, intervention: Intervention) -> 'Action':
        """
        Create an intervention action (duck_call) to present to the user.
        """
        from companion.state.agent_state import Action
        return Action(
            name="duck_call",
            parameters={"message": intervention.message},
            thought=f"Pacemaker intervention triggered: {intervention.type}"
        )::status ok
::finish_investigation @task
