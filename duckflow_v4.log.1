interface System {
  initialize(engine: Engine): Promise<void>;
  update(deltaTime: number): void;
}
```

### Componentインターフェース
```typescript
interface Component {
  type: string;
  entity: Entity | null;
  initialize(): void;
  update(deltaTime: number): void;
}
```

