import { BaseSystem } from '../systems/BaseSystem';
import { Entity } from './Entity';
import { Component } from './Component';

export class EntitySystem extends BaseSystem {
  private entities: Map<string, Entity> = new Map();
  private componentUpdaters: Map<string, (deltaTime: number) => void> = new Map();

  public async initialize(): Promise<void> {
    await super.initialize(this.engine!);
    console.log('[EntitySystem] Initialized');
  }

  /**
   * エンティティを作成して登録
   */
  public createEntity(id: string): Entity {
    if (this.entities.has(id)) {
      console.warn(`[EntitySystem] Entity '${id}' already exists`);
      return this.entities.get(id)!;
    }

    const entity = new Entity(id);
    this.entities.set(id, entity);
    console.log(`[EntitySystem] Entity '${id}' created`);
    return entity;
  }

  /**
   * エンティティを取得
   */
  public getEntity(id: string): Entity | undefined {
    return this.entities.get(id);
  }

  /**
   * エンティティを削除
   */
  public removeEntity(id: string): boolean {
    const entity = this.entities.get(id);
    if (!entity) return false;

    entity.clearComponents();
    const result = this.entities.delete(id);
    if (result) {
      console.log(`[EntitySystem] Entity '${id}' removed`);
    }
    return result;
  }

  /**
   * すべてのエンティティを取得
   */
  public getEntities(): Map<string, Entity> {
    return new Map(this.entities);
  }

  /**
   * 特定のコンポーネントを持つエンティティをフィルタリング
   */
  public getEntitiesWithComponent(componentType: string): Entity[] {
    const result: Entity[] = [];
    for (const entity of this.entities.values()) {
      if (entity.hasComponent(componentType) && entity.getIsActive()) {
        result.push(entity);
      }
    }
    return result;
  }

  /**
   * 毎フレーム呼び出される更新
   */
  public update(deltaTime: number): void {
    for (const entity of this.entities.values()) {
      if (!entity.getIsActive()) continue;

      const components = entity.getComponents();
      for (const component of components.values()) {
        if (component.update) {
          component.update(deltaTime);
        }
      }
    }
  }
}
