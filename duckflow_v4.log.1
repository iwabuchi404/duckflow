<<<
/**
 * Engine - ゲームエンジンのコアシングルトン
 * すべてのシステムを管理し、ゲームループを制御します
 */

export interface System {
  initialize(engine: Engine): Promise<void>;
  update(deltaTime: number): void;
}

export class Engine {
  private static instance: Engine;
  private systems: Map<string, System> = new Map();
  private isRunning: boolean = false;
  private lastFrameTime: number = 0;
  private gameLoopId: number | null = null;
  private deltaTime: number = 0;

  private constructor() {
    console.log('[Engine] Initializing Engine singleton...');
  }

  /**
   * Engine インスタンスを取得（シングルトンパターン）
   */
  public static getInstance(): Engine {
    if (!Engine.instance) {
      Engine.instance = new Engine();
    }
    return Engine.instance;
  }

  /**
   * シングルトンへのアクセサプロパティ
   */
  public static get instance(): Engine {
    return Engine.getInstance();
  }

  /**
   * システムを登録
   * @param name システムの識別子
   * @param system System インターフェースを実装したシステム
   */
  public registerSystem(name: string, system: System): void {
    if (this.systems.has(name)) {
      console.warn(`[Engine] System '${name}' is already registered. Overwriting...`);
    }
    this.systems.set(name, system);
    console.log(`[Engine] System '${name}' registered`);
  }

  /**
   * 名前でシステムを取得
   * @param name システムの識別子
   * @returns 登録されたシステム、またはundefined
   */
  public getSystem<T extends System>(name: string): T | undefined {
    return this.systems.get(name) as T | undefined;
  }

  /**
   * すべてのシステムを初期化
   */
  public async initialize(): Promise<void> {
    console.log('[Engine] Initializing all systems...');
    
    for (const [name, system] of this.systems) {
      try {
        console.log(`[Engine] Initializing system: ${name}`);
        await system.initialize(this);
      } catch (error) {
        console.error(`[Engine] Failed to initialize system '${name}':`, error);
        throw error;
      }
    }
    
    console.log('[Engine] All systems initialized successfully');
  }

  /**
   * ゲームループを開始
   */
  public start(): void {
    if (this.isRunning) {
      console.warn('[Engine] Engine is already running');
      return;
    }

    this.isRunning = true;
    this.lastFrameTime = performance.now();
    console.log('[Engine] Game loop started');

    const gameLoop = (currentTime: number) => {
      this.deltaTime = (currentTime - this.lastFrameTime) / 1000; // 秒単位
      this.lastFrameTime = currentTime;

      // すべてのシステムを更新
      for (const system of this.systems.values()) {
        system.update(this.deltaTime);
      }

      if (this.isRunning) {
        this.gameLoopId = requestAnimationFrame(gameLoop);
      }
    };

    this.gameLoopId = requestAnimationFrame(gameLoop);
  }

  /**
   * ゲームループを停止
   */
  public stop(): void {
    if (!this.isRunning) {
      console.warn('[Engine] Engine is not running');
      return;
    }

    this.isRunning = false;
    if (this.gameLoopId !== null) {
      cancelAnimationFrame(this.gameLoopId);
      this.gameLoopId = null;
    }
    console.log('[Engine] Game loop stopped');
  }

  /**
   * エンジンが実行中かどうかを確認
   */
  public getIsRunning(): boolean {
    return this.isRunning;
  }

  /**
   * 前フレームからの経過時間を取得（秒単位）
   */
  public getDeltaTime(): number {
    return this.deltaTime;
  }

  /**
   * すべてのシステムを取得
   */
  public getSystems(): Map<string, System> {
    return new Map(this.systems);
  }

  /**
   * クリーンアップ処理
   */
  public cleanup(): void {
    this.stop();
    this.systems.clear();
    console.log('[Engine] Engine cleaned up');
  }
}
