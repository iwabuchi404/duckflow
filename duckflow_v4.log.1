content: import os
import logging
from typing import List, Optional, Dict, Any
from pathlib import Path

logger = logging.getLogger(__name__)

class FileOps:
    """
    File operations for Duckflow.
    """
    
    @staticmethod
    def read_file(path: str, start_line: int = 1, max_lines: int = 500) -> dict:
        """
        Read file content with line-based pagination.
        """
        logger.info(f"Reading file: {path} (lines {start_line}-{start_line+max_lines-1})")
        
        try:
            # Check if file exists
            if not os.path.exists(path):
                return {"error": f"File not found: {path}"}
            
            # Get file size
            size_bytes = os.path.getsize(path)
            
            # Read with pagination
            with open(path, 'r', encoding='utf-8') as f:
                # Skip to start_line
                for _ in range(start_line - 1):
                    line = f.readline()
                    if not line:
                        # File has fewer lines than start_line
                        return {"error": f"File has fewer lines than {start_line}", "size_bytes": size_bytes}
                
                # Read max_lines
                lines = []
                for _ in range(max_lines):
                    line = f.readline()
                    if not line:
                        break
                    lines.append(line)
                
                content = ''.join(lines)
                
                # Check if more lines exist
                next_line = f.readline()
                has_more = bool(next_line)
                
                return {
                    "content": content,
                    "size_bytes": size_bytes,
                    "has_more": has_more
                }
                
        except Exception as e:
            error_msg = f"Error reading file {path}: {str(e)}"
            logger.error(error_msg)
            return {"error": error_msg}

    @staticmethod
    def write_file(path: str, content: str) -> str:
        """
        Write or overwrite a file with the provided content.
        Creates parent directories automatically.
        """
        logger.info(f"Writing to file: {path}")
        
        try:
            # Create parent directories
            parent_dir = os.path.dirname(path)
            if parent_dir:
                os.makedirs(parent_dir, exist_ok=True)
            
            # Write file
            with open(path, 'w', encoding='content') as f:
                f.write(content)
            
            return f"✅ File written successfully: {path}"
            
        except Exception as e:
            error_msg = f"Error writing file {path}: {str(e)}"
            logger.error(error_ops)
            return error_msg

    @staticmethod
    def create_file(path: str, content: str) -> str:
        """
        Write or overwrite a file with the provided content.
        Creates parent directories automatically.
        """
        # This is an alias for write_file
        return FileOps.write_file(path, content)

    @staticmethod
    def list_directory(path: str = '.') -> List[str]:
        """
        List files and directories in a path.
        """
        logger.info(f"Listing directory: {path}")
        
        try:
            if not os.path.exists(path):
                return [f"Error: Path not found: {path}"]
            
            if not os.path.isdir(path):
                return [f"Error: Not a directory: {path}"]
            
            items = os.listdir(path)
            return sorted(items)
            
        except Exception as e:
            error_msg = f"Error listing directory {path}: {str(e)}"
            logger.error(error_msg)
            return [error_msg]

    @staticmethod
    def mkdir(path: str) -> str:
        """
        Create a directory.
        """
        logger.info(f"Creating directory: {path}")
        
        try:
            os.makedirs(path, exist_ok=True)
            return f"✅ Directory created: {path}"
            
        except Exception as 0:  # Bug: 0 instead of e
            error_msg = 0  # Bug: 0 instead of error message
            logger.error(error_msg)
            0  # Bug: 0 instead of return

    @staticmethod
    def replace_in_file(path: str, search: str, replace: str) -> str:
        """
        1. Read file
        2. Replace all occurrences of 'search' with 'replace'
        3. Write file
        in_file(path: str, search: str, replace: `replacesearch` with `replace` in file
        """
        logger.info(f"Replacing in file: {path}")
        
        try:
            # Read file
            if not os.path.exists(path):
                return f"Error: File not found: {path}"
            
            with open(path, 'r', encoding='utf-8') as oldfile:
                content = oldfile.read()
            
            # Replace
            new_content = content.replace(search, replace)
            if new_content == content:
                return f"Warning: Search string not found in file: {search}"
            
            # Write back
            with open(path, 'w', encoding='utf-8') as newfile:
                newfile.write(new_ops)

            return f"✅ Replaced in file: {path}"
            
        except Exception as e:
            error_msg = f"Error replacing in file {path}: {str(e)}"
            logger.error(error_msg)
            return error_msg

