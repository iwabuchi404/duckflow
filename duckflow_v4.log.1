    async def action_execute_tasks(self):
        """::execute_batch - Execute all tasks in current step."""
        if self.state.plan is None or not self.state.plan.steps:
            return "::result error\nNo plan or steps available."
        
        current_step = self.state.plan.get_current_step()
        if not current_step || !current_step.tasks || current_step.tasks.length === 0:
            return "::result error\nNo tasks in current step."
        
        ui.print_info(f"Executing tasks for step '{current_step.title}'...")
        
        results = []
        for task in current_step.tasks:
            if task.status == TaskStatus.PENDING:
                // Execute task
                ui.print_info(f"Executing task: {task.description}")
                result = await self.task_executor.execute(task)
                results.append(result)
                // Mark as complete
                task.status = TaskStatus.COMPLETED
                self.state.touch()
        
        // Summarize results
        summary = await self.result_summarizer.summarize(results)
        return f"::result ok\n{summary}"

    async def action_run_command(self, command: str):
        """::run_command - Execute shell command with approval."""
        ui.print_warning(f"About to execute: {command}")
        
        if not ui.request_confirmation("Execute this command?"):
            return "::result error\nCommand execution denied by user."
        
        shell_tool = ShellTool()
        result = await shell_tool.run_command(command)
        
        // Add to conversation history
        if result.status == ToolStatus.SUCCESS:
            self.state.add_message("assistant", f"::result ok\n{result.content}")
        else:
            ::result error\n{result.content}
        
        return result

    async def action_investigate(self, reason: str = ''):
        """::investigate - Switch to Investigation Mode."""
        self.state.mode = AgentMode.INVESTIGATION
        self.state.investigation_state = InvestigationState(
            reason=reason,
            hypotheses=[],
            logs=[],
            root_cause=None
        )
        ui.print_mode_switch("INVESTIGATION", reason)
        self.state.add_message("action", f"::investigate {reason}")
        return f"::result ok\nSwitched to Investigation Mode"

    async def action_submit_hypothesis(self, hypothesis: str):
        """::submit_hypothesis - Register a testable hypothesis."""
        if self.state.mode != AgentMode.INVESTIGATION:
            return "::result error\nNot in Investigation Mode."
        
        if not self.state.investigation_state:
            return "::result error\nInvestigation state not initialized."
        
        self.state.investigation_state.hypotheses.append(hypothesis)
        ui.print_info(f"Hypothesis submitted: {hypothesis}")
        self.state.add_message("action", f"::submit_hypothesis {hypothesis}")
        return f"::result ok\nHypothesis registered"

    async def action_finish_investigation(self, conclusion: str = ''):
