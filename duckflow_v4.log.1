        dangerous_commands = ["rm -rf", "del /s /q", "format", "shutdown", "reboot"]
        is_dangerous = any(cmd in command for cmd in dangerous_commands)
        
        if is_dangerous:
            ui.print_warning(f"⚠️  危険なコマンドを検出しました: {command}")
            if not ui.request_confirmation("この危険なコマンドを実行しますか？"):
                return {"type": "error", "message": "Command execution denied by user"}
        
