"""
実行結果の要約生成モジュール
v1.2 (Phase 1.6 開発中)
"""

import re
from typing import Dict, Any, Optional

class ResultSummarizer:
    """実行結果の要約を生成するクラス"""
    
    @staticmethod
    def summarize_python_execution(result: Dict[str, Any]) -> str:
        """
        Python実行結果の要約を生成
        
        Args:
            result: 実行結果の辞書（stdout, stderr, returncode含む）
            
        Returns:
            要約されたメッセージ
        """
        # 基本的な成功/失敗判定
        if result['returncode'] == 0:
            return ResultSummarizer._format_success(result)
        else:
            return ResultSummarizer._format_error(result)
    
    @staticmethod
    def _format_success(result: Dict[str, Any]) -> str:
        """成功時のフォーマット"""
        stdout = result['stdout'].strip()
        stderr = result['stderr'].strip()
        
        # 標準出力がある場合
        if stdout:
            # 簡単な値の抽出（例: "5 + 3 = 8"）
            value_match = re.search(r'[^=]+=\s*([^\s]+)$', stdout)
            if value_match:
                return f"✅ 実行完了！結果: `{value_match.group(1)}`"
            return f"✅ 実行完了！出力: {stdout[:80]}{'...' if len(stdout) > 80 else ''}"
        
        # 標準エラーがある場合（警告等）
        if stderr:
            return f"⚠️ 実行は成功しましたが、警告があります:\n{stderr[:100]}"
            
        return "✅ スクリプトは正常に終了しました（出力なし）"
    
    @staticmethod
    def _format_error(result: Dict[str, Any]) -> str:
        """エラー時のフォーマット"""
        stderr = result['stderr'].strip()
        
        # 一般的なPythonエラーパターンの抽出
        error_match = re.search(r'Traceback \(most recent call last\):(.*?)([A-Za-z]+Error: .+)', 
                               stderr, re.DOTALL)
        
        if error_match:
            error_type = error_match.group(2).split(':')[0]
            error_msg = error_match.group(2).split(':', 1)[1].strip()
            return f"❌ {error_type}が発生しました: `{error_msg}`\n" \
                   f"修正提案: {ResultSummarizer._suggest_fix(error_type, error_msg)}"
        
        return f"❌ 実行に失敗しました (コード {result['returncode']}):\n{stderr[:150]}"
    
    @staticmethod
    def _suggest_fix(error_type: str, error_msg: str) -> str:
        """エラーに基づく修正提案"""
        suggestions = {
            "NameError": "変数または関数が定義されていません。スペルチェックが必要です。",
            "SyntaxError": "構文エラーです。インデントやコロンの位置を確認してください。",
            "ModuleNotFoundError": "必要なモジュールがインストールされていません。",
            "TypeError": "型不一致です。変数の型を確認してください。"
        }
        return suggestions.get(error_type, "コードの該当部分を確認してください。")

# --- 以下は開発中の機能（Phase 1.6）---
