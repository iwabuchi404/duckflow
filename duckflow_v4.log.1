    def _process_tool_result(self, result: Any, tool_name: str) -> str:
        """Process tool result into a string for conversation history."""
        if isinstance(result, ToolResult):
            if result.status == ToolStatus.ERROR:
                return f"::result error\n{result.message}"
            else:
                return result.message
        elif isinstance(result, str):
            return result
        elif isinstance(result, dict):
            return json.dumps(result, ensure_ascii=False, indent=2)
        else:
            return str(result)

    async def action_note_(self, **kwargs):
        """note action (for progress notifications)."""
        message = kwargs.get("message", "")
        if message:
            ui.print_note(message)
            # 'note' does NOT add to conversation history (it's for progress only)
        return "::result ok"

    async def action_response(self, **kwargs):
        """response action (for final response to user)."""
        message = kwargs.get("message", "")
        if message:
            ui.print_response(message)
            # Add to conversation history
            self.state.add_message("assistant", message)
        return "::result ok"

    async def action_finish(self, **kwargs):
        """finish action (mark task as complete)."""
        message = kwargs.get("result", "")
        if message:
            ui.print_finish(message)
            # Add to conversation history
            self.state.add_message("assistant", message)
        return "::result ok"

    async def action_exit(self, **kwargs):
        """exit action (end session)."""
        ui.print_info("\n🛑 Session ended by agent/user")
        self.running = action_exit = False
        return "::result ok"

    async def action_execute_tasks(self, **kwargs):
        """Execute tasks from current step."""
        if not self.state.plan or not self.state.plan.current_step:
            return "::result error No active plan or step"

        step = self.state.plan.current_step
        if not step.tasks:
            return "::result error No tasks in current step"

        # Execute all tasks in order
        results = []
        for task in step.tasks:
            if task.status == TaskStatus.PENDING:
                # Execute the task
                ui.print_info(f"Executing task: {task.description}")
                result = await self.task_executor.execute(task)
                results.append(f"Task: {task.description}\nResult: {result}")
                
                # Mark as complete
                task.status = TaskStatus.DONE
        
        return f"::result ok\n" + "\n".join(results)

    async def action_run_command(self, **kwargs):
        """Run shell command with approval."""
        command = kwargs.get("command", "")
        if not command:
            return "::result error No command provided"

        # Request user approval
        ui.print_command(command)
        if not ui.request_approval(f"Execute command: {command}"):
            return "::result error User denied command execution"

        # Execute command
        shell = ShellTool()
        try:
            result = await shell.run(command)
            return result
        except Exception as e:
            return f"::result error {str(e)}"

    async def action_investigate(self, **kwargs):
        """Enter investigation mode."""
        reason = kwargs.get("reason", "")
        self.state.mode = AgentMode.INVESTIGATION
        ui.print_info(f"Investigation mode entered: {reason}")
        return "::result ok"

    async def action_submit_hypothesis(self, **kwargs):
        """Submit a hypothesis during investigation."""
        hypothesis = kwargs.get("hypothesis", "")
        if hypothesis:
            ui.print_info(f"Hypothesis: {hypothesis}")
            self.state.add_message("assistant", f"[Hypothesis] {hypothesis}")
        return "::result ok"

    async def action_finish_investigation(self, **kwargs):
        """Finish investigation mode."""
        conclusion = kwargs.get("conclusion", "")
        self.state.mode = AgentMode.NORMAL
        ui.print_info(f"Investigation finished. Conclusion: {conclusion}")
        self.state.add_message("assistant", f"[Conclusion] {conclusion}")
        return "::result ok"

    async def action_execute_batch(self, **kwargs):
        """Execute batch actions (Sym-Ops v3.1 Fast Path)."""
        # The content block is passed as a string in the 'content' parameter
        content = kwargs.get("content", "")
        if not content:
            return "::result error No content provided"

        # Parse batch actions
        # Format: action_name @path\ncontent\n%%%\naction_name @path\ncontent
        actions = []
        current_action = None
        current_content = []
        in_content_block = False

        for line in content.split('\n'):
            if line.startswith('%%%'):
                if current_action:
                    # Save previous action
                    actions.append((current_action, '\n'.join(current_content)))
                current_action = None
                current_content = []
                in_content_block = False
                continue

            if not current_action:
                # Parse action line
                parts = line.strip().split()
                if parts:
                    current_action = parts[0]
                    # Handle path if present
                    if len(parts) > 1 and parts[1].startswith('@'):
                        # Extract path
                        path = parts[1][1:]
                        current_content.append(f"@path={path}")
                    in_content_block = True
            else:
                # Inside content block
                current_content.append(line)

        # Add last action
        if current_action:
            actions.append((current_action, '\n'.join(current_content)))

        # Execute batch
        results = []
        for action_name, content_str in actions:
            # Parse parameters
            params = {}
            lines = content_str.split('\n')
            content_lines = []
            for line in lines:
                if line.startswith('@path='):
                    params['path'] = line[6:]
                else:
                    content_lines.append(line)
            
            if content_lines:
                params['content'] = '\n'.join(content_lines)

            # Execute action
            if action_name in self.tools:
                func = self.tools[action_name]
                try:
                    if asyncio.iscoroutinefunction(func):
                        result = await func(**params)
                    else:
                        result = func(**params)
                    results.append(f"✅ {action_name}: {result}")
                except Exception as e:
                    results.append(f"❌ {action_name}: {str(e)}")
            else:
                results.append(f"❌ {action_name}: Tool not found")

        return "::result ok\n" + "\n".join(results)

    async def action_status(self, **kwargs):
        """Status check - REMOVED due to infinite loop risk."""
        # This action was removed because it caused infinite loops
        # The agent would call status, get result, then call it again
        return "::result error This action is disabled"

