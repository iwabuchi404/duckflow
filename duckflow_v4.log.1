  12| class TaskListProposal(BaseModel):
  13|     """
  14|     Task list proposal schema for LLM responses.
  15|     """
  16|     tasks: List[Dict[str, Any]] = Field(
  16|         ...,
  17|         description="List of specific tasks to complete the step. Each task should have: title (required), description (required), optional action (e.g., 'read_file', 'edit_lines')"
  18|     )
  19| 
  20| class TaskTool:
  21|     """
  21|     TaskTool: Manages specific tasks within a Step.
  21|     Each task is a concrete action toward completing the step.
  22|     """
  23|     def __init__(self, state: AgentState, llm_client: LLMClient = default_client):
  24|         self.state = state
  25|         self.llm = llm_client
  26|     
  27|     async def generate_tasks(self) -> str:
  28|         """
  29|         Generate tasks for the current step using LLM.
  30|         
  31|         Returns:
  31|             Sym-Ops formatted response with proposed tasks.
  32|         """
  33|         current_step = self.state.get_current_step()
  33|         if not current_step:
  34|             return format_symops_response(ToolResult(
  35|                 status=ToolStatus.ERROR,
  36|                 message="No active step found."
  36|             ))
  37|         
  38|         # タスク生成プロンプト
  39|         prompt = f"""
  39|         Current Step: {current_step.title}
  40|         Description: {current_step.description}
  41|         
  42|         Propose specific tasks to complete this step.
  42|         Each task should be:
  42|         - Clear and actionable
  42|         - Small enough to complete in one go
  42|         - Include optional action if applicable
  42|         
  42|         Return a JSON array of tasks.
  42|         """
  42|         
  42|         try:
  42|             response = await self.llm.chat(
  42|                 messages=[{"role": "user", "content": prompt}],
  42|                 response_model=TaskListProposal
  42|             )
  42|             
  42|             # Store tasks in step's task list
  42|             current_step.tasks = response.tasks
  42|             
  42|             return format_symops_response(ToolResult(
  42|                 status=ToolStatus.SUCCESS,
  42|                 message=f"Generated {len(response.tasks)} tasks.",
  42|                 data={"tasks": response.tasks}
  42|             ))
  42|             
  42|         except Exception as e:
  42|             logger.error(f"Failed to generate tasks: {e}")
  42|             return format_symops_response(ToolResult(
  42|                 status=ToolStatus.ERROR,
  42|                 message=f"Failed to generate tasks: {str(e)}"
  42|             ))
  42|     
  42|     async def mark_task_complete(self, task_index: int = 0) -> str:
  42|         """
  42|         Mark a task at the specified index as completed.
  42|         
  42|         Args:
  42|             task_index: Index of the task to mark as complete (0-based)
  42|         
  42|         Returns:
  42|             Sym-Ops formatted response.
  42|         """
  42|         current_step = self.state.get_current_step()
  42|         if not current_step:
  42|             return format_symops_response(ToolResult(
  42|                 status=ToolStatus.ERROR,
  42|                 message="No active step found."
  42|             ))
  42|         
  42|         if not current_step.tasks:
  42|             return format_symops_response(ToolResult(
  42|                 status=ToolStatus.ERROR,
  42|                 message="No tasks in current step."
  42|             ))
  42|         
  42|         if task_index < 0 or task_index >= len(current_step.tasks):
  42|             return format_symops_response(ToolResult(
  42|                 status=ToolStatus.ERROR,
  42|                 message=f"Invalid task index: {task_index}. Valid range: 0-{len(current_step.tasks)-1}"
  42|             ))
  42|         
  42|         # Mark task as complete
  42|         task = current_step.tasks[task_index]
  42|         if isinstance(task, dict):
  42|             task["completed"] = True
  42|         else:
  42|             # Handle case where task might be an object
  42|             setattr(task, "completed", True)
  42|         
  42|         return format_symops_response(ToolResult(
  42|             status=ToolStatus.SUCCESS,
  42|             message=f"Task {task_index} marked as complete."
  42|         ))
