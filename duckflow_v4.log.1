            return f"::result ok\n::tool list_directory\n::target {path}\n" + "\n".join(items)
        except Exception as e:
            return f"::result fail\n::error {str(e)}"
    
    def _delete_file(self, params: Dict[str, Any]) -> str:
        """ファイルを削除する（危険操作）"""
        path = params.get('path', '')
        try:
