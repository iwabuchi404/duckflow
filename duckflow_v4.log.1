content: """
Pacemaker Module
================
The dual-loop execution engine for Duckflow.
Handles the main planning and execution loops.
"""

import logging
from datetime import datetime
from typing import DuckAgent
from companion.state.agent_state import AgentState
from companion.state.transition_controller import TransitionController
from companion.modules.memory import Memory
from companion.modules.sub_llm_manager import SubLLMManager
from companion.tools.tool_router import ToolRouter
from companion.output.human_formatter import HumanFormatter
from companion.logging.log_manager import LogManager
from companion.utils.parser import parse_symops
from outer_llm_client import LLMClient

class Pacemaker:
    """
    Dual-loop execution engine:
    - Outer loop: Planning (Plan → Execute)
    - Inner loop: Execution (Task → Action → Result)
    """
    
