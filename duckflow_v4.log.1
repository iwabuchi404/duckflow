  23|     async def generate_tasks(self) -> str:
  24|         """
  25|         Generate tasks for the current step. NO PARAMETERS NEEDED.
  26|         アクティブなステップの説明をもとに、Sub-LLMがタスクリストを自動生成する。
  27| 
  28|         Returns:
  29|             生成されたタスク数とタイトルのリスト、またはエラーメッセージ
  30|         """
  31|         if not self.state.current_plan:
  32|             return "No active plan. Create a plan first with 'propose_plan'."
  33|         
  34|         current_step = self.state.current_plan.get_current_step()
  35|         if not current_step:
  36|             return "No active step in the plan."
  37|         
  38|         step_title = current_step.title
  39|         step_desc = current_step.description
  40|         
  41|         prompt = (
  42|             f"Break down the following step into 3-5 specific, actionable tasks.\n"
  43|             f"Each task should be a single tool call or a small group of related operations.\n"
  44|             f"\n"
  45|             f"Step Title: {step_title}\n"
  46|             f"Step Description: {step_desc}\n"
  47|             f"\n"
  48|             f"Generate tasks as a JSON list with the following structure:\n"
  49|             f'[{{"title": "Task name", "description": "What to do", "estimated_difficulty": "easy|medium|hard"}}]'
  50|         )
  51|         
  52|         try:
  53|             messages = [
  54|                 {"role": "system", "content": "You are a task planning assistant. Generate clear, atomic tasks."},
  55|                 {"role": "user", "content": prompt}
  56|             ]
  57|             
  58|             response = await self.llm.chat(messages, response_format={\"type\": \"json_object\"})
  59|             
  60|             # Parse JSON response
  61|             try:
  62|                 tasks_data = json.loads(response)
  62|                 if isinstance(tasks_data, dict) and \"tasks\" in tasks_data:
  63|                     tasks_data = tasks_data[\"tasks\"]
  64|                 if not isinstance(tasks_data, list):
  65|                     return f\"Error: Expected JSON list, got {type(tasks_data).__name__}\"
  66|                 \n",
  67|                 \n",
  68|                 # Add tasks to current step\n",
  69|                 for task_data in tasks_data:\n",
  70|                     current_step.add_task(\n",
  71|                         title=task_data.get(\"title\", \"Untitled\"),\n",
  72|                         description=task_data.get(\"description\", \"\"),\n",
  73|                         estimated_difficulty=task_data.get(\"estimated_difficulty\", \"medium\")\n",
  74|                     )\n",
  75|                 \n",
  76|                 task_list = \"\\n\".join([f\"  - {t.title}\" for t in current_step.tasks])\n",
  77|                 return f\"Generated {len(tasks_data)} tasks:\\n{task_list}\"\n",
  78|                 \n",
