import logging

logger = logging.getLogger(__name__)

class PlanTool:
    """
    階層的プランニングを管理するツール。
    Plan -> Step -> Task の階層構造を管理する。
    """
    def __init__(self, state: AgentState):
        self.state = state
    
    def propose_plan(self, goal: str) -> str:
        """
        新しい計画を提案する。
        
        Args:
            goal: 長期目標（例：「スネークゲームを作る」）
        
        Returns:
            計画が作成されたことを示すメッセージ
        """
        plan = Plan(goal=goal)
        self.state.active_plan = plan
        self.state.mode = "planning"
        
        # LLMにステップを生成させるためのプレースホルダー
        # 実際にはLLMが提案するステップをここで受け取るが、
        # 現在の実装ではプロンプト内でLLMが直接stepsを生成する
        # このツールは状態を初期化する役割
        
        logger.info(f"Plan proposed: {goal}")
        return f"計画を提案しました: {goal}"
    
    def mark_step_complete(self, step_index: int = 0) -> str:
        """
        現在のステップを完了としてマークする。
        
        Args:
            step_index: 完了とするステップのインデックス（現在は未使用）
        
        Returns:
            ステップ完了のメッセージ
        """
        if self.state.active_step:
            self.state.active_step.status = TaskStatus.COMPLETED
            logger.info(f"Step completed: {self.state.active_step.title}")
            return f"ステップを完了しました: {self.state.active_step.title}"
        else:
            return "アクティブなステップがありません"
    
    def update_step(self, step_index: int, **kwargs) -> str:
        """
        ステップを更新する（現在は未実装）
        """
        return "update_step is not implemented yet"
