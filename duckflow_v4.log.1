import random
import datetime
import os

def generate_logs():
    """Generate app.log with 50 log entries"""
    # Define log levels and messages
    log_levels = ['INFO', 'WARNING', 'ERROR']
    level_messages = {
        'INFO': ['User logged in', 'Process completed', 'Data saved successfully', 'Connection established', 'Task started'],
        'WARNING': ['High memory usage', 'Slow response time', 'Deprecated function used', 'Configuration file missing'],
        'ERROR': ['Failed to connect to database', 'Authentication failed', 'File not found', 'Invalid input data', 'Service unavailable']
    }
    
    # Start time
    current_time = datetime.datetime(2024, 1, 1, 10, 0, 0)
    log_lines = []
    
    # Generate 50 log lines
    for i in range(50):
        # Random time increment (1-5 minutes)
        time_increment = random.randint(1, 5)
        current_time = current_time + datetime.timedelta(minutes=time_increment)
        
        # Random log level
        level = random.choice(log_levels)
        
        # Random message for the level
        message = random.choice(level_messages[level])
        
        # Format log line
        timestamp_str = current_time.strftime('%Y-%m-%d %H:%M:%S')
        log_line = f"{timestamp_str} [{level}] {message}"
        log_lines.append(log_line)
    
    # Write to file
    with open('app.log', 'w') as f:
        f.write('\n'.join(log_lines))
    
    print(f"Generated app.log with {len(log_lines)} log entries")

if __name__ == "__main__":
    generate_logs()
