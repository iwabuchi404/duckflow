<<<
export class Engine {
    private static instance: Engine;
    private systems: Map<string, System> = new Map();
    private isRunning: boolean = false;
    private animationFrameId: number | null = null;
    private lastTime: number = 0;

    private constructor() {}

    public static get Instance(): Engine {
        if (!Engine.instance) {
            Engine.instance = new Engine();
        }
        return Engine.instance;
    }

    public registerSystem(name: string, system: System): void {
        if (this.systems.has(name)) {
            throw new Error(`System '${name}' is already registered`);
        }
        this.systems.set(name, system);
    }

    public getSystem<T extends System>(name: string): T {
        const system = this.systems.get(name);
        if (!system) {
            throw new Error(`System '${name}' not found`);
        }
        return system as T;
    }

    public async initialize(): Promise<void> {
        console.log('Initializing engine systems...');
        
        const initPromises: Promise<void>[] = [];
        this.systems.forEach((system, name) => {
            initPromises.push(system.initialize(this));
        });

        await Promise.all(initPromises);
        console.log('Engine initialized successfully');
    }

    public start(): void {
        if (this.isRunning) {
            console.warn('Engine is already running');
            return;
        }

        this.isRunning = true;
        this.lastTime = performance.now();
        this.gameLoop(this.lastTime);
        console.log('Engine started');
    }

    public stop(): void {
        if (!this.isRunning) {
            console.warn('Engine is not running');
            return;
        }

        this.isRunning = false;
        if (this.animationFrameId) {
            cancelAnimationFrame(this.animationFrameId);
            this.animationFrameId = null;
        }
        console.log('Engine stopped');
    }

    private gameLoop(currentTime: number): void {
        if (!this.isRunning) return;

        const deltaTime = currentTime - this.lastTime;
        this.lastTime = currentTime;

        this.updateSystems(deltaTime);

        this.animationFrameId = requestAnimationFrame((time) => this.gameLoop(time));
    }

    private updateSystems(deltaTime: number): void {
        this.systems.forEach((system, name) => {
            try {
                system.update(deltaTime);
            } catch (error) {
                console.error(`Error updating system '${name}':`, error);
            }
        });
    }

    public getRegisteredSystems(): string[] {
        return Array.from(this.systems.keys());
    }
}

export interface System {
    initialize(engine: Engine): Promise<void>;
    update(deltaTime: number): void;
}
