                results.append(error_message)

        return results

    async def action_note_(self, message: str):
        """
        Internal note for the agent (Sym-Ops v3.2).
        Does NOT return to user. Does NOT break the loop.
        """
        logger.info(f"NOTE: {message}")
        ui.print_info(f"Note: {message}")
        self.state.add_message("assistant", f"Note: {message}")
        return "Note recorded"

    async def action_response(self, message: str):
        """
        Final response to user (Sym-Ops v3.2).
        Breaks the autonomous loop and returns control to the user.
        """
        logger.info(f"RESPONSE: {message}")
        ui.print_response(message)
        self.state.add_message("assistant", f"Response: {message}")
        return "Response sent"

    async def action_finish(self, result: str):
        """
        Mark the entire objective as accomplished (Sym-Ops v3.2).
        Breaks the autonomous loop and returns control to the user.
        """
        logger.info(f"FINISH: {result}")
        ui.print_success(f"Task completed: {result}")
        self.state.add_message("assistant", f"Finish: {result}")
        self.state.current_task_status = TaskStatus.COMPLETED
        return "Task marked as completed"

    async def action_exit(self):
        """
        Graceful exit.
        Breaks the autonomous loop and returns control to the user.
        """
        logger.info("EXIT command received")
        ui.print_info("Exiting autonomous loop...")
        self.running = False
        return "Exited"

    async def action_execute_tasks(self):
        """
        Execute tasks generated by generate_tasks.
        """
        if not self.state.tasks or len(self.state.tasks) == 0:
            msg = "No tasks to execute. Use generate_tasks first."
            ui.print_warning(msg)
            return msg
        
        # Execute tasks sequentially
        results = []
        for task in self.state.tasks:
            # Execute task
            ui.print_info(f"Executing task: {task.name}")
            result = await self.task_executor.execute(task)
            results.append(result)
            
            # Update task status
            if result.is_success:
                task.status = TaskStatus.COMPLETED
            else:
                task.status = TaskStatus.FAILED
                break  # Stop execution on failure
        
        # Summarize results
        summary = await self.result_summarizer.summarize(results)
        ui.print_result(summary, is_error=False)
        self.state.add_message("assistant", f"Task Execution Summary:\n{summary}")
        self.state.current_task_status = TaskStatus.COMPLETED if all(r.is_success for r in results) else TaskStatus.FAILED
        return summary

    async def action_run_command(self, command: str):
        """
        Execute a shell command with mandatory user approval.
        Sym-Ops v3.1: Safety score is set LOW.
        """
        # Safety check: warn about dangerous commands
        dangerous_patterns = ["rm -rf", "sudo", "format", "mkfs"]
        is_dangerous = any(pattern in command for pattern in dangerous_patterns)
        
        if is_dangerous:
            ui.print_safety_warning(0.3)
            if not ui.request_confirmation(f"Dangerous command detected: {command}. Really run?"):
                msg = "Command execution denied by user."
                ui.print_result(msg, is_error=True)
                return msg
        
        # User approval
        if not ui.request_confirmation(f"Run command: {command}"):
            msg = "Command execution denied by user."
            ui.print_result(msg, is_error=True)
            return msg
        
        shell = ShellTool()
        result = await shell.run(command)
        
        # Handle result
        if result.is_success:
            ui.print_result(result.output, is_error=False)
            self.state.add_message("assistant", f"Command '{command}' output:\n{result.output}")
        else:
            ui.print_result(result.error, is_error=True)
            self.state.add_message("assistant", f"Command '{command}' error:\n{result.error}")
        
        return result

    async def action_investigate(self, reason: str):
        """
        Switch to INVESTIGATION mode.
        """
        self.state.mode = AgentMode.INVESTIGATION
        self.state.investigation_context = {"reason": reason, "hypotheses": []}
        msg = f"Investigation mode entered. Reason: {reason}"
        ui.print_info(msg)
        self.state.add_message("assistant", msg)
        return msg

    async def action_submit_hypothesis(self, hypothesis: str):
        """
        Submit a testable hypothesis during investigation.
        """
        if self.state.investigation_context is None:
            return "Not in investigation mode."
        
        self.state.investigation_context["hypotheses"].append(hypothesis)
        msg = f"Hypothesis submitted: {hypothesis}"
        ui.print_info(msg)
        self.state.add_message("assistant", msg)
        return msg

    async def action_finish_investigation(self, conclusion: str):
        """
        Finish investigation and return to planning mode.
        """
        self.state.mode = AgentMode.PLANNING
        msg = f"Investigation finished. Conclusion: {conclusion}"
        ui.print_info(msg)
        self.state.add_message("assistant", msg)
        # Clear investigation context
        self.state.investigation_context = None
        return msg

    async def action_execute_batch(self, content: str):
        """
        Execute batch of actions (Sym-Ops v3.1 Fast Path).
        """
        import re
        
        # Split by %%% (batch separator)
        actions = content.split("%%%")
        
        results = []
        for action_str in actions:
            action_str = action_str.strip()
            if not action_str:
                continue
            
            # Parse action name and parameters
            lines = action_str.split('\n')
            first_line = lines[0].strip()
            
            # Extract action name (first word)
            action_name_match = re.match(r'^(\w+)', first_line)
            if not action_name_match:
                continue
            action_name = action_name_match.group(1)
            
            # Extract parameters (remaining lines)
            param_lines = [line for line in lines[1:] if line.strip()]
            parameters = {}
            for line in param_lines:
                if "=" in line:
                    key, value = line.split("=", 1)
                    parameters[key.strip()] = value.strip()
                else:
                    # If it's a single line command or content, treat as 'command' or 'content'
                    parameters["content"] = line.strip()
            
            # Special handling for content blocks (lines between <<< and >>>)
            # This is a simplified parser; for complex cases, use single actions
            content_block = []
            in_content_block = False
            for line in lines[1:]:
                if line.strip() == "<<<":
                    in_content_block = True
                    continue
                elif line.strip() == ">>>":
                    in_content_block = False
                    continue
                elif in_content_block:
                    content_block.append(line)
            
            if content_block:
                parameters["content"] = "\n".join(content_block)
            
            # Execute
            if action_name in self.tools:
                try:
                    func = self.tools[action_name]
                    if asyncio.iscoroutinefunction(func):
                        result = await func(**parameters)
                    else:
                        result = func(**parameters)
                    results.append(f"OK: {action_name} -> {result}")
                except Exception as e:
                    results.append(f"ERROR: {action_name} -> {str(e)}")
            else:
                results.append(f"UNKNOWN: {action_name}")
        
        summary = "\n".join(results)
        ui.print_result(summary, is_error=False)
        self.state.add_message("assistant", f"Batch Execution Summary:\n{summary}")
        return summary

    def _noop(self, **kwargs):
        """No-op tool for status, etc."""
        return "ok"
