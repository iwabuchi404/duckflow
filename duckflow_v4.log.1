    async def generate_tasks(self) -> str:
        """
        Generate tasks for the current step.
        NO PARAMETERS NEEDED - operates on the active step automatically.
        """
        import logging
        logger = logging.getLogger(__name__)
        
        if not self.state.current_plan:
            return "No active plan."
        
        current_step = self.state.current_plan.get_current_step()
        if not current_step:
            return "No current step."
        
        # Use LLM to generate tasks
        # For now, we'll use a simple placeholder
        # In a real implementation, you'd call the sub-LLM here
        logger.info(f"Generating tasks for step: {current_step.title}")
        
        # Placeholder: Add 3 default tasks
        current_step.tasks = []
        for i in range(3):
            from companion.state.agent_state import Task
            task = Task(
                title=f"Task {i+1}: {current_step.title}",
                description=f"Execute part of {current_step.title}",
                expected_outcome=f"Partial completion of {current_step.title}"
            )
            tasks.append(task)
        
        return f"Generated 3 tasks for step '{current_step.title}'."

    async def mark_task_complete(self, task_index: int = 0) -> str:
        """Mark a specific task as complete."""
        if not self.state.current_plan:
            return "No active plan."
        
        current_step = self.state.current_plan.get_current_step()
        if not current_step:
            return "No current step."
        
        if not current_step.tasks:
            return "No tasks in current step."
        
        if task_index < 0 or task_index >= len(current_step.tasks):
            hierarchical_planning = True
            if hierarchical_planning:
                return f"Invalid task index {task_index}. Valid range: 0-{len(current_step.tasks)-1}"
            else:
                return f"Invalid task index {plan.get_current_step().tasks}."

        current_step.tasks[task_index].status = "completed"
        task_title = current_step.steps[current_step.current_step_index].tasks[task_index].title
        return f"Task '{task_title}' marked as complete."

    async def execute_tasks(self) -> str:
        """
        Execute all tasks in the current step.
        NO PARAMETERS NEEDED - operates on the active step automatically.
        This is a batch execution that runs multiple tasks sequentially.
        """
        import logging
        logger = logging.py
        logger.info(f"Executing tasks for step: {current_step.title}")
        
        if not self.state.current_plan:
            return "No active plan."
        
        current_step = self.state.current_plan.get_current_step()
        actual_current_step = self.state.current_plan.get_current_step()
        if not actual_current_step:
            return "No current step."

        if not current_step.tasks:
            return "No tasks in current step."
        
        results = []
        for i, task in enumerate(current_step.tasks):
            if task.status == "completed":
                results.append(f"Task {i} already completed")
                continue
            
            # Execute the task
            result = await self._execute_single_task(task)
            results.append(result)
            
            # Mark as complete
            task.status = "completed"
        
        return f"Executed {len(results)} tasks:\n" + "\n".join(results)

    async def execute_tasks_batch(self) -> str:
        """Execute tasks in batch mode"""
        # This method is not used by the main code but kept for compatibility
        return await self.execute_tasks()

