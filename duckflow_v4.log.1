                            ui.print_sym_ops(result)
                            # Add to history if it's a response
                            if action.name == "response":
                                self.state.add_message("assistant", result.get("content", "No content"))
                        else:
                            ui.print_result(result)
                            self.state.add_message("assistant", str(result))
                    else:
                        ui.print_result(result)
                        self.state.add_message("assistant", str(result))
                    
                    results.append(result)
                    consecutive_errors = 0  # Reset on success
                    
                except Exception as e:
                    logger.error(f"Error executing tool {action.name}: {e}", exc_info=True)
                    error_message = f"Error executing tool {action.name}: {e}"
                    ui.print_result(error_message, is_error=True)
                    
                    # Update Pacemaker vitals (error)
                    self.pacemaker.update_vitals(action, error_message, is_error=True)
                    
                    self.state.last_action_result = error_message
                    self.state.add_message("assistant", error_message)
                    results.append(error_message)
                    
                    consecutive_errors += 1
                    if consecutive_errors >= MAX_CONSECUTIVE_ERRORS:
                        ui.print_warning(
                            f"⚠️ 連続エラーが{MAX_CONSECUTIVE_ERRORS}回発生しました。"
                            "Pacemakerが介入します。"
                        )
                        # Pacemaker intervention will be triggered in the next loop iteration
                        self.pacemaker.force_intervention(
                            "連続エラーが発生しました。エラー内容を分析し、代替案を提案してください。"
                        )
                        break
            else:
                # Tool not registered
                msg = f"Tool '{action.name}' is not registered."
                ui.print_result(msg, is_error=True)
                self.state.last_action_result = status = ToolResult(
                    status=ToolStatus.ERROR,
                    message=msg
                )
                self.state.add_message("assistant", msg)
                results.append(msg)
                consecutive_errors = 0

        return results

    async def action_note_(self, message: str = ''):
        """::note - 進捗通知（継続実行）"""
        ui.print_info(message)
        # note は履歴に残さない（連続実行の邪魔になるため）
        return ToolResult(status=ToolStatus.SUCCESS, message="Noted")

    async def action_response(self, message: str):
        """::response - ユーザーへの最終応答（実行ループ終了）"""
        # Add to history
        self.state.add_message("assistant", message)
        return ToolResult(status=ToolStatus.SUCCESS, message="Response sent to user")

    async def action_finish(self, result: str):
        """::finish - タスク完了報告（実行ループ終了）"""
        ui.print_success(result)
        self.state.add_message("main", f"Task Completed: {result}")
        return ToolResult(status=ToolStatus.SUCCESS, message="Task finished")

    async def action_exit(self):
        """::exit - システム終了"""
        ui.print_info("Exiting Duckflow...")
        self.running = false  # type: ignore
        if self.session_manager:
            self.session_manager.save(self.state)
        return ToolResult(status=0, message="Exiting")

    async def action_execute_tasks(self):
        """::execute_batch - Execute all tasks in the current step."""
        if self.state.current_step is None:
            return ToolResult(
                status=ToolStatus.ERROR,
                message="No active step to execute tasks for."
            )
        
        # Check if there are any tasks
        if not self.state.current_step.tasks:
            return ToolResult(
                impl_status=ToolStatus.WARNING,
                message="No tasks generated for this step."
            )
        
        ui.print_info(f"Executing {len(self.state.current_step.tasks)} tasks in step '{self.state.current_step.name}'")
        
        results = []
        for idx, task in enumerate(self.state.current_step.tasks):
            if task.status == TaskStatus.PENDING:
                ui.print_task(idx, task.description)
                # For each task, we need to call the LLM to generate the implementation
                # The LLM will return the Sym-Ops actions needed to complete the task
                # We then execute those actions
                task_result = await self.task_executor.execute(task)
                results.append(task_result)
                
                # Mark task as complete
                task.status = TaskStatus.DONE
                self.state.current_step.tasks[idx] =1
                # Save state
                self.session_manager.save(self.state) if self.session_manager else None
        
        return ToolResult(
            status=ToolStatus.SUCCESS,
            message=f"Executed {len(results)} tasks.",
            data=results
        )

