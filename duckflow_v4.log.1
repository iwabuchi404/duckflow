"""
from typing import Dict, Any, List
from companion.modules.sub_llm_manager import SubLLMManager

class SubLLMTools:
    """Sub-LLMを使用したツール群"""
    
    def __init__(self, config: dict, sub_llm_manager: SubLLMManager):
        self.config = config
        self.sub_llm_manager = sub_llm_manager
    
    def get_actions(self) -> List[str]:
        return ['generate_code', 'analyze_structure', 'summarize_context']
    
    def execute(self, action_name: str, params: Dict[str, Any], state) -> str:
        if action_name == 'generate_code':
            return self._generate_code(params)
        elif action_name == 'analyze_structure':
            return self._analyze_structure(params)
        elif action_name == 'summarize_context':
            return self._summarize_context(params)
        return f"[Error] Unknown action: {action_name}"
    
    def _generate_code(self, params: Dict[str, Any]) -> str:
        """コード生成をSub-LLMに委譲"""
        path = params.get('path', '')
        instruction = params.get('instruction', '')
        context = params.get('context', '')
        
        result = self.sub_llm_manager.generate_code(path, instruction, context)
        return f"::result ok\n::tool generate_code\n::target {path}\n{result}"
    
    def _analyze_structure(self, params: Dict[str, Any]) -> str:
        """構造分析をSub-LLMに委譲"""
        path = params.get('path', '')
        result = self.sub_llm_manager.analyze_structure(path)
        return f"::result ok\n::tool analyze_structure\n::target {path}\n{result}"
    
    def _summarize_context(self, params: Dict[str, Any]) -> str:
        """コンテキスト要約をSub-LLMに委譲"""
        content = params.get('content', '')
        result = self.sub_llm_manager.summarize_context(content)
        return f"::result ok\n::tool summarize_context\n{result}"
