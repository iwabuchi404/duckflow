   1| import threading
   2| import time
   3| from typing import Callable, Optional
   4|
   5| from companion.state.enums import Vitals
   6|
   7| class Pacemaker:
   8|     """
   9|     Controls the execution loop of the agent based on Vitals.
10|     """
11|     def __init__(self, vitals: Vitals, base_iterations: int = 20):
12|         self.vitals = vitals
13|         self.base_iterations = base_iterations
14|         self.iteration = 0
15|         self._stop_event = threading.Event()
16|
17|     def _calculate_limit(self) -> int:
18|         """
19|         Calculate the maximum number of loop iterations based on vitals.
20|         The multiplier is confidence * safety, clipped between 0.8 and 1.2.
21|         """
22|         multiplier = max(0.8, min(1.2, self.vitals.confidence * self.vitals.safety))
23|         limit = int(self.base_iterations * multiplier)
24|         return max(limit, 5)  # Ensure at least 5 iterations
25|
26|     def start(self, loop_body: Callable[[], None], interval: float = 0.1):
27|         """
28|         Run the loop_body repeatedly until the stop event is set or the iteration limit is reached.
29|         """
30|         limit = self._calculate_limit()
31|         while not self._stop_event.is_set() and self.iteration < limit:
32|             try:
33|                 loop_body()
34|             except Exception as e:
35|                 print(f"[Pacemaker] Loop body raised an exception: {e}")
36|             self.iteration += 1
37|             time.sleep(interval)
38|         print(f"[Pacemaker] Loop finished after {self.iteration} iterations (limit: {limit}).")
39|
40|     def stop(self):
41|         """Signal the loop to stop."""
42|         self._stop_event.set()
