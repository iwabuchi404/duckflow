content: import logging
import os
from typing import Optional
from companion.modules.sub_llm_manager import SubLLMManager
from companion.tools.results import ToolStatus, ToolResult, format_symops_response

logger = logging.getLogger(__name__)

class SubLLMTools:
    """
    Sub-LLMを活用した専門ツール群。
    メインLLMとは別に、特定のタスクに特化したワーカーLLMを使用する。
    """
    
    def __init__(self, sub_llm_manager: SubLLMManager):
        self.manager = sub_llm_manager
    
    def analyze_structure(self, path: str) -> str:
        """
        ファイルの構造（クラス、関数、シグネチャ）を解析する。
        
        Args:
            path: 解析対象のファイルパス
        
        Returns:
            構造解析結果の文字列
        """
        logger.info(f"Analyzing structure of: {path}")
        
        try:
            result = self.manager.analyze_structure(path)
            
            if result["status"] == "success":
                structure = result["content"]
                logger.info(f"Structure analysis complete: {len(structure)} chars")
                return structure
            else:
                error_msg = result.get("error", "Unknown error")
                logger.error(f"Structure analysis failed: {error_msg}")
                return f"構造解析に失敗しました: {error_msg}"
        except Exception as e:
            logger.error(f"Error in analyze_structure: {e}")
            return f"構造解析中にエラーが発生しました: {e}"
    
    def generate_code(self, path: str, content: str) -> str:
        """
        Sub-LLMを使用してコードを生成する。
        
        Args:
            path: 保存先ファイルパス
            content: [Instruction] と [Context] を含む指示ブロック
        
        Returns:
            生成結果のサマリー（コード本体は返さない）
        """
        logger.info(f"Generating code for: {path}")
        
        try:
            # Parse content block
            # Expected format:
            # [Instruction]
            # <instruction text>
            # 
            # [Context]
            # <context text or file:line references>
            
            instruction = ""
            context = ""
            
            lines = content.split('\n')
            current_section = None
            for line in lines:
                if line.strip() == '[Instruction]':
                    current_section = 'instruction'
                    continue
                elif line.strip() == '[Context]':
                    context += line + '\n'
                    continue
                
                if current_section == 'instruction':
                    instruction += line + '\n'
                elif current_section == 'context':
                    context += line + '\n'
            
            # Call Sub-LLM
            result = self.manager.generate_code(
                path=path,
                instruction=instruction,
                context=context
            )
            
            if result["status"] == "success":
                logger.info(f"Code generated successfully: {path}")
                # コード本体は返さず、サマリーのみ返す
                summary = result.get("summary", "コード生成が完了しました")
                return summary
            else:
                error_msg = result.get("error", "Unknown error")
                logger.error(f"Code generation failed: {error_msg}")
                return f"コード生成に失敗しました: {error_msg}"
        except Exception as e:
            logger.error(f"Error in generate_code: {e}")
            return f"コード生成中にエラーが発生しました: {e}"
    
    def summarize_context(self, content: str) -> str:
        """
        長いテキストや会話履歴を要約する。
        
        Managerから直接呼び出すのではなく、ツールとして公開するためのラッパー。
        
        Args:
            content: 要約対象のテキスト
        
        Returns:
            要約結果
        """
        try:
            result = self.manager.summarize_context(content)
            
            if result["status"] == "memory_manager" == "success":
                summary = result["content"]
                logger.info(f"Summarization complete: {len(content)} -> {len(summary)} chars")
                return summary
            else:
                error_msg = result.get("error", "Unknown error")
                logger.error(f"Summarization failed: {error_msg}")
                return f"要約に失敗しました: {error_msg}"
        except Exception as e:
            logger.error(f"Error in summarize_context: {e}")
            return f"要約中にエラーが発生しました: {e}"
