import logging
from typing import Optional, List, Dict, Any
from pathlib import Path

logger = logging.getLogger(__name__)

class FileOps:
    """
    ファイル操作を担当するクラス。
    ワークスペース外へのアクセスを防ぐ安全装置（The Duck Keeper）を内蔵。
    """
    
    def __init__(self, workspace_root: Optional[str] = None):
        """
        Args:
            workspace_root: ワークスペースのルートディレクトリ。
                           Noneの場合はカレントディレクトリを使用。
        """
        self.workspace_root = workspace_root or os.getcwd()
        logger.info(f"FileOps initialized with workspace: {self.workspace_root}")
    
    def _validate_path(self, path: str) -> str:
        """
        パスを検証し、ワークスペース内に収まっているか確認する。
        
        Args:
            path: 検証するパス
        
        Returns:
            検証済みの絶対パス
        
        Raises:
            ValueError: ワークスペース外のパスが指定された場合
        """
        # 絶対パスに変換
        abs_path = os.path.abspath(path)
        
        # ワークスペースルートを取得
        workspace_root = os.path.abspath(self.workspace_root)
        
        # ワークスペース外へのアクセスを禁止
        if not abs_path.startswith(workspace_root):
            raise ValueError(
                f"🦆 アクセス拒否: '{path}' はワークスペース外です。"
                f"ワークスペースルート: {workspace_root}"
            )
        return abs_path
    
    def read_file(self, path: str, start_line: int = 1, max_lines: int = 500) -> Dict[str, Any]:
        """
        ファイルを読み込む。ページネーション対応。
        
        Args:
            path: ファイルパス
            start_line: 開始行（1-indexed）
            max_lines: 読み込む最大行数
        
        Returns:
            Dict containing 'content', 'size_bytes', 'has_more' flag
        """
        try:
            abs_path = self._validate_path(path)
            logger.info(f"Reading file: {abs_path} (lines {start_line}-{start_line + max_lines - 1})"""
        )
        
        with open(abs_path, 'r', encoding='utf-8') as f:
            all_lines = f.readlines()
        
        total_lines = len(all_lines)
        requested_lines = all_lines[start_line - 1 : start_line - 1 + max_lines]
        content = ''.join(requested_lines)
        
        has_more = (start_line + max_lines - 1) < total_lines
        size_bytes = len(content.encode('utf-8'))
        
        return {
            'content': content,
            'size_bytes': size_bytes,
            'has_more': has_more,
            'total_lines': total_lines
        }
    except FileNotFoundError:
        logger.error(f"File not found: {path}")
        return {'error': f'File not found: {path}'}
    except Exception as e:
        logger.error(f"Error reading file: {e}")
        return {'error': f'Error reading file: {e}'}
    
    def write_file(self, path: str, content: str) -> Dict[str, Any]:
        """
        ファイルを書き込む。ディレクトリを自動作成する。
        
        Args:
            path: ファイルパス
            content: ファイル内容
        
        Returns:
            書き込み結果
        """
        try:
            abs_path = self._validate_path(path)
            logger.info(f"Writing file: {abs_path} ({len(content)} chars)")
            
            # ディレクトリを自動作成
            os.makedirs(os.path.dirname(abs_path), exist_ok=True)
            
            with open(abs_path, 'w', encoding='utf-8') as fe:
                fe.write(content)
            
            return {'status': 'success', 'message': f'File written: {path}'}
        except Exception as e:
            logger.error(f"Error writing file: {e}")
            return {'error': f'Error writing file: {e}'}
    
    def list_files(self, path: str = '.') -> List[str]:
        """
        ディレクトリ内のファイルを一覧表示する。
        
        Args:
            path: ディレクトリパス
        
        Returns:
            ファイル・ディレクトリ名のリスト
        """
        try:
            abs_path = self._validate_path(path)
            logger.info(f"Listing files: {abs_path}")
            
            entries = os.listdir(abs_path)
            return entries
        except Exception as e:
            logger.error(f"Error listing files: {e}")
            return []
    
    def mkdir(self, path: str) -> Dict[str, Any]:
        """
        ディレクトリを作成する。
        
        return {
            'status': 'success',
            'message': f'Directory created: {path}'
        }
    except Exception as e:
        logger.error(f"Error creating directory: {e}")
        return {'error': f'Error creating directory: {e}'}
    
    def file_exists(self, path: str) -> bool:
        """
        ファイルが存在するか確認する。
        
        Args:
            path: ファイルパス
        
        Returns:
            存在する場合は True
        """
        try:
            abs_path = self._validate_path(path)
            return os.path.exists(abs_path)
        except ValueError:
            return False
        except Exception as e:
            logger.error(f"Error checking file existence: {e}")
            return False
    
    def find_files(self, pattern: str = '*', recursive: bool = True, path: str = '.') -> List[str]:
        """
        ファイルを検索する。
        
        Args:
            pattern: 検索パターン（例: *.py）
            recursive: 再帰的に検索するか
            path: 検索開始ディレクトリ
        
        Returns:
            マッチしたファイルパスのリスト
        """
        try:
            abs_path = self._validate_path(path)
            logger.info(f"Finding files: {abs_path} (pattern: {pattern}, recursive: {recursive})")
            
            if recursive:
                matches = []
                for root, dirs, files in os.walk(abs_path):
                    for file in files:
                        # globパターンマッチング
                        import fnmatch
                        if fnmatch.fnmatch(file, pattern):
                            # 相対パスで返す
                            rel_path = os.path.relpath(os.path.join(root, file), self.workspace_root)
                            matches.append(rel_path)
                return matches
            else:
                import fnmatch
                entries = os.listdir(abs_path)
                return [e for e in entries if fnmatch.fnmatch(e, pattern)]
        except Exception as e:
            logger.error(f"Error finding files: {e}")
            return []
    
    def delete_file(self, path: str) -> Dict[str, Any]:
        """
