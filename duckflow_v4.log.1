<<<
import { Engine, System } from '../src/engine';

class MockSystem implements System {
    public initialized = false;
    public updateCount = 0;
    public lastDeltaTime = 0;

    async initialize(engine: Engine): Promise<void> {
        this.initialized = true;
    }

    update(deltaTime: number): void {
        this.updateCount++;
        this.lastDeltaTime = deltaTime;
    }
}

describe('Engine', () => {
    beforeEach(() => {
        // シングルトンリセットのためのテスト用メソッドを追加
        (Engine as any).instance = null;
    });

    test('should create singleton instance', () => {
        const engine1 = Engine.Instance;
        const engine2 = Engine.Instance;
        expect(engine1).toBe(engine2);
    });

    test('should register and retrieve systems', () => {
        const engine = Engine.Instance;
        const mockSystem = new MockSystem();

        engine.registerSystem('test', mockSystem);
        expect(engine.getRegisteredSystems()).toContain('test');

        const retrievedSystem = engine.getSystem<MockSystem>('test');
        expect(retrievedSystem).toBe(mockSystem);
    });

    test('should throw error for duplicate system registration', () => {
        const engine = Engine.Instance;
        const mockSystem = new MockSystem();

        engine.registerSystem('test', mockSystem);
        expect(() => {
            engine.registerSystem('test', mockSystem);
        }).toThrow('System \'test\' is already registered');
    });

    test('should throw error for non-existent system', () => {
        const engine = Engine.Instance;
        expect(() => {
            engine.getSystem('nonexistent');
        }).toThrow('System \'nonexistent\' not found');
    });

    test('should initialize systems', async () => {
        const engine = Engine.Instance;
        const mockSystem = new MockSystem();

        engine.registerSystem('test', mockSystem);
        await engine.initialize();

        expect(mockSystem.initialized).toBe(true);
    });
});
