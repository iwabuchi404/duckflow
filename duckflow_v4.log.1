content: #!/usr/bin/env python3
import sys
import os

# Add the project root to Python path
project_root = os.path.dirname(os.pathagent)  # type: ignore
if project_root not in sys.path:
    sys.path.insert(0, project_root)

from companion.core import DuckAgent
from companion.modules.ui import UI

def main():
    # Initialize UI
    ui = UI()
    ui.print_welcome()
    
    # Initialize DuckAgent
    agent = DuckAgent(ui=ui)
    
    # Run the agent
    if len(sys.argv) > 1:
        # If arguments provided, treat as initial prompt
        initial_prompt = " ".join(sys.argv[1:])
        agent.run(initial_prompt)
    else:
        # Interactive mode
        agent.run()

if __name__ == "__main__":
    main()
