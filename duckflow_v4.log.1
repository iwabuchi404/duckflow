Sub-LLM Manager
===============
Manages specialized LLM workers for code generation and analysis.
"""

import logging
from typing import Optional, Dict, Any
from companion.base.llm_client import LLMClient
from companion.utils.parser import parse_symops
from companion.utils.response_format import ResponseFormat
from companion.logging.log_manager import LogManager

class SubLLMManager:
    """
    Manages sub-LLM workers for specialized tasks:
    - Code generation
    - Code analysis
    - Documentation generation
    """
    
    def __init__(self):
        self.logger = logging.getLogger(__name__)
        self.llm_client = LLMClient(
            os.getenv("LLM_URL", "http://localhost:11434"),
            os.getenv("LLM_MODEL", "qwen2.5:7b")
        )
        self.log_manager = LogManager()
        self.logger.info("SubLLMManager initialized")

    async def generate_code(self, path: str, content: str) -> Dict[str, Any]:
        """
        Generate code using a specialized LLM worker.
        Returns a summary only - you will NOT receive the generated code content back.
        """
        self.logger.info(f"Generating code for: {path}")
        
        # Parse [Instruction] and [Context] sections
        instruction = self._extract_section(content, "Instruction")
        context = self._extract_section(content, "Context")
        
        if not instruction:
            return {"error": "Missing [Instruction] section", "path": path}
        
        # Build prompt
        prompt = self._build_code_generation_prompt(instruction, context)
        
        # Call LLM
        try:
            response = await self.llm_client.generate(prompt)
            generated_code = self._extract_code_from_response(response)
            
            # Save to file
            with open(path, 'w', encoding='utf-8') as f:
                f.write(generated_code)
            
            return {
                "success": True,
                "path": path,
                "lines": len(generated_code.split('\n')),
                "size_bytes": len(generated_code.encode('utf-8'))
            }
        except Exception as e:
            return {"error": str(e), "path": path}

    async def analyze_structure(self, path: str) -> Dict[str, Any]:
        """
        Generate a structural outline (Code Map) of a file.
        """
        self.logger.info(f"Analyzing structure of: {path}")
        
        try:
            with open(path, 'r', encoding='utf-8') as f:
                content = f.read()
            
            prompt = self._build_analysis_prompt(content)
            response = await self.llm_client.generate(prompt)
            
            return {
                "path": path,
                "structure": response,
                "summary": f"Analyzed {path}"
            }
        except Exception as e:
            return {"error": str(e), "path": path}

    def _extract_section(self, content: str, section_name: str) -> Optional[str]:
        """Extract [Section] from content"""
        pattern = f"\[{section_name}\]"
        if pattern in content:
            parts = content.split(pattern)
            if len(parts) > 1:
                return parts[1].split('[')[0].strip()
        return None

    def _build_code_generation_prompt(self, instruction: str, context: str) -> str:
        """Build a prompt for code generation"""
        return f"""You are a coding assistant. Generate code based on the following instruction.

[Instruction]
{instruction}

[Context]
{context}

Please generate the code in the appropriate language and format.
"""

