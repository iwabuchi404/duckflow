import csv
from datetime import datetime
from collections import defaultdict

def analyze_logs():
    # Dictionary to store error counts per hour
    error_counts = defaultdict(int)
    
    # Read the log file
    try:
        with open('app.log', 'r') as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                
                # Parse log entry format: "TIMESTAMP [LEVEL] Message"
                try:
                    # Extract timestamp and level
                    timestamp_str = line[:19]  # "2024-01-01 10:00:00"
                    level_start = line.find('[') + 1
                    level_end = line.find(']')
                    level = line[level_start:level_end]
                    
                    # Only process ERROR entries
                    if level == 'ERROR':
                        # Convert to datetime object
                        timestamp = datetime.strptime(timestamp_str, '%Y-%m-%d %H:%M:%S')
                        
                        # Group by hour (format: "2024-01-01 10:00")
                        hour_key = timestamp.strftime('%Y-%m-%d %H:00')
                        
                        # Increment count
                        error_counts[hour_key] += 1
                        
                except (ValueError, IndexError) as e:
                    print(f"Warning: Could not parse log entry: {line}")
                    continue
        
        # Sort the results by hour
        sorted_hours = sorted(error_counts.keys())
        
        # Write to CSV
        with open('stats.csv', 'w', newline='') as csvfile:
            writer = csv.writer(csvfile)
            # Write header
            writer.writerow(['Hour', 'Error Count'])
            
            # Write data
            for hour in sorted_hours:
                writer.writerow([hour, error_counts[hour]])
        
        print(f"Analysis complete. Found {len(error_counts)} hours with errors.")
        print(f"Total ERROR entries: {sum(error_counts.values())}")
        print("Results saved to stats.csv")
        
        # Print summary
        print("\nError count by hour:")
        for hour in sorted_hours:
            print(f"{hour} -> {error_counts[hour]}")
            
    except FileNotFoundError:
        print("Error: app.log file not found. Please run generate_logs.py first.")
    except Exception as e:
        print(f"Error analyzing logs: {e}")

if __name__ == "__main__":
    analyze_logs()
