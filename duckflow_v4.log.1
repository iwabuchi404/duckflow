            ui.print_result(f"Command executed successfully. Output: {output}")
            
            return {"type": "symops_response", "content": f"::response <<< Command executed successfully. Output: {output} >>>"}
            
        except subprocess.TimeoutExpired:
            error_msg = "Command execution timed out (30 seconds)"
