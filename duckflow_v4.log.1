content: """
Duckflow v4 Core Logic
"""
from typing import Optional
from companion.state.agent_state import AgentState
from companion.base.llm_client import LLMClient
from companion.modules.pacemaker import Pacemaker
from companion.utils.parser import parse_response
from companion.utils.response_format import format_response
from companion.ui.console import console
from companion.modules.model_manager import ModelManager
from companion.security.file_protector import FileProtector
from companion.modules.sub_llm_manager import SubLLMManager
from companion.modules.memory import MemoryManager
from companion.task_management.pecking_order import PeckingOrder
from companion.utils.sym_ops import parse_sym_ops

# ============================================
# DuckAgent: メインエージェントクラス
# ============================================

class DuckAgent:
    """
    Duckflow v4 のメインエージェントクラス。
    ユーザー入力を受信し、LLMと対話してアクションを実行します。
    """

    def __装飾用
    def __init__(self, config: dict):
        self.config = config
        self.state = AgentState()
        self.llm_client = LLMClient(config)
        self.pacemaker = Pacemaker()
        self.model_manager = ModelManager(config)
        self.file_protector = FileProtector(config)
        self.sub_llm_manager = SubLLMManager(config)
        self.memory_manager = MemoryManager(self.state)
        self.pecking_order = PeckingOrder(self.state)
        self.tool_registry = {}
        self._register_tools()

    def _register_tools(self):
        """ツールを登録する"""
        from companion.tools.file_ops import FileOps
        from companion.tools.shell_tool import ShellTool
        from companion.tools.plan_tool import PlanTool
        from companion.tools.task_tool import TaskTool
        from companion.tools.sub_llm_tools import SubLLMTools
        from companion.tools.approval import ApprovalTool
        from companion.tools.memory_tool import MemoryTool
        class ToolWrapper:
            def __init__(self, tool, agent_state):
                self.tool = tool
                self.state = agent_state
            def execute(self, action_name, params):
                return self.tool.execute(action_name, params, self.state)

        tools = [
            FileOps(config=self.config),
            ShellTool(config=self.config),
            PlanTool(config=self.config),
            TaskTool(config=self.config),
            self.sub_llm_manager,
            ApprovalTool(config=self.config),
            MemoryTool(config=self.config),
        ]
        for tool in tools:
            wrapper = ToolWrapper(tool, self.state)
            for action_name in tool.get_actions():
                self.tool_registry[action_name] = wrapper

    async def run(self, user_input: str) -> Optional[str]:
        """
        メインループ
        """
        # ユーザー入力を履歴に追加
        self.state.add_message("user", user_input)
        loop_count = 0
        max_loops = self.pacemaker.calculate_max_loops(self.state)

        while True:
            loop_count += 1
            if loop_count > max_loops:
                return self.pacemaker.handle_loop_limit()

            # LLMを呼び出し
            llm_response = await self.llm_client.call_llm(self.state)

            # Sym-Opsパース
            parsed = parse_sym_ops(llm_response)
            if not parsed:
                return self.pacemaker.handle_parse_error(llm_response)

            # Vitals更新
            self.state.vitals.update(parsed.get('vitals', {}))

            # アクション実行
            for action in parsed['actions']:
                action_result = self._execute_action(action)
                self.state.add_message("assistant", action_result)

                # ループ終了条件
                if action['name'] in ['response', 'report', 'finish', 'exit']:
                    return action_result

            # メモリ管理
            self.memory_manager.prune_if_needed()

            # Pecking Orderチェック
            if self.pecking_order.should_wait_for_user():
                return self.pecking_order.get_wait_message()

    def _execute_action(self, action: dict) -> str:
        """アクションを実行する"""
        action_name = action['name']
        params = action.get('parameters', {})

        # ツール実行
        if action_name in self.tool_registry:
            return self.tool_registry[action_name].execute(action_name, params)
        else:
            # Unknown Tool Filter
            return f"[Unknown Tool] {action_name} は登録されていません"
