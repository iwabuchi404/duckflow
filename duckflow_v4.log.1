"""
Interactive model selector using Textual TUI.
Allows users to select models using cursor keys (up/down).
"""
from typing import List, Dict, Any, Optional
from textual.app import App, ComposeResult
from textual.containers import Container, Vertical
from textual.widgets import Header, Footer, Static, OptionList
from textual.screen import Screen
from textual.binding import Binding


class ModelOption:
    """Represents a model option for display."""
    def __init__(self, model_id: str, name: str, context_length: int, 
                 prompt_price: str, completion_price: str, description: str = ""):
        self.model_id = model_id
        self.name = name
        self.context_length = context_length
        self.prompt_price = prompt_price
        self.completion_price = completion_price
        self.description = description
    
    def __str__(self) -> str:
        # Format: "Model Name (ctx: 128K, $0.001/1K)"
        ctx_str = self._format_context()
        price_str = self._format_price()
        return f"{self.name} ({ctx_str}, {price_str})"
    
    def _format_context(self) -> str:
        """Format context length for display."""
        if self.context_length >= 1_000_000:
            return f"{self.context_length // 1000}K"
        elif self.context_length >= 1000:
            return f"{self.context_length // 1000}K"
        return str(self.context_length)
    
    def _format_price(self) -> str:
        """Format price for display."""
        try:
            prompt = float(self.prompt_price) * 1000  # per 1K tokens
            if prompt < 0.01:
                return f"${prompt:.4f}/1K"
            return f"${prompt:.2f}/1K"
        except (ValueError, TypeError):
            return "N/A"


class ModelSelectorScreen(Screen):
    """Screen for selecting a model from a list."""
    
    BINDINGS = [
        Binding("up", "cursor_up", "Up", show=False),
        Binding("down", "cursor_down", "Down", show=False),
        Binding("enter", "select", "Select"),
        Binding("escape", "cancel", "Cancel"),
        Binding("q", "cancel", "Quit"),
    ]
    
    CSS = """
    ModelSelectorScreen {
        align: center middle;
    }
    
    #selector-container {
        width: 80;
        height: 25;
        border: thick $primary;
        background: $surface;
        padding: 1;
    }
    
    #title {
        text-align: center;
        text-style: bold;
        color: $accent;
        margin-bottom: 1;
    }
    
    #hint {
        text-align: center;
        color: $text-muted;
        margin-top: 1;
    }
    
    OptionList {
        height: 18;
        border: solid $primary;
    }
    
    OptionList:focus {
        border: double $accent;
    }
    """
    
    def __init__(self, models: List[ModelOption], title: str = "モデルを選択"):
        super().__init__()
        self.models = models
        self.title_text = title
        self.selected_index: Optional[int] = None
    
    def compose(self) -> ComposeResult:
        yield Header()
        with Container(id="selector-container"):
            yield Static(self.title_text, id="title")
            option_list = OptionList(*[str(m) for m in self.models], id="model-list")
            yield option_list
            yield Static("↑↓ で選択 | Enter で決定 | Esc/q でキャンセル", id="hint")
        yield Footer()
    
    def on_mount(self) -> None:
        """Focus the option list when screen mounts."""
        self.query_one("#model-list", OptionList).focus()
    
    def action_cursor_up(self) -> None:
        """Move cursor up."""
        self.query_one("#model-list", OptionList).action_cursor_up()
    
    def action_cursor_down(self) -> None:
        """Move cursor down."""
        self.query_one("#model-list", OptionList).action_cursor_down()
    
    def action_select(self) -> None:
        """Select the highlighted option."""
        option_list = self.query_one("#model-list", OptionList)
        self.selected_index = option_list.highlighted
        if self.selected_index is not None:
            self.app.exit(result=self.selected_index)
    
    def action_cancel(self) -> None:
        """Cancel selection."""
        self.app.exit(result=None)


class ModelSelectorApp(App):
    """Main application for model selection."""
    
    CSS = """
    Screen {
        background: $surface;
    }
    """
    
    def __init__(self, models: List[ModelOption], title: str = "モデルを選択"):
        super().__init__()
        self.models = models
        self.title = title
        self.result: Optional[int] = None
    
    def on_mount(self) -> None:
        """Push the selector screen on mount."""
        self.push_screen(ModelSelectorScreen(self.models, self.title))
    
    def on_screen_suspend(self, event) -> None:
        """Handle screen suspend - capture result."""
        if hasattr(event.screen, 'selected_index'):
            self.result = event.screen.selected_index


def select_model_interactive(models: List[Dict[str, Any]], title: str = "モデルを選択") -> Optional[Dict[str, Any]]:
    """
    Launch an interactive model selector TUI.
    
    Args:
        models: List of model dictionaries from ModelManager
        title: Title to display in the selector
    
    Returns:
        Selected model dict or None if cancelled
    """
    if not models:
        return None
    
    # Convert to ModelOption objects
    options = []
    for m in models:
        option = ModelOption(
            model_id=m.get("id", m.get("model_id", "")),
            name=m.get("name", m.get("id", "Unknown")),
            context_length=m.get("context_length", 0),
            prompt_price=m.get("prompt_price", "0"),
            completion_price=m.get("completion_price", "0"),
            description=m.get("description", "")
        )
        options.append(option)
    
    # Run the selector app
    app = ModelSelectorApp(options, title)
    app.run()
    
    # Return selected model
    if app.result is not None and 0 <= app.result < len(models):
        return models[app.result]
    return None


if __name__ == "__main__":
    # Test the selector with sample models
    test_models = [
        {"id": "openai/gpt-4o", "name": "GPT-4o", "context_length": 128000, 
         "prompt_price": "0.000005", "completion_price": "0.000015"},
        {"id": "anthropic/claude-3.5-sonnet", "name": "Claude 3.5 Sonnet", "context_length": 200000,
         "prompt_price": "0.000003", "completion_price": "0.000015"},
        {"id": "google/gemini-2.0-flash", "name": "Gemini 2.0 Flash", "context_length": 1000000,
         "prompt_price": "0.0000001", "completion_price": "0.0000004"},
    ]
    
    selected = select_model_interactive(test_models)
    if selected:
        print(f"Selected: {selected['id']}")
    else:
        print("Cancelled")
