"""
CommandExecutor - セキュアなコマンド実行モジュール

このモジュールは、システムコマンドやPythonスクリプトを安全に実行する機能を提供します。
特にサンドボックス環境での実行と、リソース制限を重視しています。

特徴:
- タイムアウト制御
- リソース使用量の制限
- 出力のキャプチャ
- 危険なコマンドのブロック
"""

import asyncio
import os
import sys
import logging
from typing import Dict, Any, Optional
from contextlib import asynccontextmanager
from companion.utils.resource_limiter import ResourceLimiter

class CommandExecutor:
    """コマンド実行を管理するクラス"""
    
    def __init__(self, workspace_root: str = "."):
        self.workspace_root = os.path.abspath(workspace_root)
        self.logger = logging.getLogger(__name__)
        self.resource_limiter = ResourceLimiter()
    
    async def run_python_file(self, file_path: str) -> Dict[str, Any]:
        """
        Pythonファイルを実行
        
        Args:
            file_path: 実行対象のPythonファイルパス
            
        Returns:
            実行結果の辞書（stdout, stderr, returncode）
        """
        # ワークスペース内のパスか確認
        abs_path = os.path.abspath(file_path)
        if not abs_path.startswith(self.workspace_root):
            raise ValueError("セキュリティエラー: ワークスペース外のファイルは実行できません")
        
        # Pythonファイルか確認
        if not file_path.endswith('.py'):
            raise ValueError("エラー: Pythonファイルのみ実行可能です")
        
        # コマンドの構築
        cmd = [sys.executable, file_path]
        
        # 実行
        return await self._execute_command(cmd, timeout=30)
    
    async def run_command(self, command: str, timeout: int = 30) -> Dict[str, Any]:
        """
        任意のコマンドを実行（制限付き）
        
        Args:
            command: 実行コマンド
            timeout: タイムアウト秒数
            
        Returns:
            実行結果の辞書
        """
        # 危険なコマンドのブロック
        if self._is_dangerous_command(command):
            raise ValueError("セキュリティエラー: 危険なコマンドの実行は許可されていません")
        
        # コマンドの分割
        cmd_parts = command.split()
        return await self._execute_command(cmd_parts, timeout)
    
    async def _execute_command(self, cmd: list, timeout: int = 30) -> Dict[str, Any]:
        """コマンド実行の低レベル処理"""
        try:
            self.logger.info(f"コマンド実行開始: {' '.join(cmd)}")
            
            # リソース制限の適用
            async with self.resource_limiter.limit_resources():
                proc = await asyncio.create_subprocess_exec(
                    *cmd,
                    stdout=asyncio.subprocess.PIPE,
                    stderr=asyncio.subprocess.PIPE,
                    limit=1024*1024  # 1MBバッファ制限
                )
                
                try:
                    stdout, stderr = await asyncio.wait_for(
                        proc.communicate(),
                        timeout=timeout
                    )
                except asyncio.TimeoutError:
                    proc.kill()
                    await proc.wait()
                    raise TimeoutError(f"コマンド実行が{timeout}秒でタイムアウト")
                
                return {
                    "returncode": proc.returncode,
                    "stdout": stdout.decode(),
                    "stderr": stderr.decode(),
                    "command": ' '.join(cmd)
                }
                
        except Exception as e:
            return {
                "returncode": -1,
                "stdout": "",
                "stderr": str(e),
                "command": ' '.join(cmd) if isinstance(cmd, list) else cmd
            }
