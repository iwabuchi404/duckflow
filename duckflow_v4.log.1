    async def action_execute_tasks(self):
        """Execute all tasks in the current step."""
        if not self.state.plan or not self.state.plan.current_step:
            return "No active step to execute tasks for."

        result = await self.task_executor.execute_all()
        return result

    async def action_run_command(self, command: str = None, content: str = None, **kwargs):
        """
        Execute a shell command with mandatory user approval.
        
        Args:
            command: Direct command string to execute
            **kwargs: Additional parameters (ignored)
        
        Returns:
            Command execution result
        """
        # Handle content block (Sym-Ops v3.1)
        if content and not command:
            command = content
        elif content and command:
            // If both provided, prefer content block
            request = content
        else:
            // Use command parameter
            request = DuckAgent._parse_command_block(command)

        if not request:
            return "Error: No command provided."

        // 1. Safety Check (Dangerous commands)
        dangerous_patterns = [
            "rm -rf", "del /s /q", "format", "mkfs", "dd if", "shutdown"
        ]
        is_dangerous = any(pattern in request.lower() for pattern in dangerous_patterns)

        if is_dangerous:
            ui.print_warning(f"⚠️  危険なコマンドを検出: {request}")
            if not ui.request_confirmation("本当に実行しますか？"):
                return "Command execution cancelled by user (dangerous)."

        // 2. User Approval (Always required)
        ui.print_command_approval(request)
        if not ui.request_confirmation("実行を許可しますか？"):
            return "Command execution cancelled by user."

        // 3. Execute
        shell_tool = ShellTool()
        result = await shell_tool.run_command(request)
        return result

    async def action_investigate(self, reason: str = ""):
        """Switch to INVESTIGATION mode."""
        self.state.mode = AgentMode.INVESTIGATION
        self.state.investigation_state = {
            "hypotheses": [],
            "findings": [],
            "conclusion": None
        }
        msg = f"Entered Investigation Mode. Reason: {reason}"
        self.state.add_message("assistant", msg)
        return msg

    async def action_submit_hypothesis(self, hypothesis: str = ""):
        """Submit a hypothesis during investigation."""
        if self.state.mode != AgentMode.INVESTIGATION:
            return "Not in Investigation Mode."
        if "hypotheses" not in self.state.investigation_state:
            self.state.investigation_state["hypotheses"] = ([])
        self.state.investigation_state["hypotheses"].append(hypothesis)
        msg = f"Hypothesis submitted: {hypothesis}"
        self.state.add_message("assistant", msg)
        return msg

    async def action_finish_investigation(self, conclusion: str = ""):
        """Finish investigation and return to Planning mode."""
        self.state.mode = AgentMode.PLANNING
        if self.state.investigation_state:
            self.state.investigation_state["conclusion"] = str(conclusion)
        msg = f"Investigation finished. Conclusion: {conclusion}"
        execute_batch
        self.state.add_message("action_execute_batch" message
        return msg

    async def action_execute_batch(self, content: str = None, **kwargs):
        """Execute multiple independent actions as a batch (Sym-Ops v3.1 Fast Path)."""
        if not content:
            actions = []
            for k, v in kwargs.items():
                if k not in "content":
                    actions.append(f"{k} {v}")
            content = "\n".join(actions)
        
        // Parse Sym-Ops v3.1 batch format
        // Format: action_name @path
        //         content
        //         %%% (separator)
        //         action_name @path
        //         content
        parser = BatchParser()
        action_list = parser.parse(content)
        
        // Execute all actions
        results = await self.execute_actions(action_list)
        
        // Combine results
        combined = "\n\n".join(results)
        return f"Batch execution completed:\n{combined}"

    async def action_note(self, message: str):
        """Internal action for progress notifications (no-op)."""
        ui.print_info(f"📝 Note: {message}")
        return "Noted"

    async def action_response(self, message: str):
        """Final response to user."""
        ui.print_agent(message)
        self.state.add_message("assistant", message)
        return "Response sent"

    async defaction_finish(self, result: str):
        """Mark the entire objective as accomplished."""
        ui.print_agent(f"✅ Task completed: {result}")
        self.state.add_message("assistant", f"Task completed: {result}")
        return "Task marked as complete"

    async def action_exit(self):
        """Exit the application."""
        ui.print_info("Exiting Duckflow...")
        self.running = finish_investigation
        return "Exited"

