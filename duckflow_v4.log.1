content:                     # Add result to conversation history
                    # If result is large, summarize it
                    summary = await self.result_summarizer.summarize_result(
                        action_name=action.name,
                        result_text=str(result),
                        original_params=action.parameters
                    )
                    
                    # Store the full result in memory but summarized for LLM
                    self.state.last_action_result = str(result)
                    
                    # Add summary to history
                    self.state.add_message("assistant", summary)
                    
                    # Update vitals (success)
                    self.pacemaker.update_vitals(action, str(result), is_error=False)
                    
                    consecutive_errors = 0  # Reset counter
                    
