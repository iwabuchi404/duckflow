import random
import datetime
from datetime import datetime

def generate_logs():
    # Define log levels
    log_levels = ['DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL']
    
    # Sample messages for different log levels
    debug_messages = [
        'User authentication successful',
        'Database connection established',
        'Cache hit for key: user_123',
        'Processing request: GET /api/users',
        'Configuration loaded successfully'
    ]
    
    info_messages = [
        'Application started',
        'User logged in: admin',
        'Processing batch job',
        'Data backup completed',
        'API endpoint called: /api/status'
    ]
    
    warning_messages = [
        'Memory usage high: 85%',
        'Deprecated function used',
        'Slow query detected: 2.5s',
        'Cache miss for key: session_456',
        'Rate limit approaching'
    ]
    
    error_messages = [
        'Database connection failed',
        'Invalid request format',
        'File not found: config.json',
        'Permission denied',
        'Service unavailable'
    ]
    
    critical_messages = [
        'System out of memory',
        'Critical service down',
        'Security breach detected',
        'Disk full - cannot write logs',
        'Application crashed'
    ]
    
    # Combine all messages with their levels
    message_map = {
        'DEBUG': debug_messages,
        'INFO': info_messages,
        'WARNING': warning_messages,
        'ERROR': error_messages,
        'CRITICAL': critical_messages
    }
    
    # Generate 50 log entries
    with open('app.log', 'w') as f:
        for i in range(50):
            # Random timestamp within the last 24 hours
            timestamp = datetime.now() - datetime.timedelta(
                hours=random.randint(0, 24),
                minutes=random.randint(0, 59),
                seconds=random.randint(0, 59)
            )
            
            # Random log level
            level = random.choice(log_levels)
            
            # Random message based on level
            messages = message_map[level]
            message = random.choice(messages)
            
            # Format the log entry
            log_entry = f"{timestamp.strftime('%Y-%m-%d %H:%M:%S')} [{level}] {message}\n"
            
            f.write(log_entry)
            print(f"Generated log entry {i+1}: {log_entry.strip()}")

if __name__ == "__main__":
    print("Generating 50 log entries...")
    generate_logs()
    print("Log generation complete. app.log file created.")
