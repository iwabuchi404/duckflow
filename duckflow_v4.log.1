/**
 * Entity - ゲーム世界のオブジェクト
 * コンポーネントを持つことができます
 */

export class Entity {
  private id: string;
  private components: Map<string, any> = new Map();
  private isActive: boolean = true;

  constructor(id: string) {
    this.id = id;
  }

  /**
   * エンティティのIDを取得
   */
  public getId(): string {
    return this.id;
  }

  /**
   * コンポーネントを追加
   */
  public addComponent<T>(componentType: string, component: T): void {
    if (this.components.has(componentType)) {
      console.warn(`[Entity] Component '${componentType}' already exists on entity '${this.id}'`);
      return;
    }
    this.components.set(componentType, component);
    console.log(`[Entity] Component '${componentType}' added to entity '${this.id}'`);
  }

  /**
   * コンポーネントを取得
   */
  public getComponent<T>(componentType: string): T | undefined {
    return this.components.get(componentType) as T | undefined;
  }

  /**
   * コンポーネントが存在するかチェック
   */
  public hasComponent(componentType: string): boolean {
    return this.components.has(componentType);
  }

  /**
   * コンポーネントを削除
   */
  public removeComponent(componentType: string): boolean {
    const result = this.components.delete(componentType);
    if (result) {
      console.log(`[Entity] Component '${componentType}' removed from entity '${this.id}'`);
    }
    return result;
  }

  /**
   * すべてのコンポーネントを取得
   */
  public getComponents(): Map<string, any> {
    return new Map(this.components);
  }

  /**
   * エンティティをアクティブにする
   */
  public setActive(active: boolean): void {
    this.isActive = active;
  }

  /**
   * エンティティがアクティブかどうかを確認
   */
  public getIsActive(): boolean {
    return this.isActive;
  }

  /**
   * すべてのコンポーネントを削除
   */
  public clearComponents(): void {
    this.components.clear();
    console.log(`[Entity] All components cleared from entity '${this.id}'`);
  }
}
