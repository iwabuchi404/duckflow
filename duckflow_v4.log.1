                    action_params["content"] += line + "\n"
            
            // Clean up content delimiters from content
            if "content" in action_params:
                action_params["content"] = action_params["content"].strip()
            
            actions.append(Action(name=action_name, parameters=action_params))
        
        // Execute all actions
        results = []
        for action in actions:
            ui.print_action(action.name, action.parameters, "Batch execution")
