### プレイヤーエンティティの作成

```typescript
// プレイヤークラスの定義
class Player extends Entity {
    constructor(id: string) {
        super(id, 'player');
        
        // コンポーネントの追加
        this.addComponent(new TransformComponent(0, 0));
        this.addComponent(new SpriteComponent('player.png'));
        this.addComponent(new HealthComponent(100, 100));
        this.addComponent(new MovementComponent(5));
        this.addComponent(new InputComponent());
    }
}

// プレイヤーの生成と登録
const player = new Player('player1');
const entitySystem = engine.getSystem<EntitySystem>('entity');
entitySystem.registerEntity(player);
```

