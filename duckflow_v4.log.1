    async def _handle_code_execution(self, action: Action) -> AgentState:
        """コード実行アクションの処理"""
        try:
            self.logger.info(f"コード実行を開始: {action.target_path}")
            
            # 実行処理の委譲
            result = await self.executor.run_python_file(action.target_path)
            
            # 要約生成
            summary = summarizer.summarize(result)
            
            # 状態更新
            new_state = self.state.update(
                last_action=action,
                last_result=result,
                conversation_context=summary
            )
            
            # 対話の継続を示すメッセージを生成
            follow_up = self._generate_follow_up_message(result, action.target_path)
            
            # ユーザーへのフィードバック
            feedback = f"{summary}\n\n{follow_up}"
            
            return new_state.update(
                pending_response=feedback,
                phase=Phase.EXECUTION_COMPLETE
            )
            
        except Exception as e:
            self.logger.error(f"コード実行中に例外: {str(e)}")
            return self.state.update(
                phase=Phase.ERROR,
                error=str(e),
                pending_response=f"❌ 実行処理で内部エラーが発生しました: {str(e)}"
            )
    
    def _generate_follow_up_message(self, result: Dict[str, Any], file_path: str) -> str:
        """実行結果に基づいたフォローアップメッセージを生成"""
        if result["returncode"] == 0:
            stdout = result["stdout"].strip()
            
            # 数値結果の場合
            if stdout.replace('.', '', 1).isdigit():
                return "この計算結果をどのように使いたいですか？さらに計算を続けることができます。"
            
            # JSON出力の場合
            if stdout.startswith('{') and stdout.endswith('}'):
                return "データが正常に取得できました。このデータを可視化したり、別の処理に使ったりできますか？"
            
            return (
                "実行が正常に完了しました！\n"
                "次に何をしたいですか？\n"
                "- 結果を確認\n"
                "- 別のファイルを実行\n"
                "- コードを改良\n"
                "- 新しいタスクの開始"
            )
        
        # エラー時のフォローアップ
        stderr = result["stderr"].lower()
        if "syntax" in stderr or "indentation" in stderr:
            return (
                "構文エラーが発生しました。\n"
                "修正案:\n"
                "1. インデントを確認\n"
                "2. 欠落しているコロンを追加\n"
                "3. 文字列のクォーテーションを確認\n\n"
                "修正後のコードを送信してください。"
            )
        
        if "module" in stderr and "not found" in stderr:
            return (
                "必要なモジュールがインストールされていません。\n"
                "対処方法:\n"
                "1. `pip install モジュール名` でインストール\n"
                "2. requirements.txtへの追加を提案\n\n"
                "どのモジュールが必要か特定できていますか？"
            )
        
        return "このエラーの修正が必要です。修正方針について話し合えますか？"

    async def _continue_conversation(self, user_input: str) -> AgentState:
        """対話の継続処理"""
        # 前回の実行結果に基づいた文脈を保持
        if self.state.phase == Phase.EXECUTION_COMPLETE:
            context = f"前回の実行結果: {self.state.conversation_context}\n"
            context += f"ユーザーの追加要求: {user_input}"
            
            # 文脈を保持したまま次のアクションを提案
            return await self._generate_next_steps(context)
        
        return await self._process_user_input(user_input)
