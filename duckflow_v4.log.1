content: import logging
from typing import List, Dict, Any, Optional, Tuple
from datetime import datetime, timedelta

from companion.state.agent_state import (
    AgentState, Vitals, TaskStatus, InterventionReason,
    AgentMode, InvestigationState
)

logger = logging.getLogger(__name__)

class MemoryManager:
    """
    Memory Manager for Duckflow v4.
    Manages conversation history pruning and archiving.
    """
    
    def __init__(self, llm_client: Any, max_tokens: int = 8000):
        """
        Args:
            llm_client: LLM client for summarization
            max_tokens: Maximum tokens to keep in conversation history
        """
        self.llm_client = llm_client
        self.max_tokens = max_tokens
    
    def should_prune(self, history: List[Dict[str, str]]) -> bool:
        """
        Check if conversation history needs pruning.
        
        Args:
            history: Conversation history list
        
        Returns:
            True if pruning is needed, False otherwise
        """
        # Simple heuristic: count characters and estimate tokens
        # 1 token ≈ 4 characters (rough estimate)
        total_chars = sum(len(msg.get("content", "")) for msg in history)
        estimated_tokens = total_chars / 4
        
        return estimated_tokens > self.max_tokens
    
    async def prune_history(
        self, 
        history: List[Dict[str, str]]
    ) -> Tuple[List[Dict[str, str]], Dict[str, Any]]:
        """
        Prune conversation history by summarizing old messages.
        
        Args:
            history: Conversation history list
        
        Returns:
            Tuple of (pruned_history, stats)
        """
        if not history:
            return history, {"pruned": 0, "kept": 0}
        
        # Keep recent messages (last 10)
        keep_count = 10
        recent_messages = history[-keep_count:]
        old_messages = history[:-keep_count]
        
        if not old_messages:
            return history, {"pruned": 0, "kept": len(history)}
        
        # Summarize old messages
        try:
            summary_prompt = (
                "Summarize the following conversation history into a concise bullet-point format. "
                "Focus on key decisions, file changes, and task progress. "
                "Keep it under 200 tokens."
            )
            
            messages = [
                {"role": "system", "content": summary_prompt},
                {"role": "user", "content": "\n".join([f"{msg['role']}: {msg['content']}" for msg in old_messages])}
            ]
            
            response = await self.llm_client.chat(messages, response_model=str)
            summary = response if isinstance(response, str) else str(response)
            
            # Create summary message
            summary_msg = {
                "role": "system",
                "content": f"[Conversation Summary]\n{summary}"
            }
            
            # Combine: summary + recent messages
            pruned_history = [summary_msg] + recent_messages
            
            stats = {
                "pruned": len(old_messages),
                "kept": len(recent_messages),
                "summary_tokens": len(summary) / 4  # Rough estimate
            }
            
            logger.info(f"Pruned {len(old_messages)} messages, kept {len(recent_messages)}")
            return pruned_history, stats
            
        except Exception as e:
            logger.error(f"Failed to prune history: {e}")
            # Fallback: just truncate
            pruned_history = history[-keep_count:]
            return pruned_history, {"pruned": len(history) - keep_count, "kept": keep_count}
    
    async def restore_with_summary(
        self, 
        history: List[Dict[str, str]]
    ) -> L
ist[Dict[str, str]]:
        """
        Restore session with aggressive summarization.
        Used when loading a large session from disk.
        
        Args:
            history: Full conversation history from session file
        
        Returns:
            Pruned history suitable for LLM context
        """
        if not history:
            return history
        
        # For restore, be more aggressive: keep only last 5
        keep_count = 5
        recent_messages = history[-keep_count:]
        old_messages = history[:-keep_count]
        
        if not old_messages:
            return history
        
        # Summarize all old messages
        try:
            summary_prompt = (
                "Summarize this conversation history into key points. "
                "Include: 1) What was being built, 2) Current status, 3) Any important decisions. "
                "Keep it under 150 tokens."
            )
            
            messages = [
                {"role": "system", "content": summary_prompt},
                {"role": "user", "content": "\n".join([f"{msg['role']}: {msg['content']}" for msg in old_messages])}
            ]
            
            response = await self.llm_client.chat(messages, response_model=str)
            summary = response if isinstance(response, str) else str(response)
            
            summary_msg = {
                "role": "system",
                "content": f"[Session Restore Summary]\n{summary}"
            }
            
            return [summary_msg] + recent_messages
            
        except Exception as e:
            logger.error(f"Failed to restore with summary: {e}")
            # Fallback: just keep recent
            return history[-keep_count:]

