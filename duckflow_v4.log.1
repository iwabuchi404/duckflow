from typing import Optional, Dict, Any
from datetime import datetime, timedelta
from companion.state.agent_state import AgentState
from companion.state.enums import AgentStatus
from companion.modules.sub_llm_manager import SubLLMManager


class Pacemaker:
    """
    D.U.C.K. Flowの心臓部。ループ制御と健全性チェックを行う。
    """
    def __init__(self, config: Dict[str, Any]):
        self.config = config
        self.base_interval = config.get("loop_interval", 0.5)
        self.loop_count = 0
        self.max_loops = 100  # デフォルト値
        self.health_check_interval = 5
        self.last_health_check = datetime.now()
        self.sub_llm_manager = SubLLMManager(config)

    def calculate_max_loops(self) -> int:
        """
        タスクの種類や状態に基づいて最大ループ回数を計算する。
        現在の実装では固定値を返す。
        """
        # TODO: タスク種類による動的計算ロジックを実装
        return self.config.get("max_loops", 100)

    def check_health(self) -> bool:
        """
        現在のループ回数が最大値に達していないか確認する。
        また、時間制限や状態異常もチェックする。
        """
        if self.loop_count >= self.max_loops:
            return False
        
        # 時間制限チェック
        if self._check_time_limit():
            return False
            
        # 状態異常チェック
        if self._check_state_anomaly():
            return False
            
        return True

    def _check_time_limit(self) -> bool:
        """時間制限をチェック"""
        if "max_execution_time" not in self.config:
            return False
        
        elapsed = (datetime.now() - self.start_time).seconds
        return elapsed > self.config["max_execution_time"]

    def _check_state_anomaly(self) -> bool:
        """状態異常をチェック"""
        # 現在の実装では未使用
        return False

    def adjust_interval(self, task_type: str, priority: int) -> float:
        """
        タスクの種類と優先度に応じてループ間隔を調整する。
        """
        base = self.base_interval
        
        if task_type == "urgent":
            return base * 0.5  # 高速化
        elif task_type == "batch":
            return base * 2.0  # 減速
        elif task_type == "analysis":
            return base * 1.5  # 減速
        
        return base

    def record_heartbeat(self) -> None:
        """健全性チェックのためのハートビートを記録"""
        now = datetime.now()
        if (now - self.last_health_check).seconds >= self.health_check_interval:
            self.last_health_check = now
            # ここに定期的な健全性チェックロジックを追加可能

    def should_sub_llm_process(self, context: Dict[str, Any]) -> bool:
        """
        現在の状況でSub-LLMの処理が必要か判断する。
        """
        return self.sub_llm_manager.should_process(context)


# モジュールレベルの設定
DEFAULT_PACEMAKER_CONFIG = {
    "loop_interval": 0.5,
    "max_loops": 100,
    "max_execution_time": 3600,  # 1時間
    "health_check_interval": 5,
}
