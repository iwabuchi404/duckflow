/**
 * ComponentManager - コンポーネントのライフサイクルを管理
 */

import { Component } from './Component';
import { Entity } from './Entity';

export class ComponentManager {
  private componentTypes: Map<string, any> = new Map();
  private componentInstances: Map<string, Component[]> = new Map();

  /**
   * コンポーネントタイプを登録
   */
  public registerComponentType<T extends Component>(
    name: string,
    componentClass: new (...args: any[]) => T
  ): void {
    if (this.componentTypes.has(name)) {
      console.warn(`[ComponentManager] Component type '${name}' is already registered`);
      return;
    }
    this.componentTypes.set(name, componentClass);
    console.log(`[ComponentManager] Component type '${name}' registered`);
  }

  /**
   * 登録されたコンポーネントタイプを取得
   */
  public getComponentType<T extends Component>(name: string): new (...args: any[]) => T | undefined {
    return this.componentTypes.get(name);
  }

  /**
   * コンポーネントをエンティティに追加
   */
  public addComponentToEntity<T extends Component>(
    entity: Entity,
    componentType: string,
    component: T
  ): void {
    entity.addComponent(componentType, component);

    // インスタンスを追跡
    if (!this.componentInstances.has(componentType)) {
      this.componentInstances.set(componentType, []);
    }
    this.componentInstances.get(componentType)!.push(component);

    // コンポーネントを初期化
    if (component.initialize) {
      component.initialize();
    }
  }

  /**
   * 特定のコンポーネントタイプを持つすべてのエンティティを取得
   */
  public getEntitiesWithComponent(
    entities: Entity[],
    componentType: string
  ): Entity[] {
    return entities.filter(entity => entity.hasComponent(componentType));
  }

  /**
   * すべてのコンポーネントインスタンスを取得
   */
  public getComponentInstances<T extends Component>(componentType: string): T[] {
    return (this.componentInstances.get(componentType) || []) as T[];
  }

  /**
   * コンポーネントをエンティティから削除
   */
  public removeComponentFromEntity(entity: Entity, componentType: string): void {
    entity.removeComponent(componentType);

    // インスタンスリストから削除
    const instances = this.componentInstances.get(componentType);
    if (instances) {
      const index = instances.findIndex(comp => {
        const entityComp = entity.getComponent(componentType);
        return comp === entityComp;
      });
      if (index !== -1) {
        instances.splice(index, 1);
      }
    }
  }

  /**
   * すべてのコンポーネントをクリーンアップ
   */
  public cleanup(): void {
    for (const components of this.componentInstances.values()) {
      for (const component of components) {
        if (component.cleanup) {
          component.cleanup();
        }
      }
    }
    this.componentInstances.clear();
    console.log('[ComponentManager] All components cleaned up');
  }

  /**
   * 登録されたコンポーネントタイプ数を取得
   */
  public getComponentTypeCount(): number {
    return this.componentTypes.size;
  }
}
