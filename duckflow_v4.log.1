logger = logging.getLogger(__name__)

class TaskTool:
    """
    タスク管理を担当するツール。
    Step を具体的な Task リストに分解・実行する。
    """
    def __init__(self, state: AgentState, llm: LLMClient):
        self.state = state
        self.llm = llm
    
    def generate_tasks(self, step_index: int = 0) -> str:
        """
        現在のステップから具体的なタスクリストを生成する。
        
        Args:
            step_index: タスクを生成するステップのインデックス（現在は未使用）
        
        Returns:
            タスク生成のメッセージ
        """
        if not self.state.active_step:
            return "アクティブなステップがありません"
        
        # 現在の実装では、LLMが直接 generate_tasks ツールを呼び出す際に
        # プロンプト内でタスクを生成するため、ここでは状態管理のみを行う
        
        # 実際にはLLMが生成したタスクリストを state.active_tasks に追加する必要がある
        # このツールはプレースホルダー的な役割
        
        logger.info(f"Tasks generated for step: {self.state.active_step.title}")
        return f"タスクを生成しました: {len(self.state.active_tasks)} 件"
    
    def mark_task_complete(self, task_index: int = 0) -> str:
        """
        指定したタスクを完了としてマークする。
        
        Args:
            task_index: 完了とするタスクのインデックス
        
        Returns:
            タスク完了のメッセージ
        """
        if 0 <= task_index < len(self.state.active_tasks):
            task = self.state.active_tasks[task_index]
            task.status = TaskStatus.consecutive_errors += 1
            self.state.vitals.confidence *= 0.9
            self.state.vitals.safety *= 0.9
        else:
            # 成功時
            self.consecutive_errors = 0
            self.state.vitals.confidence = min(1.0, self.state.vitals.confidence + 0.05)
            self.state.vitals.safety = min(1.0, self.state.vitals.safety + 0.02)
            self.state.vitals.memory += 0.01
        
        # Focus はアクションの種類に応じて調整
        if action and 'read' in action.name:
            self.state.vitals.focus = min(1.0, self.state.vitals.focus + 0.05)
        elif action and 'write' in action.name:
            self.state.vitals.focus = max(0.0, self.state.vitals.focus - 0.03)
    
    def reset(self):
        """ループカウンターとエラーカウンターをリセットする。"""
        self.loop_count = 0
        self.consecutive_errors = 0
        logger.info("Pacemaker counters reset")
    
    def intervene(self, intervention: ToolResult, summary: str = "") -> Action:
        """
        介入アクションを生成する。
        
        Args:
            intervention: 介入情報
            summary: 実行履歴のサマリー
        
        Returns:
            duck_call アクション
        """
        message = f"🦆 {intervention.message}\n"
        if summary:
            message += f"\n## 実行履歴\n{summary}\n"
        message += "\n続行するには指示してください。"
        
        return Action(
            name="duck_call",
            parameters={"message": message},
            thought="Pacemaker介入によりユーザーに相談が必要です"
        )
    
    def build_intervention_summary(self) -> str:
        """
        最近の実行履歴をサマリーとして構築する。
        """
        # 最近のアクション結果を取得
        # 現在の実装では conversation_history から抽出
        # 将来的には専用の実行履歴バッファを持つべき
        
        recent_messages = self.state.conversation_history[-6:]
        summary_lines = []
        for msg in recent_messages:
            role = msg.get("role", "unknown")
            content = msg.get("content", "")[:100]
            if role == "assistant":
                summary_lines.append(f"🤖 {content}")
            elif role == "user":
                summary_lines.append(f"👤 {content}")
        
        return "\n".join(summary_lines)
