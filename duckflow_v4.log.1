/**
 * ゲームシステムの基本インターフェース
 * すべてのゲームシステムはこのインターフェースを実装する必要があります
 */
export interface System {
    /**
     * システムの初期化処理
     * @param engine エンジンインスタンス
     */
    initialize(engine: Engine): Promise<void>;

    /**
     * システムの更新処理
     * @param deltaTime 前回更新からの経過時間（秒）
     */
    update(deltaTime: number): void;
}
