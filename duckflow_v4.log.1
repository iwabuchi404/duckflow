/**
 * EntitySystem - エンティティを管理するシステム
 * ECS フレームワークの中核
 */

import { BaseSystem } from '../systems/BaseSystem';
import { Entity } from './Entity';
import { Engine } from '../Engine';

export class EntitySystem extends BaseSystem {
  private entities: Map<string, Entity> = new Map();
  private entityIdCounter: number = 0;

  /**
   * システムの初期化
   */
  public async initialize(engine: Engine): Promise<void> {
    await super.initialize(engine);
    console.log('[EntitySystem] Initialized');
  }

  /**
   * 新しいエンティティを作成
   */
  public createEntity(customId?: string): Entity {
    const id = customId || `entity_${this.entityIdCounter++}`;
    
    if (this.entities.has(id)) {
      console.warn(`[EntitySystem] Entity with ID '${id}' already exists`);
      return this.entities.get(id)!;
    }

    const entity = new Entity(id);
    this.entities.set(id, entity);
    console.log(`[EntitySystem] Entity created: ${id}`);
    return entity;
  }

  /**
   * エンティティを取得
   */
  public getEntity(id: string): Entity | undefined {
    return this.entities.get(id);
  }

  /**
   * すべてのエンティティを取得
   */
  public getEntities(): Map<string, Entity> {
    return new Map(this.entities);
  }

  /**
   * アクティブなエンティティのみを取得
   */
  public getActiveEntities(): Entity[] {
    return Array.from(this.entities.values()).filter(entity => entity.getIsActive());
  }

  /**
   * エンティティを削除
   */
  public removeEntity(id: string): boolean {
    const result = this.entities.delete(id);
    if (result) {
      console.log(`[EntitySystem] Entity removed: ${id}`);
    }
    return result;
  }

  /**
   * 特定のコンポーネントを持つエンティティを検索
   */
  public getEntitiesByComponent(componentType: string): Entity[] {
    return Array.from(this.entities.values()).filter(
      entity => entity.hasComponent(componentType)
    );
  }

  /**
   * 複数のコンポーネントを持つエンティティを検索
   */
  public getEntitiesByComponents(...componentTypes: string[]): Entity[] {
    return Array.from(this.entities.values()).filter(entity =>
      componentTypes.every(componentType => entity.hasComponent(componentType))
    );
  }

  /**
   * すべてのエンティティをクリア
   */
  public clear(): void {
    this.entities.clear();
    this.entityIdCounter = 0;
    console.log('[EntitySystem] All entities cleared');
  }

  /**
   * フレーム更新（毎フレーム呼ばれる）
   */
  public update(deltaTime: number): void {
    // アクティブなエンティティのコンポーネントを更新
    for (const entity of this.getActiveEntities()) {
      const components = entity.getComponents();
      for (const component of components.values()) {
        if (component.update && typeof component.update === 'function') {
          component.update(deltaTime);
        }
      }
    }
  }

  /**
   * エンティティの総数を取得
   */
  public getEntityCount(): number {
    return this.entities.size;
  }
}
