/**
 * ComponentManager - コンポーネント生成と管理
 */

import { Component } from './Component';

export class ComponentManager {
  private componentFactories: Map<string, () => Component> = new Map();
  private componentInstances: Map<string, Component[]> = new Map();

  /**
   * コンポーネントファクトリを登録
   */
  public registerComponentFactory(
    componentType: string,
    factory: () => Component
  ): void {
    if (this.componentFactories.has(componentType)) {
      console.warn(`[ComponentManager] Factory for '${componentType}' already exists. Overwriting...`);
    }
    this.componentFactories.set(componentType, factory);
    console.log(`[ComponentManager] Component factory registered: ${componentType}`);
  }

  /**
   * コンポーネントを作成
   */
  public createComponent(componentType: string): Component | undefined {
    const factory = this.componentFactories.get(componentType);
    
    if (!factory) {
      console.error(`[ComponentManager] No factory found for component type: ${componentType}`);
      return undefined;
    }

    const component = factory();
    
    // インスタンスを追跡
    if (!this.componentInstances.has(componentType)) {
      this.componentInstances.set(componentType, []);
    }
    this.componentInstances.get(componentType)!.push(component);

    if (component.initialize) {
      component.initialize();
    }

    console.log(`[ComponentManager] Component created: ${componentType}`);
    return component;
  }

  /**
   * 特定の型のコンポーネントをすべて取得
   */
  public getComponentInstances(componentType: string): Component[] {
    return this.componentInstances.get(componentType) || [];
  }

  /**
   * すべてのコンポーネントインスタンスを取得
   */
  public getAllComponentInstances(): Map<string, Component[]> {
    return new Map(this.componentInstances);
  }

  /**
   * コンポーネントファクトリが登録されているか確認
   */
  public hasFactory(componentType: string): boolean {
    return this.componentFactories.has(componentType);
  }

  /**
   * 登録されているすべてのコンポーネント型を取得
   */
  public getRegisteredTypes(): string[] {
    return Array.from(this.componentFactories.keys());
  }

  /**
   * クリーンアップ処理
   */
  public cleanup(): void {
    this.componentFactories.clear();
    this.componentInstances.clear();
    console.log(`[ComponentManager] Cleaned up`);
  }

  /**
   * 統計情報を取得
   */
  public getStats(): { totalFactories: number; totalInstances: number } {
    let totalInstances = 0;
    for (const instances of this.componentInstances.values()) {
      totalInstances += instances.length;
    }
    return {
      totalFactories: this.componentFactories.size,
      totalInstances,
    };
  }
}
