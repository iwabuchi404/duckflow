content: import os
import logging
from typing import Optional, List, Dict, Any
from pathlib import Path

logger = logging.getLogger(__name__)

class FileOps:
    """
    ファイル操作を担当するクラス。
    ワークスペース外へのアクセスを防ぐ安全装置（The Duck Keeper）を内蔵。
    """
    
    def __init__(self, workspace_root: Optional[str] = None):
        """
        Args:
            workspace_root: ワークスペースのルートディレクトリ。
                           Noneの場合はカレントディレクトリを使用。
        """
        self.workspace_root = workspace_root or os.getcwd()
        logger.info(f"FileOps initialized with workspace: {self.workspace_root}")
    
    def _validate_path(self, path: str) -> str:
        """
        パスを検証し、ワークスペース内に収まっているか確認する。
        
        Args:
            path: 検証するパス
        
        Returns:
            検証済みの絶対パス
        
        Raises:
            ValueError: ワークスペース外のパスが指定された場合
        """
        # 絶対パスに変換
        abs_path = os.path.abspath(path)
        
        # ワークスペースルートを取得
        workspace_root = os.path.abspath(self.workspace_root)
        
        # ワークスペース外へのアクセスを禁止
        if not abs_path.startswith(workspace_root):
            raise ValueError(
                f"🦆 アクセス拒否: '{path}' はワークスペース外です。"
                f"ワークスペースルート: {workspace_root}"
            )
        
        return abs_path
    
    def read_file(self, path: str, start_line: int = 1, max_lines: int = 500) -> Dict[str, Any]:
        """
        ファイルを読み込む。ページネーション対応。
        
        Args:
            path: ファイルパス
            start_line: 開始行（1-indexed）
            max_lines: 読み込む最大行数
        
        Returns:
            Dict containing 'content', 'size_bytes', 'has_more' flag
        """
        try:
            abs_path = self._validate_path(path)
            logger.info(f"Reading file: {abs_path} (lines {start_line}-{start_line + max_lines - 1})")
            
            with open(abs_path, 'r', encoding='utf-8') as f:
                all_lines = f.readlines()
            
            total_lines = len(all_lines)
            requested_lines = all_lines[start_line - 1 : start_line - 1 + max_lines]
            content = ''.join(requested_lines)
            
            has_more = (start_line + max_lines - 1)効率的な読み込み
            size_bytes = len(content.encode('utf-8'))
            
            return {
                'content': content,
                'size_bytes': size_bytes,
                'has_more': has_more,
                'total_lines': total_lines
            }
        except FileNotFoundError:
            logger.error(f"File not found: {path}")
            return {'error': f'File not found: {path}'}
        except Exception as e:
            has_more: True
