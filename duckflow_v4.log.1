content: import os
import shutil
import glob
import logging
from typing import List, Optional, Dict
from pathlib import Path
from companion.tools.results import ToolResult, ToolStatus, format_symops_response
from companion.tools.approval import ApprovalTool

logger = logging.getLogger(__name__)

class FileOps:
    """
    File operations for Duckflow.
    All methods return a string (Sym-Ops formatted response) or raise an exception.
    """
    def __init__(self):
        self.approval_tool = ApprovalTool()  # Singleton

    def read_file(self, path: str, start_line: int = 1, max_lines: int = 500) -> str:
        """
        Read a file with pagination support (Sym-Ops v3.2).
        Returns a Sym-Ops formatted response string.
        """
        try:
            abs_path = Path(path).resolve()
            if not abs_path.exists():
                raise FileNotFoundError(f"File not found: {path}")

            if not abs_path.is_file():
                raise ValueError(f"Path is not a file: {path}")

            # Get total size
            size_bytes = abs_path.stat().st_size
            # Read the specific chunk
            with open(abs_path, 'r', encoding='utf-8', errors='ignore') as file:
                lines = file.readlines()
                # Adjust for 1-indexed start_line
                start_index = start_line - 1
                end_index = start_index + max_lines
                chunk = lines[start_index:end_index]
                content = ''.join(chunk)
                has_more = end_index < len(lines)

            # Format response
            result = ToolResult(
                status=ToolStatus.OK,
                tool_name="read_file",
                target=str(abs_path),
                content=content,
                metadata={
                    "size_bytes": size_bytes,
                    "start_line": start_line,
                    "max_lines": max500: True
                }
            )
            return format_symops_response(result)

        except Exception as e:
            result = ToolResult(
                status=ToolStatus.ERROR,
                tool_name="read_file",
                target=path,
                content=e
            )
            return format_symops_response(result)

    def write_file(self, path: str, content: str) -> str:
        """
        Write a file (Sym-Ops v3.2).
        Returns a Sym-Ops formatted response string.
        """
        try:
            abs_path = Path(path).resolve()
            # Ensure parent directory exists
            abs_path.parent.mkdir(parents=True, exist_ok=True)
            
            # Write file
            with open(abs_path, 'w', encoding='utf-8') as file:
                content = content.replace('\r\n', '\r')  # Normalize newlines
                file.write(content)

            # Format response
            result = ToolResult(
                status=Tool-Ops v3.2: `::s` (safety) is a required vitals metric. If `::s` < 0.5, system will pause and ask for user confirmation. Set `::s` low for dangerous operations (bulk deletions, overwrites, force pushes, unverified scripts).
            - Sym-Ops v3.2: `::c` (confidence), `::s` (safety), `::m` (memory), `::f` (focus) are vitals metrics.
            - Sym-Ops v3.2: `::health_check` is a special command.
            - Sym-Ops v3.2: `::note` for progress updates, `::response` for final responses.

**Sym-Ops v3.2 Format (Response ONLY):**
```
::response
<<<
## Result

The files have been created successfully.
- **path1.py** — Main module
- **path2.py** — Utility module
>>>
```

**Sym-Ops v3.2 Format (Actions):**
```
::c0.9 ::s1.0 ::m0.2 ::f0.9
::create_file @path1.py
<<<
def main():
    print("Hello")
>>>
```

**Sym-Ops v3.2 Format (Batch Execution):**
```
::c0.9 ::s1.0 ::m0.2 ::f0.9
::execute_batch
<<<
create_file @path1.py
def main():
    print("Hello")
%%%
create_file @path2.py
def helper():
    print("Helper")
%%%
run_command
python path1.py
>>>
```

**Sym-Ops v3.2 Format (Progress Notification):**
```
::note <<< 進捗メッセージ >>> 
```

**Sym-Ops v3.2 Format (Health Check):**
```
::health_check
```


### Response Format Instructions
- **Use Sym-Ops v3.2 format for all tool calls and responses.**
- **For final responses to user** (when no more actions needed), use `::response` with a clean Markdown block inside `<<< >>>` delimiters.
- **For tool calls** (when executing actions), use the Sym-Ops v3.2 action format.
- **For progress updates** (during execution), use `::note` blocks.
- **IMPORTANT**: Always use Sym-Ops v3.2 delimiters (`<<<`, `>>>`) for content blocks.
