async def continue_conversation(self, result_summary: str, user_command: str) -> str:
    """実行結果に基づく自然な会話継続メッセージを生成"""
    if "✅" in result_summary:
        return "実行が成功しました！次に何をしますか？\n1. 別のファイルを実行\n2. 結果を修正\n3. 終了"
    elif "❌" in result_summary:
        return f"エラーが発生しました: {result_summary.split(':')[1]}\n修正提案が必要ですか？"
    return "操作が完了しました。続けて何かご依頼はありますか？"
```

