import random
import datetime
from datetime import timedelta

def generate_logs():
    start_time = datetime.datetime(2024, 1, 1, 10, 0, 0)
    log_levels = ['INFO', 'WARNING', 'ERROR']
    
    log_messages = {
        'INFO': [
            'Application started successfully',
            'User logged in',
            'Data processed successfully',
            'Cache cleared',
            'Connection established',
            'Task completed',
            'Configuration loaded',
            'Service health check passed'
        ],
        'WARNING': [
            'High memory usage detected',
            'Slow response time',
            'Deprecated function used',
            'Connection timeout',
            'Disk space running low',
            'Rate limit approaching',
            'Certificate expiring soon',
            'Unusual activity detected'
        ],
        'ERROR': [
            'Failed to connect to database',
            'Authentication failed',
            'Invalid input data',
            'File not found',
            'Permission denied',
            'Service unavailable',
            'Database query failed',
            'Memory allocation failed'
        ]
    }
    
    with open('app.log', 'w') as f:
        current_time = start_time
        for i in range(50):
            level = random.choice(log_levels)
            message = random.choice(log_messages[level])
            log_line = f"{current_time.strftime('%Y-%m-%d %H:%M:%S')} [{level}] {message}"
            f.write(log_line + '\n')
            
            # Increment by random 1-5 minutes
            increment = random.randint(1, 5)
            current_time += timedelta(minutes=increment)

if __name__ == "__main__":
    generate_logs()
    print("Generated app.log with 50 log entries")
