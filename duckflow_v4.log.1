    async def action_response(self, **kwargs):
        """Send a final response to the user."""
        message = kwargs.get("message", "")
        if message:
            ui.print_response(message)
        return f"Response sent: {message}"

    async def action_finish(self, **response):
        """Mark the entire objective as accomplished."""
        result = response.get("result", "")
        if result:
            ui.print_finish(result)
        return f"Finish: {result}"

