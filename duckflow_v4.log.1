 189|             dry_run: Trueの場合、ファイルを変更せずプレビューのみ返す（デフォルト: True）
 190|         
 191|         Returns:
 192|             dry_run=True: 事前プレビュー（変更予定内容）
 193|             dry_run=False: 編集結果と事後検証プレビュー
 194|         """ 
 195|         full_path = self._get_full_path(path) 
 196|         if not full_path.exists(): 
 197|             raise FileNotFoundError(f"File not found: {path}")
 198|         
 199|         start, end = int(start), int(end)
 200|         if start < 1 or end < start: 
 201|             return f"Error: Invalid range {start}-{end}"
 202|         
 203|         with open(full_path, 'r', encoding='utf-8') as f:
 204|             lines = f.readlines()
 205|         
 206|         if start > len(lines):
 207|             return f"Error: start ({start}) exceeds file length ({len(lines)})"
 208|         
 209|         # Prepare new content
 210|         new_content_lines = [line + '\n' for line in content.split('\n')]
 211|         old_count = min(end, len(lines)) - start + 1
 212|         
 213|         # --- 事前プレビュー（Pre-edit Preview） ---
 214|         preview_start = max(1, start - 3)
 215|         preview_end = min(len(lines), end + 3)
 216|         
 217|         preview_lines = []
 218|         for i in range(preview_start, preview_end + 1):
 219|             prefix = "!!>" if start <= i <= end else "   "
 220|             line_content = lines[i-1].rstrip('\n')
 221|             preview_lines.append(f"{prefix} {i:4d}| {line_content}")
 222|         
 223|         pre_edit_preview = "\n".join(preview_lines)
 224|         warning_header = (
 225|             "編集後のプレビュー (Post-edit Preview) ---\n"
 226|             "⚠️ 注意: 行頭の ' N| ' (行番号) および '>>>' (変更箇所) は、ツールの表示用装飾です。\n"
 227|             "実際のファイルには含まれません。次順の edit_lines や write_file では、\n"
 228|             "これらの装飾を除去した【生データのみ】をコンテンツブロックに記述してください。\n"
 229|         )
 230|         
 231|         if dry_run:
 232|             # Dry run: show what would change without modifying file
 233|             return (
 234|                 f"[DRY RUN] No changes made to {path}\n"
 235|                 f"{pre_edit_preview}\n"
 236|                 f"--- Pre-edit Preview ({preview_start}-{preview_end}) ---\n"
 237|                 f"{pre_edit_preview}\n"
 238|                 f"--- Would replace lines {start}-{end} with ---\n"
 239|                 f"{content}\n"
 240|                 f"--- End of Dry Run ---\n"
