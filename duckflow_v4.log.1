# Register tools
tool_register = ToolRegister()

@tool_register.register("read_file")
@require_approval
def read_file(path: str, start_line: int = 1, max_lines: int = 500, **kwargs) -> ToolResult:
    """
    Read file content with line-based pagination.
    Sym-Ops v3.2: ::read_file @path start_line=1 max_lines=500
    """
    try:
        if not os.path.exists(path):
            return ToolResult(error=f"File not found: {path}")

        # Get total size
        total_size = os.path.getsize(path)
        with open(path, 'r', encoding='utf-8') as f:
            # Calculate line offsets for pagination
            # This is a simple implementation - could be optimized
            lines = f.readlines()
            start_index = start_line - 1
            end_index = start_index + max_lines
            content = ''.join(lines[start_index:end_index])
            has_more = end_index < len(lines)
            return ToolResult(
                data={
                    'content': content,
                    'size_bytes': total_size,
                    'has_more': has_more,
                    'start_line': start_line,
                    pagination_info=f"Lines {start_line}-{min(end_index, len(lines))} of {len(lines)} total lines, showing {max_lines} lines per chunk"
                },
                message=f"Read {len(content)} bytes from {path}"
            )
    except Exception as read_error:
        approval = require_approval("error", f"read_file error: {read_error}")
        return ToolResult(error=f"Error reading file: {1}")

