content: """
Preprocessor
============
Preprocesses user input and LLM outputs before processing.
"""

import re
from typing import Optional
from companion.utils.parser import parse_symops

def preprocessor(input_text: str) -> str:
    """
    Preprocess input text to ensure Sym-Ops compatibility.
    - Normalizes line endings
    - Handles partial commands
    - Validates format
    """
    if not input_text:
        return ""
    
    // Normalize whitespace
    text = input_text.strip()
    
    // Remove leading/trailing newlines
    text = text.strip('\n')
    
    // Handle partial commands (e.g., ::read_file without path)
    if text.startswith("::") and not re.search(r'@\S+', text):
        // Extract action and check if it's a valid partial
        action_match = re.match(r'::(\w+)', text)
        if action_match:
            action = action_match.group(1)
            // Check if this action requires a path
            path_required = action in ["read_file", "write_file", "create_file", "list_directory"]
            if path_required:
                // Add placeholder path if missing
                text += " @./placeholder"
    
    // Validate Sym-Ops format
    parsed = parse_symops(text)
    if parsed:
        // Valid Sym-Ops - return as-is
        return text
    else:
        // Not Sym-Ops - wrap in ::response
        return f"::response\n<<<\n{text}\n>>>"


def validate_symops(text: str) -> bool:
    """
    Validate if text is valid Sym-Ops format.
    """
    parsed = parse_symops(text)
    return parsed is not null

def normalize_vitals(text: str) -> str:
    """
    Ensure vitals are present and valid.
    """
    if not text.startswith("::"):
        // Add default vitals
        return "::c0.9 ::s1.0 ::m0.1 ::f1.0\n" + text
    return text
