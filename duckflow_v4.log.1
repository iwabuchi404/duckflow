                except Exception as e:
                    # --- Error Handling ---
                    error_msg = f"Error executing {action.name}: {str(e)}"
                    logger.error(error_msg, exc_info=True)
                    ui.print_result(error_msg, is_error=True)
                    
                    # Add error to history so LLM knows what happened
                    self.state.add_message("assistant", error_msg)
                    
                    # Update vitals (error)
                    self.pacemaker.update_vitals(action, error_msg, is_error=True)
                    
                    consecutive_errors += 1
                    if consecutive_errors >= MAX_CONSECUTIVE_ERRORS:
                        ui.print_error(
                            f"連続エラーが{MAX_CONSECUTIVE_ERRORS}回発生しました。"
