Plan Tool: 階層的プランニングの実装
"""
from typing import Dict, Any, List
from companion.state.agent_state import Plan, Step, PlanStatus
from companion.base.llm_client import LLMClient

class PlanTool:
    """Plan/Stepレベルの管理ツール"""
    
    def __init__(self, config: dict):
        self.config = config
        self.llm_client = LLMClient(config)
    
    def get_actions(self) -> List[str]:
        return ['propose_plan', 'mark_step_complete', 'finish_plan']
    
    def execute(self, action_name: str, params: Dict[str, Any], state) -> str:
        if action_name == 'propose_plan':
            return self._propose_plan(params, state)
        elif action_name == 'mark_step_complete':
            return self._mark_step_complete(params, state)
        elif action_name == 'finish_plan':
            return self._finish_plan(params, state)
        return f"[Error] Unknown action: {action_name}"
    
    def _propose_plan(self, params: Dict[str, Any], state) -> str:
        """計画を提案する"""
        goal = params.get('goal', '')
        if not goal:
            return "[Error] goal parameter is required"
        
        # Planを作成
        plan = Plan(
            id=1,
            goal=goal,
            status=PlanStatus.PROPOSED
        )
        
        # Stepを生成（LLMを使用）
        steps_data = self._generate_steps_with_llm(goal)
        for i, step_desc in enumerate(steps_data):
            plan.steps.append(Step(
                id=i+1,
                description=step_desc,
                status=PlanStatus.PROPOSED
            ))
        
        state.current_plan = plan
        return f"[Plan Created] Goal: {goal}, Steps: {len(plan.steps)}"
    
    def _generate_steps_with_llm(self, goal: str) -> List[str]:
        """LLMを使ってステップを生成する"""
        # 実装は省略...
        return ["Step 1", "Step 2"]
    
    def _mark_step_complete(self, params: Dict[str, Any], state) -> str:
        """現在のステップを完了としてマーク"""
        if state.current_step:
            state.current_step.status = PlanStatus.COMPLETED
            return "[Step Completed]"
        return "[Error] No active step"
    
    def _finish_plan(self, params: Dict[str, Any], state) -> str:
        """計画を完了としてマーク"""
        if state.current_plan:
            state.current_plan.status = PlanStatus.COMPLETED
            state.current_plan = None
            return "[Plan Completed]"
        return "[Error] No active plan"
