#!/usr/bin/env python3
"""
Diff Benchmark Tool v1.2
Compares directory outputs from code generation tools

Usage:
  diff_benchmark.py --baseline <dir> --candidate <dir>
  diff_benchmark.py (-h | --help)

Output Format:
{
  "status": "ok|error",
  "metrics": {
    "files": {"total": int, "different": int},
    "lines": {"added": int, "removed": int, "modified": int},
    "similarity": float  # 0.0-1.0 scale
  },
  "details": {
    "changed_files": [{"path": str, "lines_added": int, "lines_removed": int}]
  }
}

Exit Codes:
0 = Success
1 = Invalid arguments
2 = Directory access error
3 = Comparison error
"""

import difflib
import json
import os
import sys
from docopt import docopt
from pathlib import Path

def is_text_file(file_path):
    """Check if file is likely text-based (not binary)"""
    try:
        with open(file_path, 'r') as f:
            f.read(1024)
        return True
    except UnicodeDecodeError:
        return False
    except Exception:
        return False

def compare_files(file1, file2):
    """Compare two text files and return detailed metrics"""
    try:
        with open(file1, 'r') as f1, open(file2, 'r') as f2:
            lines1 = f1.readlines()
            lines2 = f2.readlines()
            
        diff = list(difflib.ndiff(lines1, lines2))
        added = sum(1 for line in diff if line.startswith('+ '))
        removed = sum(1 for line in diff if line.startswith('- '))
        modified = sum(1 for line in diff if line.startswith('? '))
        
        return {
            'added': added,
            'removed': removed,
            'modified': modified
        }
    except Exception as e:
        raise RuntimeError(f"File comparison failed: {str(e)}")

def compare_directories(baseline, candidate):
    """Compare all text files in two directories"""
    metrics = {
        "files": {"total": 0, "different": 0},
        "lines": {"added": 0, "removed": 0, "modified": 0},
        "similarity": 1.0
    }
    details = {"changed_files": []}
    
    # Find all text files in baseline
    baseline_files = []
    for root, _, files in os.walk(baseline):
        for file in files:
            path = Path(root) / file
            rel_path = str(path.relative_to(baseline))
            if is_text_file(path):
                baseline_files.append((path, rel_path))
    
    total_lines = 0
    for baseline_path, rel_path in baseline_files:
        candidate_path = Path(candidate) / rel_path
        if not candidate_path.exists():
            continue
            
        metrics["files"]["total"] += 1
        try:
            changes = compare_files(baseline_path, candidate_path)
            
            if changes['added'] > 0 or changes['removed'] > 0 or changes['modified'] > 0:
                metrics["files"]["different"] += 1
                details["changed_files"].append({
                    "path": rel_path,
                    "lines_added": changes['added'],
                    "lines_removed": changes['removed']
                })
            
            metrics["lines"]["added"] += changes['added']
            metrics["lines"]["removed"] += changes['removed']
            metrics["lines"]["modified"] += changes['modified']
            
            total_lines += max(len(open(baseline_path).readlines()), 
                              len(open(candidate_path).readlines()))
            
        except Exception as e:
            raise RuntimeError(f"Error comparing {rel_path}: {str(e)}")
    
    # Calculate similarity (0.0-1.0)
    if total_lines > 0:
        changed_lines = (metrics["lines"]["added"] + 
                        metrics["lines"]["removed"] + 
                        metrics["lines"]["modified"])
        metrics["similarity"] = max(0.0, 1.0 - (changed_lines / total_lines))
    
    return metrics, details

def main():
    args = docopt(__doc__)
    
    # Validate directories
    baseline = Path(args['--baseline'])
    candidate = Path(args['--candidate'])
    
    if not baseline.is_dir():
        print(json.dumps({"status": "error", "message": "Baseline directory not found"}))
        sys.exit(1)
    if not candidate.is_dir():
        print(json.dumps({"status": "error", "message": "Candidate directory not found"}))
        sys.exit(1)
    
    try:
        metrics, details = compare_directories(baseline, candidate)
        result = {
            "status": "ok",
            "metrics": metrics,
            "details": details
        }
        print(json.dumps(result, indent=2))
        sys.exit(0)
    except Exception as e:
        print(json.dumps({
            "status": "error", 
            "message": f"Comparison failed: {str(e)}"
        }))
        sys.exit(3)

if __name__ == "__main__":
    main()
