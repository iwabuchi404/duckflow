<<<
    async def edit_lines(self, path: str, start: int, end: int, content: str, original_text: Optional[str] = None) -> str:
        """
        [SAFE EDIT] 行番号ベースのファイル編集。
        事前確認(original_textとの照合)と、事後検証(前後5行の自動返却)を行う。
        """
        full_path = self._get_full_path(path)
        if not full_path.exists():
            raise FileNotFoundError(f"File not found: {path}")

        start = int(start)
        end = int(end)

        with open(full_path, 'r', encoding='utf-8') as f:
            lines = f.readlines()

        # --- 事前確認 (Pre-check) ---
        if original_text:
            actual_original = "".join(lines[start-1:end]).strip()
            expected_original = original_text.strip()
            if actual_original != expected_original:
                # 前後3行を含めたコンテキストを返して、LLMに行番号の再確認を促す
                error_context = self._get_numbered_context(lines, start, end, window=3)
                return (
                    f"Error: Original text mismatch at {path}:{start}-{end}.\n"
                    f"Expected: '{expected_original}'\n"
                    f"Actual content at those lines:\n{error_context}\n"
                    "Please re-read the file to confirm line numbers."
                )

        # --- 置換実行 (Apply) ---
        new_lines = content.split('\n')
        # 各行に改行を付与（最終行の空文字判定に注意）
        formatted_new_lines = [line + '\n' for line in new_lines]
        
        lines[start-1:end] = formatted_new_lines

        with open(full_path, 'w', encoding='utf-8') as f:
            f.writelines(lines)

        # --- 事後検証・コンテキスト返却 (Post-verify) ---
        # 編集箇所の前後5行を含めた最新の状態を生成
        new_total_lines = len(lines)
        context_start = max(1, start - 5)
        context_end = min(new_total_lines, start + len(formatted_new_lines) + 4)
        
        verification_context = self._get_numbered_context(lines, context_start, context_end)

        return (
            f"Successfully edited {path} (lines {start}-{end} replaced).\n"
            f"Review the updated context (lines {context_start}-{context_end}):\n"
            f"{verification_context}"
        )

    def _get_numbered_context(self, lines: List[str], start: int, end: int, window: int = 0) -> str:
        """行番号付きのテキストブロックを生成するヘルパー"""
        output = []
        for i in range(start, end + 1):
            if 1 <= i <= len(lines):
                output.append(f"{i:4d}| {lines[i-1].rstrip()}")
        return "\n".join(output)
