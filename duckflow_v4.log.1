"""
ResultSummarizer - 実行結果の高度な要約処理モジュール

このモジュールは、コマンド実行結果をユーザーに伝わりやすい形で要約する機能を提供します。
特にエラー発生時の自然言語説明と、成功時の意味のあるメッセージ生成を重視しています。

特徴:
- エラーパターンの自動検出と要約
- 成功時の結果の意味的解釈
- ユーザーへの提案を含む自然なフィードバック
"""

import re
from typing import Dict, Any, Optional

class ResultSummarizer:
    """実行結果を要約するクラス"""
    
    ERROR_PATTERNS = {
        "syntax_error": r"(SyntaxError|IndentationError)",
        "name_error": r"NameError",
        "key_error": r"KeyError",
        "file_not_found": r"(FileNotFoundError|No such file)",
        "permission_denied": r"PermissionError",
        "module_not_found": r"ModuleNotFoundError",
        "value_error": r"ValueError",
        "type_error": r"TypeError"
    }
    
    def __init__(self):
        self.error_handlers = {
            "syntax_error": self._handle_syntax_error,
            "name_error": self._handle_name_error,
            "key_error": self._handle_key_error,
            # 他エラーハンドラの初期化
        }
    
    def summarize(self, result: Dict[str, Any]) -> str:
        """
        実行結果を要約した自然言語メッセージを生成
        
        Args:
            result: 実行結果の辞書（stdout, stderr, returncode含む）
            
        Returns:
            要約されたメッセージ
        """
        if result["returncode"] == 0:
            return self._summarize_success(result)
        else:
            return self._summarize_error(result)
    
    def _summarize_success(self, result: Dict[str, Any]) -> str:
        """成功時の要約を生成"""
        stdout = result["stdout"].strip()
        
        # 結果が数値的な場合の特別処理
        if stdout.replace('.', '', 1).isdigit():
            return f"✅ 実行成功！計算結果: {stdout}"
            
        # 結果がJSONの場合
        if stdout.startswith('{') and stdout.endswith('}'):
            try:
                # JSONの主要キーを抽出
                import json
                data = json.loads(stdout)
                keys = ", ".join(list(data.keys())[:3])
                return f"✅ 処理成功！取得データ: {len(data)}件 (キー: {keys}...)"
            except:
                pass
                
        # 通常のテキスト出力
        if len(stdout) > 0:
            preview = stdout[:50] + "..." if len(stdout) > 50 else stdout
            return f"✅ 実行成功！出力内容: {preview}"
        else:
            return "✅ コマンドは正常に実行されましたが、出力はありませんでした"
    
    def _summarize_error(self, result: Dict[str, Any]) -> str:
        """エラー時の要約を生成"""
        stderr = result["stderr"].strip()
        
        # エラーパターンの検出
        for error_type, pattern in self.ERROR_PATTERNS.items():
            if re.search(pattern, stderr, re.IGNORECASE):
                handler = self.error_handlers.get(error_type)
                if handler:
                    return handler(stderr)
        
        # デフォルトのエラーメッセージ
        error_preview = stderr[:100] + "..." if len(stderr) > 100 else stderr
        return f"❌ 実行中にエラーが発生: {error_preview}\n修正提案が必要ですか？"
    
    # 各エラータイプのハンドラ実装
    def _handle_syntax_error(self, stderr: str) -> str:
        line_match = re.search(r"line (\d+)", stderr)
        line_num = f" {line_match.group(1)}行目" if line_match else ""
        return f"⚠️ 構文エラー{line_num}で実行できません。\nPythonの文法ルールを確認し、インデントや記号のミスがないかチェックしてください。"
    
    def _handle_name_error(self, stderr: str) -> str:
        var_match = re.search(r"name '(.+?)' is not defined", stderr)
        var_name = var_match.group(1) if var_match else "不明な変数"
        return f"⚠️ `{var_name}`が定義されていません。\n変数名のスペルミスや、定義前の使用がないか確認してください。"
    
    def _handle_key_error(self, stderr: str) -> str:
        key_match = re.search(r"KeyError: '(.+?)'", stderr)
        key_name = key_match.group(1) if key_match else "不明のキー"
        return f"⚠️ 辞書に`{key_name}`キーが存在しません。\nキーの存在確認またはデフォルト値の設定を検討してください。"

# グローバルインスタンス
summarizer = ResultSummarizer()
