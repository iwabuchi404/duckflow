from typing import List, Optional
from companion.state.agent_state import AgentState

logger = logging.getLogger(__name__)

class MemoryManager:
    """
    メモリ管理クラス。
    会話履歴のサイズを監視し、必要に応じて要約・削除を行います。
    """
    
    def __init__(self, llm_client, max_tokens: int = 8000):
        self.llm_client = llm_client
        self.max_tokens = max_tokens
    
    def should_prune(self, conversation_history: List[dict]) -> bool:
        """会話履歴がプルーニングの対象かどうかを判定します。"""
        # 簡易的なトークン数推定（日本語は1文字≈2トークン、英語は1単語≈1トークン）
        total_chars = sum(len(msg.get("content", "")) for msg in conversation_history)
        estimated_tokens = total_chars * 1.5  # 日本語を想定
        return estimated_tokens > self.max_tokens
    
    async def prune_history(self, conversation_history: List[dict]) -> List[dict]:
        """会話履歴を要約して圧縮します。"""
        if not conversation_history:
            return []
        
        # 古いメッセージを要約
        # 最新の10メッセージはそのまま残す
        keep_recent = 10
        if len(conversation_history) <= keep_recent:
            return conversation_history
        
        to_summarize = conversation_history[:-keep_recent]
        to_keep = conversation_history[-keep_recent:]
        
        # LLMに要約を依頼
        summary_prompt = (
            "以下の会話履歴を簡潔に要約してください。重要な情報を保持してください。\n\n"
            f"{self._format_messages(to_summarize)}"
        )
        
        try:
            summary = await self.llm_client.chat(
                [{"role": "user", "content": summary_prompt}]
            )
            
            # 要約を先頭に追加
            summary_msg = {"role": "system", "content": f"[会話要約] {summary}"}
            return [summary_msg] + to_keep
        except Exception as e:
            logger.error(f"Error pruning history: {e}")
            # エラー時は単純に古いメッセージを削除
            return to_keep
    
    def _format_messages(self, messages: List[dict]) -> str:
        """メッセージリストをフォーマットします。統合したツールクラス"""
        return "\n".join([f"{msg['role']}: {msg['content']}" for msg in messages])

