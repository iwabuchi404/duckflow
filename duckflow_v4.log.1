content: from __future__ import annotations
import logging
from datetime import datetime
from typing import Dict, List, Optional, Any, Literal
from enum import Enum
from pydantic import BaseModel, Field
import json

logger = logging.getLogger(__name__)

class Vitals(BaseModel):
    """エージェントのバイタル（状態）を表すモデル"""
    confidence: float = Field(default=1.0, ge=0.0, le=1.0, description="自信度")
    safety: float = Field(default=1.0, ge=0.0, le=1.0, description="安全性")
    memory: float = Field(default=0.5, ge=0.0, le=1.0, description="記憶使用率（高いほど満杯）")
    focus: float = Field(default=0.8, ge=0.0, le=1.0, description="集中力")

    def to_dict(self) -> Dict[str, float]:
        return {
            "confidence": self.confidence,
            "safety": self.safety,
            "memory": self.memory,
            "focus": self.focus,
        }

class AgentPhase(str, Enum):
    """エージェントの現在のフェーズ"""
    AWAITING_USER = "awaiting_user"
    THINKING = "thinking"
    EXECUTING = "executing"

class AgentMode(str, Enum):
    """エージェントの動作モード"""
    NORMAL = "normal"
    INVESTIGATION = "investigation"
    PLANNING = "planning"

class TaskStatus(str, Enum):
    """タスクの状態"""
    PENDING = "pending"
    IN_PROGRESS = "in_progress"
    COMPLETED = "completed"
    BLOCKED = "blocked"
    FAILED = "failed"

class Plan(BaseModel):
    """長期目標を表すモデル"""
    goal: str
    steps: List[str] = Field(default_factory=list)
    created_at: datetime = Field(default_factory=datetime.now)

class Step(BaseModel):
    """中期目標を表すモデル"""
    title: str
    description: str = ""
    tasks: List[str] = Field(default_factory=list)
    status: TaskStatus = TaskStatus.PENDING
    created_at: datetime = Field(default_factory=datetime.now)

class Task(BaseModel):
    """短期作業を表すモデル"""
    description: str
    status: TaskStatus = TaskStatus.PENDING
    created_at: datetime = Field(default_factory=datetime.now)

class Action(BaseModel):
    """実行可能なアクションを表すモデル"""
    name: str
    parameters: Dict[str, Any] = Field(default_factory=dict)
    thought: str = ""

class ActionList(BaseModel):
    """LLMが出力するアクションリスト"""
    reasoning: str = ""
    actions: List[Action] = Field(default_factory=list)
    vitals: Optional[Dict[str, float]] = None

class AgentState(BaseModel):
    """
    エージェントの全状態を管理するSingle Source of Truth。
    全てのモジュールはこの状態を参照・更新する。
    """
    # 基本情報
    phase: AgentPhase = AgentPhase.AWAITING_USER
    mode: AgentMode = AgentMode.NORMAL
    vitals: Vitals = Field(default_factory=Vitals)
    
    # 会話履歴
    conversation_history: List[Dict[str, str]] = Field(default_factory=list)
    
    # 計画階層
    active_plan: Optional[Plan] = None
    active_step: Optional[Step] = None
    active_tasks: List[Task] = Field(default_factory=list)
    
    # 最後の実行結果
    last_action_result: str = ""
    
    # メタデータ
    created_at: datetime = Field(default_factory=datetime.now)
    updated_at: datetime = Field(default_factory=datetime.now)
    
    # 設定
    max_history_length: int = 100  # この数を超えると要約を検討

    class Config:
        arbitrary_types_allowed = True

    def to_prompt_context(self) -> str:
        """
        LLMプロンプト用に現在の状態を文字列化する。
        """
        parts = []
        
        # 現在のモード
        parts.append(f"# Current State")
        parts.append(f"Phase: {self.phase.value}")
        parts.append(f"Mode: {self.mode.value}")
        parts.append("")
        
        # Vitals
        parts.append(f"# Vitals")
        parts.append(f"Confidence: {self.vitals.confidence:.2f}")
        parts.append(f"Safety: {self.vitals.safety:.2f}")
        parts.append(f"Memory: {self.vitals.memory:.2f}")
        has_more: True
