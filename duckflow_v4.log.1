    async def action_note_(self, **kwargs):
        """
        Sym-Ops v3.2: プログレス通知（継続実行）
        ループを継続しつつ、ユーザーに進捗を表示する。
        """
        message = kwargs.get("message", "")
        if message:
            ui.print_info(f"[NOTE] {message}")
        # Do NOT add to conversation history to avoid token bloat
        return "Notified"

    async def action_response(self, **kwargs):
        """
        Sym-Ops v3.2: ユーザーへの最終報告（ループ終了）
        ループを終了し、ユーザーに結果を表示する。
        """
        message = kwargs.get("message", "")
        if message:
            # Add to conversation history
            self.state.add_message("assistant", message)
            ui.print_response(message)
        return "Response sent"

    async def action_finish(self, **kwargs):
        """
        Sym-Ops v3.2: タスク完了（ループ終了）
        ループを終了し、完了メッセージを表示する。
        """
        result = kwargs.get("result", "Task completed.")
        ui.print_finish(result)
        self.state.add_message("assistant", f"Task finished: {result}")
        return "Finished"

    async def action_exit(self, **kwargs):
        """
        Exit the agent loop and cleanup.
        """
        self.running = False
        ui.print_info("Exiting agent...")
        
        # Save session if manager exists
        if self.session_manager is not None:
            self.state.touch()
            self.session_manager.save(self.state)
            ui.print_info("Session saved.")

        return "Exited"

    async def action_run_command(self, **kwargs):
        """
        Run a shell command with mandatory user approval.
        """
        command = kwargs.get("command", "")
        if not command:
            return "No command provided."
        
        # Approval Check
        ui.print_warning(f"Attempting to run shell command: {command}")
        if not ui.request_confirmation("Do you want to execute this command?"):
            return "Command execution denied by user."
        
        shell_tool = ShellTool()
        try:
            result = await shell_tool.run(command)
            return result
        except Exception as e:
            return f"Command execution failed: {str(e)}"

    async def action_execute_tasks(self, **kwargs):
        """
        Execute tasks in the current step.
        """
        if not self.state.plan or not self.state.plan.current_step:
            return "No active plan or step."
        
        ui.print_info(f"Executing tasks for step: {self.state.plan.current_step.title}")
        
        # Execute tasks
        results = []
        for task in self.state.plan.current_step.tasks:
            if task.status == TaskStatus.PENDING:
                # Execute task
                ui.print_info(f"Executing task: {task.description}")
                task_result = await self.task_tool.execute_task(task)
                results.append(task_result)
                # Mark as complete
                task.status = TaskStatus.COMPLETED
        
        # Update plan state
        self.state.plan.update_progress()
        
        # Summarize execution results
        summary = "\n".join([f"- {r}" for r in results])
        return f"Tasks executed:\n{summary}"

    async def action_investigate(self, **kwargs):
        """
        Sym-Ops v3.1: Investigation Mode
        Switch to investigation mode to debug unknown errors.
        """
        reason = kwargs.get("reason", "Unknown issue")
        self.state.mode = AgentMode.INVESTIGATION
        self.state.investigation_context = {"reason": reason, "hypotheses": []}
        
        ui.print_info(f"🔍 Entering Investigation Mode: {reason}")
        return "Investigation mode started."

    async def action_submit_hypothesis(self, **kwargs):
        """
        Sym-Ops v3.1: Submit Hypothesis
        Record a hypothesis during investigation.
        """
        hypothesis = kwargs.get("hypothesis", "")
        if not hypothesis:
            return "No hypothesis provided."
        
        if self.state.mode != AgentMode.INVESTIGATION:
            return "Not in investigation mode."
        
        self.state.investigation_context["hypotheses"].append(hypothesis)
        ui.print_info(f"Hypothesis submitted: {hypothesis}")
        return "Hypothesis recorded."

    async def action_finish_investigation(self, **kwargs):
        """
        Sym-Ops v3.1: Finish Investigation
        Conclude investigation and return to planning mode.
        """
        conclusion = kwargs.get("conclusion", "")
        if self.state.mode != AgentMode.INVESTIGATION:
            return "Not in investigation mode."
        
        self.state.mode = AgentMode.PLANNING
        ui.print_info(f"Investigation concluded: {conclusion}")
        self.state.add_message("assistant", f"Investigation result: {conclusion}")
        return "Investigation finished."

    async def action_execute_batch(self, **kwargs):
        """
        Sym-Ops v3.1 Fast Path: Batch Execution
        Execute multiple independent actions sequentially.
        """
        # The actual content is passed in the content block of the Sym-Ops message
        # We need to parse it from the raw message, but the tool interface doesn't support that.
        # This is a fallback implementation for when execute_batch is called directly.
        # The main parser handles the batch expansion.
        return "Batch execution handler (use Sym-Ops parser for actual batch execution)"

    def get_vitals(self):
        """Return current vitals string."""
        return self.state.vitals.to_string()
