                    # Execute the tool and handle the result
                    # Tool execution result should be Sym-Ops formatted
                    # We need to parse it and extract the actual result
                    
                    # For now, we'll assume the tool returns a string
                    # which may be in Sym-Ops format or plain text
                    
                    # If the tool returns a dict (like read_file), convert to text
                    if isinstance(result, dict):
                        result_text = serialize_to_text(result)
                    else:
                        result_text = result
                    
                    # Log the result
                    logger.debug(f"Tool {action.name} result: {result_text[:200]}...")
                    
                    # --- Add result to conversation history ---
                    # This allows the LLM to see what happened
                    result_context = (
                        f"[Tool: {action.name} executed successfully] "
                        f"Parameters: {action.parameters} "
                        f"Result: {result_text}"
                    )
                    self.state.add_message("assistant", result_context)
                    
                    # --- Pacemaker Update ---
                    self.pacemaker.update_vitals(action, result_text, is_error=False)
                    
                    # --- Result Summary ---
                    # If this is a file read or project tree, we might want to summarize
                    # to avoid overwhelming the context window
                    if action.name in ["read_file", "get_project_tree"] and len(result_text) > 2000:
                        logger.info(f"Large result ({len(result_text)} chars) being summarized")
                        # We'll let the LLM decide if it needs to summarize
                        # But we can add a note to the context
                        large_result_note = (
                            f"[Note: Result is large ({len(result_text)} chars). "
                            f"Consider using summarize_context tool if needed.]"
                        )
                        self.state.add_message("assistant", large_result_note)
                    
                    # --- Save large results to file ---
