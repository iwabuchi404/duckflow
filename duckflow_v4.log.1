   1| """
   2| Pacemaker - Controls the agent's execution pace and prevents infinite loops.
   3| """
   4| 
   5| import logging
   6| from typing import Dict, Optional
   7| 
   8| from companion.state.agent_state import AgentState
   9| 
  10| 
  11| class Pacemaker:
  12|     """Controls execution pacing based on vitals and task complexity."""
  13| 
  14|     def __init__(self):
  15|         self.logger = logging.getLogger("pacemaker")
  16|         self.loop_count = 0
  17|         self.consecutive_errors = 0
  18|         self.max_consecutive_errors = 3
  19| 
  20|     def should_continue(self, state: AgentState) -> bool:
  21|         """
  22|         Determine if the agent should continue executing actions.
  23| 
  24|         Returns:
  25|             bool: True if execution should continue, False if it should stop.
  26|         """
  27|         self.loop_count += 1
  28| 
  29|         # Check basic limits
  30|         if self.loop_count > self._calculate_max_loops(state):
  31|             self.logger.warning(f"Loop limit reached: {self.loop_count}")
  32|             return False
  33| 
  34|         # Check safety threshold
  35|         if state.vitals.safety < 0.3:
  36|             self.logger.warning(f"Safety too low: {state.vitals.safety}")
  37|             return False
  38| 
  39|         # Check for consecutive errors
  40|         if self.consecutive_errors >= self.max_consecutive_errors:
  41|             self.logger.warning(
  42|                 f"Too many consecutive errors: {self.consecutive_errors}"
  43|             )
  44|             return False
  45| 
  46|         return True
  47| 
  48|     def _calculate_max_loops(self, state: AgentState) -> int:
  49|         """Calculate maximum loops based on task complexity and vitals."""
  50|         base_loops = 10
  51| 
  52|         # Adjust based on task count
  53|         if state.current_tasks:
  54|             task_count = len(state.current_tasks)
  55|             additional_loops = min(task_count // 2, 25)  # Max 25 extra loops
  56|             base_loops = 15 + additional_loops
  57| 
  58|         # Adjust based on vitals
  59|         vitals_factor = (state.vitals.confidence + state.vitals.safety) / 2
  60|         adjustment = 1.0
  61|         if vitals_factor > 0.8:
  62|             adjustment = 1.2
  63|         elif vitals_factor < 0.5:
  64|             adjustment = 0.8
  65| 
  66|         max_loops = int(base_loops * adjustment)
  67|         self.logger.debug(f"Max loops calculated: {max_loops}")
  68|         return max_loops
  69| 
  70|     def record_error(self):
  71|         """Record an execution error."""
  72|         self.consecutive_errors += 1
  73|         self.logger.debug(f"Consecutive errors: {self.consecutive_errors}")
  74| 
  75|     def reset_error_count(self):
  76|         """Reset consecutive error count."""
  77|         self.consecutive_errors = 0
  78|         self.logger.debug("Error count reset")
  79| 
  80|     def reset_loop_count(self):
  81|         """Reset loop counter (e.g., when starting new task)."""
  82|         self.loop_count = 0
  83|         self.logger.debug("Loop count reset")
  84| 
  85|     def get_stats(self) -> Dict:
  86|         """Get current pacing statistics."""
  87|         return {
  88|             "loop_count": self.loop_count,
  89|             "consecutive_errors": self.consecutive_errors,
  90|             "max_consecutive_errors": self.max_consecutive_errors,
