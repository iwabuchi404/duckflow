def summarize_execution(result: dict) -> str:
    if result["returncode"] != 0:
        error = result["stderr"].split("\n")[0]
        return f"⚠️ エラー: {error[:50]}..."
    
    output_lines = result["stdout"].strip().split("\n")
    if not output_lines or output_lines == [""]:
