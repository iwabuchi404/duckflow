   5| class SymOpsParser:
   6|     """
   7|     Sym-Ops v3.2 プロトコルの解析を行うクラス。
   8|     """
   9|     
  10|     # アクションパターンの正規表現
  11|     ACTION_PATTERN = re.compile(r'^::(\w+)(?:\s+@([\w\./-]+))?(?:\s+(.*))?$', re.MULTILINE)
  12|     CONTENT_BLOCK_PATTERN = re.compile(r'<<<([\s\S]*?)^>>>', re.MULTILINE)
  13|     VITALS_PATTERN = re.compile(r'::c([\d\.]+)\s+::s([\d\.]+)\s+::m([\d\.]+)\s+::f([\d\.]+)')
  14|     
  15|     @classmethod
  16|     def parse_vitals(cls, text: str) -> Dict[str, float]:
  17|         """バイタル情報を抽出する"""
  18|         match = cls.VITALS_PATTERN.search(text)
  19|         if match:
  20|             return {
  21|                 "confidence": float(match.group(1)),
  22|                 "safety": float(match.group(2)),
  23|                 "memory": float(match.group(3)),
  24|                 "focus": float(match.group(4))
  25|             }
  26|         return {}
  27| 
  28|     @classmethod
  29|     def parse_actions(cls, text: str) -> List[Dict[str, Any]]:
  30|         """テキストからアクションのリストを抽出する"""
  31|         actions = []
  32|         
  33|         # まず、execute_batch ブロックを探す
  34|         if "::execute_batch" in text:
  35|             return cls._parse_batch_actions(text)
  36| 
  37|         # 単一のアクションを解析
