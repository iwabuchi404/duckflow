    async def action_execute_tasks(self, **kwargs):
        """Execute all tasks in the current step."""
        try:
            # Get current step
            step = self.state.plan.get_current_step()
            if not step:
                return {"status": ToolStatus.ERROR, "result": "No active step found", "vitals": None}
            
            # Execute tasks
            results = await self.task_executor.execute_tasks(step.tasks)
            
            # Update task statuses
            for task_index, result in enumerate(results):
                if task_index < len(step.tasks):
                    step.tasks[task_index].status = TaskStatus.COMPLETED if result.success else TaskStatus.FAILED
            
            # Return results
            result_str = "\n".join([f"Task {i+1}: {r.message}" for i, r in enumerate(results)])
            return {"status": ToolStatus.OK, "result": result_str, "vitals": None}
        except Exception as e:
            return {"status": ToolStatus.ERROR, "result": str(e), "vitals": None}

