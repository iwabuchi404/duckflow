/**
 * ComponentManager - コンポーネントを一元管理
 * コンポーネントの作成、キャッシング、再利用を管理
 */

import { Component } from './Component';

export class ComponentManager {
  private componentPool: Map<string, Component[]> = new Map();
  private componentFactories: Map<string, () => Component> = new Map();

  /**
   * コンポーネントファクトリを登録
   */
  public registerComponentFactory(
    componentType: string,
    factory: () => Component
  ): void {
    this.componentFactories.set(componentType, factory);
    console.log(`[ComponentManager] Factory registered for '${componentType}'`);
  }

  /**
   * コンポーネントを作成
   */
  public createComponent(componentType: string): Component | null {
    const factory = this.componentFactories.get(componentType);
    if (!factory) {
      console.warn(`[ComponentManager] No factory found for component type '${componentType}'`);
      return null;
    }

    const component = factory();
    console.log(`[ComponentManager] Component created: ${componentType}`);
    return component;
  }

  /**
   * コンポーネントをプールに返す（再利用のため）
   */
  public returnComponentToPool(componentType: string, component: Component): void {
    if (!this.componentPool.has(componentType)) {
      this.componentPool.set(componentType, []);
    }
    this.componentPool.get(componentType)!.push(component);
  }

  /**
   * プールからコンポーネントを取得
   */
  public getComponentFromPool(componentType: string): Component | null {
    const pool = this.componentPool.get(componentType);
    if (pool && pool.length > 0) {
      return pool.pop()!;
    }
    return null;
  }

  /**
   * プールの状態を確認
   */
  public getPoolStatus(): { [key: string]: number } {
    const status: { [key: string]: number } = {};
    for (const [type, components] of this.componentPool) {
      status[type] = components.length;
    }
    return status;
  }

  /**
   * すべてのプールをクリア
   */
  public clearPools(): void {
    this.componentPool.clear();
    console.log('[ComponentManager] All pools cleared');
  }

  /**
   * ファクトリをクリア
   */
  public clearFactories(): void {
    this.componentFactories.clear();
    console.log('[ComponentManager] All factories cleared');
  }

  /**
   * 完全にリセット
   */
  public reset(): void {
    this.clearPools();
    this.clearFactories();
    console.log('[ComponentManager] Reset complete');
  }
}
