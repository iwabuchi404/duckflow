                    self.state.add_message("assistant", error_msg)
                    results.append(error_msg)
            else:
                ui.print_warning(f"Unknown tool in batch: {action.name}")
                results.append(f"Unknown tool: {action.name}")
        
        // Pacemaker update
        self.pacemaker.update_vitals(None, f"Batch executed {len(actions)} actions", is_error=False)
        
        return ToolResult(status=ToolStatus.OK, output=f"Batch completed: {len(actions)} actions")

