  10| class TaskTool:
  11|     """
  12|     Generates and manages atomic tasks within a plan step.
  13|     Uses LLM to break down steps into actionable tasks.
  14|     """
  15|     
  15|     def __init__(
  16|         self,
  17|         state: AgentState,
  18|         llm: LLMClient
  19|     ):
  20|         self.state = state
  21|         self.llm = llm
