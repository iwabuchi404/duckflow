content: """
State Management for Duckflow v4
"""
from typing import List, Dict, Any, Optional
from pydantic import BaseModel, Field
from datetime import datetime
from enum import Enum

class Vitals(BaseModel):
    """エージェントの生存状態"""
    confidence: float = Field(default=0.8, ge=0.0, le=1.0)
    safety: float = Field(default=0.8, ge=0.0, le=1.0)
    memory: float = Field(default=0.5, ge=0.0, le=1.0)
    focus: float = Field(default=0.8, ge=0.0, le=1.0)
    stamina: float = Field(default=0.9, ge=0.0, le=1.0)
    mood: float = Field(default=0.7, ge=0.0, le=1.0)

    def update(self, data: Dict[str, float]):
        """Vitalsを更新する"""
        for key, value in data.items():
            if hasattr(self, key):
                setattr(self, key, value)

class PlanStatus(str, Enum):
    """計画の状態"""
    PROPOSED = "proposed"
    ACTIVE = "active"
    COMPLETED = "completed"
    FAILED = "failed"

class TaskStatus(str, Enum):
    """タスクの状態"""
    PENDING = "pending"
    IN_PROGRESS = "in_progress"
    COMPLETED = "completed"
    FAILED = "failed"
    SKIPPED = "skipped"

class Task(BaseModel):
    """最小単位の作業"""
    id: int
    description: str
    status: TaskStatus = TaskStatus.PENDING
    dependencies: List[int] = Field(default_factory=list)
    created_at: datetime = Field(default_factory=datetime.now)

class Step(BaseModel):
    """中期目標（Planの一部）"""
    id: int
    description: str
    status: PlanStatus = PlanStatus.PROPOSED
    tasks: List[Task] = Field(default_factory=list)
    created_at: datetime = Field(default=datetime.now)

class Plan(BaseModel):
    """長期目標"""
    id: int
    goal: str
    status: PlanStatus = PlanStatus.PROPOSED
    steps: List[Step] = Field(default_factory=list)
    created_at: datetime = Field(default_factory=datetime.now)

class AgentState(BaseModel):
    """エージェントの状態（Single Source of Truth）"""
    # Vitals
    vitals: Vitals = Field(default_factory=Vitals)
    
    # Planning
    current_plan: Optional[Plan] = None
    current_step: Optional[Step] = Safetyチェック
    current_task: Optional[Task] = None
    
    # Conversation History
    messages: List[Dict[str,入力]]
    working_memory: Dict[str, Any] = Field(default_factory=dict)
    
    # Execution State
    loop_count: int = 0
    last_error: Optional[str] = None
    last_action_result: Optional[str] = None
    
    def add_message(self, role: str, content: str):
        """メッセージを履歴に追加"""
        self.messages.append({
            "role": role,
            "content": content,
            "timestamp": datetime.now().isoformat()
        })
    
    def add_system_message(self, content: str):
        """システムメッセージを追加"""
        self.add_message("system", content)
    
    def get_context_for_llm(self) -> str:
        """LLM用コンテキストを構築"""
        context_parts = []
        for msg in self.messages[-10:]:  # 直近10件
            context_parts.append(f"{msg['role']}: {msg['content']}")
        return "\n".join(context_parts)
