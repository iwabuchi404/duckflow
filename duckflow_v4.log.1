        Returns:
            Maximum number of autonomous loops before requiring user input.
        """
        # Base calculation
        if self.state.current_plan and self.state.current_plan.get_current_step():
            current_step = self.state.current_plan.get_current_step()
            pending_tasks = [t for t in current_step.tasks if t.status == TaskStatus.PENDING]
            task_count = len(pending_tasks)
            
            if task_count > 0:
                # With tasks: base + task_count / 2
                base = self.BASE_MAX_LOOPS_WITH_TASKS
                additional = task_count // 2
