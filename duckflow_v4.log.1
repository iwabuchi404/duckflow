import sys
import os

# Add the current directory to the Python path
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from companion.core import Duckflow
from companion.utils.parser import parse_args

def main():
    """
    Duckflow CLI Entry Point
    
    Usage:
        python main.py [command] [options]
    
    Examples:
        python main.py --plan "Create a Python script"
        python main.py --task "Fix the bug in utils.py"
        python main.py --health_check
    """
    args = parse_args()
    
    if not args:
        return
    
    duck = Duckflow()
    duck.run(args)

if __name__ == "__main__":
    main()
