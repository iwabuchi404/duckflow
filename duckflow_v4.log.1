      console.log(`[EntitySystem] Entity '${id}' removed`);
    }
    return result;
  }

  /**
   * 特定のコンポーネントを持つエンティティを取得
   */
  public getEntitiesByComponent(componentType: string): Entity[] {
    return this.getActiveEntities().filter(e => e.hasComponent(componentType));
  }

  /**
   * すべてのエンティティをクリア
   */
  public clearEntities(): void {
    this.entities.clear();
    this.entityCount = 0;
    console.log(`[EntitySystem] All entities cleared`);
  }

  /**
   * システムの更新
   */
  public update(deltaTime: number): void {
    // アクティブなエンティティのコンポーネントを更新
    for (const entity of this.getActiveEntities()) {
      for (const [, component] of entity.getComponents()) {
        if (component.update) {
          component.update(deltaTime);
        }
      }
    }
  }

  /**
   * エンティティ数を取得
   */
  public getEntityCount(): number {
    return this.entities.size;
  }
}
