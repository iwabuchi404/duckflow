from typing import Optional, List, Dict, Any
from companion.state.agent_state import AgentState, Vitals, AgentPhase
from companion.tools.results import ToolStatus, ToolResult
from datetime import datetime

logger = logging.getLogger(__name__)

class DuckPacemaker:
    """
    エージェントのループ制御とヘルスチェックを担当する「心拍装置」。
    暴走や無限ループを防止し、適切なタイミングでユーザーに介入（Duck Call）を促す。
    """
    
    def __init__(self, state: AgentState):
        self.state = state
        self.loop_count: int = 0
        self.max_loops: int = 10
        self.consecutive_errors: int = 0
        self.intervention_history: List[Dict[str, Any]] = []
    
    def calculate_max_loops(self) -> int:
        """
        現在の状況に基づいて最大ループ回数を計算する。
        
        Returns:
            最大ループ回数
        """
        # 基本ループ数
        base_loops = 10
        if self.state.active_tasks:
            base_loops = 15 + len(self.state.active_tasks) // 2
        
        # Vitals補正
        vitals_factor = (self.state.vitals.confidence + self.state.vitals.safety) / 2
        if vitals_factor < 0.5:
            vitals_factor = 0.5
        elif vitals_factor > 1.2:
            vitals_factor = 1.2
        
        max_loops = int(base_loops * vitals_factor)
        
        # 上限
        MAX_LOOPS = 35
        if max_loops > MAX_LOOPS:
            max_loops = MAX_LOOPS
        
        logger.info(f"Max loops calculated: {max_loops} (base: {base_loops}, factor: {vitals_factor:.2f})")
        return max_loops
    
    def check_health(self) -> Optional[ToolResult]:
        """
        エージェントの健康状態をチェックし、必要に応じて介入を返す。
        
        Returns:
            介入が必要な場合は ToolResult、そうでなければ None
        duck_call アクションを生成するための ToolResult を返す
        """
        # 1. ループ上限チェック
        if self.loop_count >= self.max_loops:
            return ToolResult(
                status=ToolStatus.INTERVENTION,
                name="loop_limit_reached",
                message=f"ループ上限 ({self.max_loops}回) に達しました。",
                severity="high"
            )
        
        # 2. Safety スコアチェック
        if self.state.vitals.safety < 0.3:
            return ToolResult(
                status=ToolStatus.INTERVENTION,
                name="low_safety",
                message=f"Safety スコアが低すぎます: {self.state.vitals.safety:.2f}",
                severity="high"
            )
        
        check_health(self) -> Optional[ToolResult]:
        """
        エージェントの健康状態をチェックし、必要に応じて介入を返す。
        
        Returns:
            介入が必要な場合は ToolResult、そうでなければ None
