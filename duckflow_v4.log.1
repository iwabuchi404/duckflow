"""
from typing import Dict, Any, List
from companion.state.agent_state import Task, TaskStatus
from companion.base.llm_client import LLMClient

class TaskTool:
    """Taskレベルの管理ツール"""
    
    def __init__(self, config: dict):
        self.config = config
        self.llm_client = LLMClient(config)
    
    def get_actions(self) -> List[str]:
        return ['generate_tasks', 'mark_task_complete', 'execute_tasks']
    
    def execute(self, action_name: str, params: Dict[str, Any], state) -> str:
        if action_name == 'generate_tasks':
            return self._generate_tasks(params, state)
        elif action_name == 'mark_task_complete':
            return self._mark_task_complete(params, state)
        elif action_name == 'execute_tasks':
            return self._execute_tasks(params, state)
        return f"[Error] Unknown action: {action_name}"
    
    def _generate_tasks(self, params: Dict[str, Any], state) -> str:
        """現在のステップからタスクを生成する"""
        if not state.current_step:
            return "[Error] No active step"
        
        # タスクを生成（LLMを使用）
        tasks_data = self._generate_tasks_with_llm(state.current_step.description)
        for i, task_desc in enumerate(tasks_data):
            state.current_step.tasks.append(Task(
                id=i+1,
                description=task_desc,
                status=TaskStatus.PENDING
            ))
        
        return f"[Tasks Generated] {len(tasks_data)} tasks"
    
    _generate_tasks_with_llm(self, step_desc: str) -> List[str]:
        """LLMを使ってタスクを生成する"""
        # 実装は省略...
        return ["Task 1", "Task 2"]
    
    def _mark_task_complete(self, props: Dict[str, Any], state) -> str:
        """タスクを完了としてマーク"""
        task_id = params.get('task_id')
        if state.current_step:
            for task in state.current_step.tasks:
                if task.id == task_id:
                    task.status = TaskStatus.COMPLETED
                    return f"[Task {task_id} Completed]"
        return f"[Error] Task {task_id} not found"
    
    def _execute_tasks(self, params: Dict[str, Any], state) -> str:
        """タスクを一括実行する"""
        # 実装は省略...
        return "[Tasks Executed]"
