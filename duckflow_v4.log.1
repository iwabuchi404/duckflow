    """
    ファイル操作ツール群。
    ワークスペース外へのアクセスを防ぐため、FileProtectorで保護されています。
    """
    
    def __func__(self, workspace_path: str):
        self.workspace_path = Path(workspace_path).resolve()
        self.protector = FileProtector(self.workspace_path)
    
    def __init__(self, workspace_path: str):
        self.workspace_path = Path(workspace_path).resolve()
        self.protector = FileProtector(self.workspace_path)
    
    def read_file(self, path: str, start_line: int = 1, max_lines: int = 500) -> ToolResult:
        """Read file content with line-based pagination."""
        try:
            # Validate path
            full_path = self.protector.resolve_path(path)
            if full_path is None:
                return ToolResult(status=ToolStatus.ERROR, message=f"Path '{path}' is outside workspace or invalid.")
            
            if not full_path.exists():
                return ToolResult(status=ToolStatus.ERROR, message=f"File '{path}' does not exist.")
            
            # Read with pagination
            with open(full_path, 'r', encoding='utf-8') as f:
                lines = f.readlines()
            
            total_lines = len(lines)
            # Return requested range
            selected_lines = lines[start_line-1 : start_line-1 + max_lines]
            content = ''.join(selected_lines)
            
            has_more = (start_line - 1 + max_lines) < total_lines
            size_bytes = full_path.stat().st_size
            
            # Format result as Sym-Ops response
            result_text = (
                f"::result ok\n"
                f"::tool read_file\n"
                f"::target {path}\n"
                f"(file content here)"
            )
            
            return ToolResult(
                status=ToolStatus.SUCCESS,
                message=result_text,
                details={
                    "size_bytes": size_bytes,
                    "has_more": has_more,
                    "total_lines": total_lines,
                    "content": content
                }
            )
        except Exception as e:
            logger.error(f"Error reading file: {e}")
            return ToolResult(status=ToolStatus.ERROR, message=str(e))
    
