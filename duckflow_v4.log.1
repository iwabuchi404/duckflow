    async def _build_context(self) -> Dict[str, Any]:
        """
        Build the context dictionary for the LLM call.
        Includes vitals, phase, and formatted conversation history.
        """
        context = {
            "vitals": self.state.vitals,
            "self": {
                "phase": self.state.phase.value,
                "mode": self.state.mode.value,
                "task": self.state.task,
                "actions_taken": len(self.state.actions_taken),
            },
            "conversation_history": self.state.conversation_history,
        }
        return context

    async def _execute_tools(self, tool_calls):
        """
        Execute a list of tool calls.
        """
        for tool_call in tool_calls:
            tool_name = tool_call.name
            tool_args = tool_call.arguments
            tool_result = None
            
            try:
                if tool_name in self.tools:
                    logger.debug(f"Executing tool: {tool_name} with args: {tool_args}")
                    tool_func = self.tools[tool_name]
                    
                    # Check if it's an async function
                    import inspect
                    if inspect.iscoroutinefunction(tool_func):
                        tool_result = await tool_func(**tool_args)
                    else:
                        # Synchronous function - run in executor
                        loop = asyncio.get_event_loop()
                        tool_result = await loop.run_in_executor(None, tool_func, **tool_args)
                else:
                    logger.error(f"Tool not found: {tool_name}")
                    tool_result = ToolResult(
                        status=ToolStatus.ERROR,
                        output=f"Tool not found: {tool_name}"
                    )
            except Exception as e:
                logger.error(f"Error executing tool {tool_name}: {e}")
                logger.exception(e)
                tool_result = ToolResult(
                    status=ToolStatus.ERROR,
                    output=f"Error: {e}"
                )
            
            # Add result to state
            await self.state.add_tool_result(
                tool_name,
                tool_result
            )

    def action_note(self, message: str) -> str:
        """Action handler for ::note."""
        ui.print_note(message)
        return f"Note: {message}"

    def action_response(self, message: str) -> str:
        """Action handler for ::response."""
        ui.print_assistant(message)
        return f"Response: {message}"

    def action_report(self, message: `str) -> str:
        """Action handler for ::report."""
        ui.print_assistant(message)
        return f"Report: {message}"

    def action_finish(self, result: str) -> str:
        """Action handler for ::finish."""
        ui.print_success(f"✅ {result}")
        return f"Finished: {result}"

    def action_exit(self) -> str:
        """Action handler for ::exit."""
        self.running = False
        ui.print_info("Goodbye!")
        return "Exit"

    def action_investigate(self, reason: str = '') -> str:
        """Action handler for ::investigate."""
        logger.info(f"Entering investigation mode: {reason}")
        return "Investigation mode enabled"

    def action_submit_hypothesis(self, hypothesis: str) -> str:
        """Action run_command handler for ::submit_hypothesis."""
        logger.info(f"Submitting hypothesis: {hypothesis}")
        return "Hypothesis submitted"

    def action_finish_investigation(self, conclusion: `str) -> str:
        """Action handler for ::finish_investigation."""
        logger.info(f"Investigation concluded: {conclusion}")
        return "Investigation concluded"

    def action_execute_batch(self, **kwargs) -> str:
        """Action handler for Sym-Ops v3.1 Fast Path."""
        from companion.modules.command_handler import CommandHandler
        
        handler = CommandHandler(self)
        return handler.execute_batch(kwargs)

    def _noop(self) -> str:
        """No-op action for status messages."""
        return "ok"

    def register_tool(self, name: str, func: Callable):
        """Register a tool function available to the agent."""
        self.tools[name] = func

    async def switch_model(self, provider: str, model: str) -> bool:
        """
        Switch to a different LLM model and persist the change.
        
        Args:
            self.llm: 使用するLLMクライアント
            debug_context_mode: デバッグ用コンテキスト出力モード（"console" | "file"）
            session_manager: セッション保存を担当するマネージャー（Noneなら保存しない）
            resume_state: 前回セッションから復元した AgentState（Noneなら新規）
        """
        from companion.config.config_loader import config
        
        try:
            logger.info(f"🔄 Attempting to switch model to {provider}/{model}")
            
            # Test if the new model configuration is valid by reinitializing
            success = self.llm.reinitialize(provider=provider, model=model)
            
            if not success:
                logger.error("Failed to reinitialize LLM call client")
                return False
            
            # Test the connection
            connection_ok = await self.llm.test_connection()
            if not connection_ok:
                logger.error("Connection test failed for new model")
                return False
            
            # Update components that depend on LLM
            logger.info("Updating dependent components...")
            
            # Update TaskTool
            self.task_tool.llm = self.llm
            
            # Update ResultSummarizer
            self.result_summarizer.llm = self.llm
            
            # Update MemoryManager
            self.memory_manager.llm_client = self.llm
            
            # Persist to config file
            logger.info("Persisting configuration to duckflow.yaml...")
            config.update_config("llm.provider", provider)
            config.update_config(f"llm.{provider}.model", model)
            
            logger.info(f"✅ Successfully switched to {provider}/{model}")
            return True
            
        except Exception as e:
            logger.error(f"❌ Error switching model: {e}")
            return False

    def get_tool_descriptions(self) -> str:
        """Generate tool descriptions for the system prompt (Sym-Ops v3.2)."""
        descriptions = []
        import inspect
        for name, func in self.tools.items():
            # Get cleaned docstring
            doc = inspect.getdoc(func) or "No description available."
            
            # Get signature
            try:
                sig = inspect.signature(func)
            except ValueError:
                sig = "(...)"
            
            descriptions.append(f"### {name}{sig}\n{doc}")
        
        return "\n\n".join(descriptions)

    async def run(self):
        """Main execution loop."""
        self.running = True

        # 復元セッションのサイズが大きい場合はLLM要約で圧縮する
        if (
            self.session_manager is not None
            and len(self.state.conversation_history) > 0
            and self.memory_manager.should_prune(self.state.conversation_history)
        ):
            logger.info("Session restore: applying restore_with_summary...")
            self.state.conversation_history = await self.memory_manager.restore_with_summary(
                self.state.conversation_history
            )
            logger.info(
                f"Session restore complete: {len(self.state.conversation_history)} messages retained"
            )

        ui.print_welcome()
        
        # セッション復元時に過去の会話を表示（最新5回分）
        if self.state.conversation_history:
            history_to_show = self.state.conversation_history[-10:]  # 5ターン = User/AI ペアで10件程度
            if history_to_show:
                ui.print_info("\n📜 過去の会話履歴を復元します:")
                for msg in history_to_show:
                    role = msg.get("role", "unknown")
                    content = msg.get("content", "")
                    if role in ["user", "assistant"]:
                        ui.print_conversation_message(content, speaker=role)
                ui.print_separator()
        
