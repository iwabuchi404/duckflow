/**
 * ComponentManager - コンポーネントの作成と管理
 */

import { Component } from './Component';
import { Entity } from './Entity';

export class ComponentManager {
  private componentFactories: Map<string, () => Component> = new Map();

  /**
   * コンポーネントファクトリーを登録
   */
  public registerComponentFactory(
    componentType: string,
    factory: () => Component
  ): void {
    if (this.componentFactories.has(componentType)) {
      console.warn(`[ComponentManager] Factory for '${componentType}' already registered`);
      return;
    }
    this.componentFactories.set(componentType, factory);
    console.log(`[ComponentManager] Component factory registered: ${componentType}`);
  }

  /**
   * コンポーネントを作成
   */
  public createComponent(componentType: string): Component | undefined {
    const factory = this.componentFactories.get(componentType);
    if (!factory) {
      console.warn(`[ComponentManager] No factory found for component type: ${componentType}`);
      return undefined;
    }

    const component = factory();
    if (component.initialize) {
      component.initialize();
    }
    return component;
  }

  /**
   * エンティティにコンポーネントを追加
   */
  public addComponentToEntity(
    entity: Entity,
    componentType: string
  ): boolean {
    const component = this.createComponent(componentType);
    if (!component) return false;

    entity.addComponent(componentType, component);
    return true;
  }

  /**
   * エンティティからコンポーネントを削除
   */
  public removeComponentFromEntity(
    entity: Entity,
    componentType: string
  ): boolean {
    const component = entity.getComponent(componentType);
    if (!component) return false;

    if (component.cleanup) {
      component.cleanup();
    }

    return entity.removeComponent(componentType);
  }

  /**
   * すべてのコンポーネントファクトリーをクリア
   */
  public clearFactories(): void {
    this.componentFactories.clear();
    console.log('[ComponentManager] All component factories cleared');
  }
}
