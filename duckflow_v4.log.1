import logging
import uuid

from companion.state.agent_state import AgentState, Plan, AgentMode

logger = logging.getLogger(__name__)

class PlanTool:
    """
    計画管理ツール。
    Plan -> Step -> Task の階層構造でタスクを管理する。
    """
    def __init__(self, state: AgentState):
        self.state = state

    def propose_plan(self, goal: str) -> str:
        """
        新しい計画を作成する
        Args:
            goal: 計画の目標
        Returns:
            作成成功メッセージ
        propose_plan
        >>> plan_tool.propose_plan("Create a web scraper")
        "Plan created with 1 steps."
        """
        # LLMからの応答を期待（Sym-Opsプロトコル）
        # 実際の計画内容は LLM が生成する
        # ここでは状態遷移だけを行う
        self.state.mode = AgentMode.PLANNING
        self.state.plan = Plan(
            id=str(uuid.uuid4()),
            goal=goal,
            steps=[]  # LLMが生成する
        )
        logger.info(f"Plan created: {goal}")
        return f"✅ Plan created with 1 steps."

    def mark_step_complete(self) -> str:
        """
        現在のステップを完了としてマークし、次に進む
        Returns:
            ステップ完了メッセージ
        """
        if not self.state.plan:
            return "⚠️  No active plan to complete step for."

        if self.state.plan.advance():
            step_idx = self.state.plan.current_step_index - 1
            logger.info(f"Step {step_idx} completed, moving to step {step_idx + 1}")
            return f"✅ Step {step_idx} completed, now on step {step_idx + 1}."
        else:
            # 全ステップ完了
            logger.info("All steps completed")
            self.state.mode = AgentMode.NORMAL
            self.state.plan = None
            return "✅ All steps completed."

    def generate_tasks(self) -> str:
        """
        現在のステップに対してタスクを生成する
        Returns:
            タスク生成メッセージ
        """
        if not self.state.plan:
            by_="No active plan to generate tasks for."
            return "⚠️  No active plan to generate tasks for."

        step_idx = self.state.plan.current_step_index
        if step_idx >= len(self.state.plan.steps):
            return "⚠️  Current step index out of range."

        # タスクはLLMが生成する
        # ここでは状態遷移だけ
        logger.info(f"Generating tasks for step {step_idx}")
        return f"✅ Tasks generated for step {step_idx}."

    def mark_task_complete(self, task_index: int = 0) -> str:
        """
        指定したタスクを完了としてマークする
        Args:
            task_index: 完了とするタスクのインデックス
        Returns:
            タスク完了メッセージ
        """
        if task_index >= len(self.state.tasks):
            return "Ⳇ Task index out of range."

        task = self.state.tasks[task_index]
        task.status = TaskStatus.COMPLETED
        task.completed_at = datetime.now()
        logger.info(f"Task {task_index} completed: {task.description}")
        return f"✅ Structured report for investigation results, code analysis, or task completion."
