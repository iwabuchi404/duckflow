                    # --- Fail-safe: Large Result Truncation ---
                    # 結果が大きすぎる場合、LLMのコンテキスト圧迫を防ぐため表示のみで truncation する
                    # ログには全文保存するが、会話履歴には圧縮版を保存する
                    max_display_length = 15000  # ~3000 tokens
                    max_history_length = 4000   # ~800 tokens
                    display_content = str(result)
                    history_content = str(result)
                    
                    if len(display_content) > max_display_length:
                        truncated = display_content[:max_display_length]
                        warning = f"\n... [Result truncated for display: {len(display_content)} chars -> {max_display_length} chars] ..."
                        display_content = truncated + warning
                        logger.warning(f"Result truncated for display: {action.name}")
                    
                    if len(history_content) > max_history_length:
                        # Use summarize_context if available
                        if hasattr(result, 'content') and result.content:
                            summary = await self.sub_llm_tools.summarize_context(result.content)
                            history_content = f"[Original Length: {len(result.content)} chars]\n{summary}"
                        else:
                            history_content = history_content[:max_history_length] + f"\n... [Truncated for history: {len(history_content)} chars -> {max_history_length} chars] ..."
                        logger.warning(f"Result truncated for history: {action.name}")
                    
                    # Display result
                    ui.print_result(display_content, is_error=False)
                    
                    # Add to conversation history
                    self.state.add_message("assistant", f"Result of '{action.name}':\n{history_content}")
                    
                    # Update Pacemaker vitals
                    self.pacemaker.update_vitals(action, result, is_error=False)
                    
                    # Update State
                    self.state.last_action_result = str(result)
                    
                    # Reset error counter on success
                    consecutive_errors = 0
                    
                    results.append(result)
                    
                except Exception as e:
                    error_message = f"Error executing {action.name}: {str(e)}"
                    logger.error(error_message, exc_info=True)
                    ui.print_result(error_message, is_error=True)
                    
                    # Add to conversation history
                    self.state.add_message("assistant", f"Error executing '{action.name}': {str(e)}")
                    
                    # Update Pacemaker vitals
                    self.pacemaker.update_vitals(action, error_message, is_error=True)
                    
                    # Update State
                    self.state.last_action_result = error_message
                    
                    # --- Fail-fast Logic ---
                    consecutive_errors += 1
                    if consecutive_errors >= MAX_CONSECUTIVE_ERRORS:
                        ui.print_error(
                            f"連続エラーが{MAX_CONSECUTIVE_ERRORS}回発生しました。"
