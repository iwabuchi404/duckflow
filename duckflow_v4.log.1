import { System } from './systems/BaseSystem';

/**
 * Engine - ゲームエンジンのシングルトン
 * 全てのシステムを管理し、ゲームループを制御します
 */
export class Engine {
  private static instance: Engine;
  private systems: Map<string, System> = new Map();
  private gameLoopId: number | null = null;
  private isRunning: boolean = false;
  private deltaTime: number = 0;
  private lastFrameTime: number = 0;

  private constructor() {}

  /**
   * Engineのシングルトンインスタンスを取得
   */
  static getInstance(): Engine {
    if (!Engine.instance) {
      Engine.instance = new Engine();
    }
    return Engine.instance;
  }

  /**
   * システムを登録
   */
  registerSystem(name: string, system: System): void {
    if (this.systems.has(name)) {
      console.warn(`System "${name}" is already registered`);
      return;
    }
    this.systems.set(name, system);
    console.log(`System "${name}" registered`);
  }

  /**
   * システムを取得
   */
  getSystem<T extends System>(name: string): T | undefined {
    return this.systems.get(name) as T | undefined;
  }

  /**
   * 全システムを初期化
   */
  async initialize(): Promise<void> {
    console.log('Initializing engine...');
    for (const [name, system] of this.systems) {
      console.log(`Initializing system: ${name}`);
      await system.initialize(this);
    }
    console.log('Engine initialized successfully');
  }

  /**
   * ゲームループを開始
   */
  start(): void {
    if (this.isRunning) {
      console.warn('Engine is already running');
      return;
    }

    this.isRunning = true;
    this.lastFrameTime = performance.now();
    this.gameLoop();
    console.log('Game loop started');
  }

  /**
   * ゲームループ
   */
  private gameLoop(): void {
    const currentTime = performance.now();
    this.deltaTime = (currentTime - this.lastFrameTime) / 1000;
    this.lastFrameTime = currentTime;

    // 全システムを更新
    for (const [name, system] of this.systems) {
      try {
        system.update(this.deltaTime);
      } catch (error) {
        console.error(`Error updating system "${name}":`, error);
      }
    }

    if (this.isRunning) {
      this.gameLoopId = requestAnimationFrame(() => this.gameLoop());
    }
  }

  /**
   * ゲームループを停止
   */
  stop(): void {
    this.isRunning = false;
    if (this.gameLoopId !== null) {
      cancelAnimationFrame(this.gameLoopId);
    }
    console.log('Game loop stopped');
  }
}
