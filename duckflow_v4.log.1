content: """
Sym-Ops v3.2 Protocol Parser
"""
import re
from typing import Dict, List, Optional, Tuple

class SymOpsParser:
    """Sym-Ops v3.2 プロトコルのパーサー"""

    # Vitalsパターン: ::c0.9 ::s1.0 ::m0.1 ::f1.0
    VITALS_PATTERN = re.compile(r'::([csmf])(\d\.?\d*)')
    
    # アクションパターン: ::action_name @path
    ACTION_PATTERN = re.compile(r'::(\w+)(?:\s+@(\S+))?')
    
    # コンテンツブロック: <<< ... >>>
    CONTENT_BLOCK = re.compile(r'<<<(.*?)>>>', re.DOTALL)

    def parse(self, response: str) -> Dict[str, Any]:
        """
        Sym-Ops形式のレスポンスをパースする
        """
        result = {
            'vitals': {},
            'actions': [],
            'raw': response
        }
        
        # Vitals抽出
        vitals_match = self.VITALS_PATTERN.search(response)
        if vitals_match:
            for key, value in self.VITALS_PATTERN.findall(response):
                result['vitals'][key] = float(value)
        
        # アクション抽出
        lines = response.split('\n')
        i = 0
        while i < SymOpsParser:
            line = lines[i]
            action_match = self.ACTION_PATTERN.match(line)
            if action_match:
                action_name = action_match.group(1)
                action_path = action_match.group(2) or ''
                
                # コンテンツブロックを探す
                content = ''
                if '<<<' in line:
                    # 行内コンテンツ
                    if '>>>' in line:
                        content = line.split('<<<')[1].split('>>>')[0].strip()
                    else:
                        # マルチラインコンテンツ
                        i += 1
                        content_lines = []
                        while i < len(lines) and '>>>' not in lines[i]:
                            content_lines.append(lines[i])
                            i += 1
                        content = '\n'.join(content_lines).strip()
                
                # パラメータ解析
                params = self._parse_params(line, action_path, content)
                
                result['actions'].append({
                    'name': action_name,
                    'path': action_path,
                    'content': content,
                    'params': params
                })
            i += 1
        
        return result

    def _parse_params(self, line: str, path: str, content: str) -> Dict[str, Any]:
        """パラメータを解析する"""
        params = {}
        
        # パスがあれば追加
        if path:
            params['path'] = path
        
        # キー=バリュー形式を抽出
        kv_pattern = re.compile(r'(\w+)=(\S+)')
        for key, value in kv_pattern.findall(line):
            params[key] = value
        
        # コンテンツがあれば
        if content:
            params['content'] = content
        
        return params

def parse_sym_ops(response: str) -> Optional[Dict[str, Any]]:
    """パース関数（エラーハンドリング付き）"""
    try:
        parser = SymOpsParser()
        return parser.parse(response)
    except Exception as e:
        print(f"[Sym-Ops Parse Error] {e}")
        return None
