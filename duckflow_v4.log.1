    async def _handle_code_execution(self, command: str) -> str:
        """
        コード実行コマンドの処理
        Phase 1.6 実装中
        """
        try:
            # コマンド解析
            cmd_type, target = self._parse_execution_command(command)
            
            if cmd_type == "python":
                result = await self.execution_runner.run_python_file(target)
                summary = ResultSummarizer.summarize_python_execution(result)
                
                # 対話継続の提案を追加（開発中）
                continuation = generate_conversation_continuation(result)
                if continuation:
                    summary += f"\n\n{continuation}"
                
                return summary
            
            elif cmd_type == "command":
                result = await self.execution_runner.run_command(target)
                return self._format_command_result(result)
                
            return "❌ サポートされていない実行コマンドです。"
            
        except Exception as e:
            logger.error(f"コード実行処理でエラー: {str(e)}")
            return f"⚠️ 実行処理中に内部エラーが発生しました: {str(e)}"

    def _parse_execution_command(self, command: str) -> tuple:
        """実行コマンドの解析"""
        command = command.lower().strip()
        
        if "python" in command and ".py" in command:
            # ファイル名の抽出（簡易版）
            match = re.search(r'([a-zA-Z0-9_\-]+\.py)', command)
            if match:
                return "python", match.group(1)
        
        if any(cmd in command for cmd in ["run ", "execute ", "sh ", "bash "]):
            return "command", command.split(maxsplit=1)[1]
            
        raise ValueError("実行コマンドが認識できません")

    async def _format_command_result(self, result: dict) -> str:
        """コマンド実行結果のフォーマット"""
        if result['returncode'] == 0:
            output = result['stdout'].strip()
            return f"✅ コマンド実行成功:\n{output[:200]}{'...' if len(output) > 200 else ''}"
        else:
            error = result['stderr'].strip()
            return f"❌ コマンド実行失敗 (コード {result['returncode']}):\n{error[:150]}"

    # --- 対話管理 ---
    async def continue_conversation(self, last_response: str, user_input: str) -> str:
        """
        対話の文脈を考慮した応答生成
        （Phase 1.6 Step 2 対応中）
        """
        # 現在の実装では固定メッセージを返す（開発中）
        if "実行" in user_input and "成功" in last_response:
            return "実行結果が確認できました！次に何を試してみますか？"
        return None

    # --- メインループ ---
    async def run(self):
        """メイン対話ループ"""
        while True:
            try:
                user_input = await self.io_handler.get_input()
                if not user_input:
                    continue
                    
                # 各処理ステップ
                await self._update_state(user_input)
                response = await self._generate_response()
                
                # 対話継続の検討
                continuation = await self.continue_conversation(response, user_input)
                if continuation:
                    response += f"\n\n{continuation}"
                
                await self.io_handler.send_response(response)
                
            except KeyboardInterrupt:
                await self.io_handler.send_response("\n終了します...")
                break
