    async def _execute_single_action(self, action: Action) -> score:
        """Execute a single action and return the result."""
        tool_func = self.tools[action.name]
        
        # Handle parameters - support both dict and content block extraction
        params = action.parameters.copy()
        
        # Extract content block if present (for write_file, run_command, etc.)
        if 'content' in params and isinstance(params['content'], str):
            # Check if it contains <<< and >>>
            if '<<<' in params['content'] and '>>>' in params['content']:
                # Extract content between delimiters
                content_block = params['content']
                start = content_block.find('<<<') + 3
                end = content_block.rfind('>>>')
                if end > start:
                    params['content'] = content_block[start:end].strip()
        
        # Call the tool function
        result = tool_func(**params)
        
        # Handle async tools
        if asyncio.iscoroutine(result):
            result = await result
        
        # Serialize result to text for conversation history
        return serialize_to_text(action.name, result)

