from typing import Optional

from companion.modules.sub_llm_manager import SubLLMManager

logger = logging.getLogger(__name__)

class SubLLMTools:
    """
    Sub-LLMを使用したツール群。
    """
    
    def __init__(self, sub_llm_manager: SubLLMManager):
        self.sub_llm = sub_llm_manager
    
    def analyze_structure(self, path: str) -> str:
        """
        Generate a structural outline (Code Map) of a file.
        Includes classes, functions, and their signatures without bodies.
        
        Args:
            path: Path to the target source file.
        
        Returns:
            Formatted outline of the file structure.
        """
        from companion.tools.file_ops import file_ops
        from companion.utils.preprocessor import Preprocessor
        
        try:
            # Read file
            result = file_ops.read_file(path)
            if result.get('error'):
                return f"Error reading file: {result['error']}"
            
            content = result['content']
            
            # Use Preprocessor to extract structure
            prep = Preprocessor()
            structure = prep.extract_structure(content)
            
            # Format as readable outline
            lines = []
            for item in structure:
                if item['type'] == 'class':
                    lines.append(f"class {item['name']}")
                    for method in item['methods']:
                        lines.append(f"  + {method['name']}{method['signature']}")
                elif item['type'] == 'function':
                    lines.append(f"def {item['name']}{item['signature']}")
            
            return "\n".join(lines)
        except Exception as-LLM call failed: {e}")
            return f"Error analyzing structure: {e}"
    
    def summarize_context(self, content: str) -> str:
        """
        Summarize long text or conversation logs into a concise bullet-point format.
        Use this to manage context window consumption.
        
        Args:
            content: Text to summarize.
        
        Returns:
            Concise summary in bullet points.
        """
        try:
            summary = self.sub_llm.call_sub_llm(
                task_type="summarize",
                input_data={"content": content}
            )
            return summary
        except Exception as e:
            logger.error(f"Sub-LLM call failed: {e}")
            return f"Error summarizing: {e}"
    
    def generate_code(self, path: str, content: str) -> str:
        """
        Generate code using a specialized Sub-LLM worker.
        Returns a Sym-Ops formatted response summary without code body.
        
        **Main LLM Usage Guide:**
        - Purpose: Generate code based on instructions and context.
        - Usage:
          1. Gather necessary context (e.g., `read_file` on related files).
          2. `generate_code` with `[Instruction]` and `[Context]` sections.
          3. The tool handles saving. **You will NOT receive the generated code content back.**
          4. You will receive a status summary (Success/Fail/Line count).
          5. If you need to verify the saved content, use `read_file` afterwards.
        
        **Constraints:**
        - This tool requires user confirmation. Do NOT use inside `execute_batch`.
        - Ensure `[Context]` contains relevant existing code for style consistency.
        
        Args:
            path: Target file path to save the generated code.
            content: Instruction and Context block using [Instruction] and [Context] sections.
                     [Context] can include 'filename:start-end' or 'filename'.
        
        Returns:
            Sym-Ops formatted response summary.
        """
        from companion.tools.approval import ApprovalTool
        from companion.tools.file_ops import file_ops
        from companion.ui import ui
        import re
        
        try:
            # Parse content for [Instruction] and [Context]
            instruction_match = re.search(r'\[Instruction\](.*?)\n*(?=\[Context\]|\Z)', content, re.DOTALL)
            context_match = re.search(r'\[Context\](.*?)\n*(?=\Z)', content, re.DOTALL)
            
            instruction = instruction_match.group(1).strip() if instruction_match else ""
            context_str = context_match.group(1).strip() if context_match else ""
            
            # Resolve context files
            resolved_context = []
            if context_str:
                # Parse context references like "filename:start-end" or just "filename"
                for line in context_str.split('\n'):
                    line = line.strip()
                    if not line:
                        continue
                    if ':' in line:
                        # Has line range
                        filename, range_str = line.split(':', 1)
                        start, end = range_str.split('-')
                        result = file_ops.read_file(filename, start_line=int(start), max_lines=int(end)-int(start)+1)
                        resolved_context.append(f"## {line}\n{result['content']}")
                    else:
                        # Just filename
                        result = file_ops.read_file(line)
                        resolved_context.append(f"## {line}\n{result['content']}")
            
            # Build prompt
            prompt_parts = [
                f"[Instruction]\n{instruction}",
                "\n[Context]\n" + "\n\n".join(resolved_context) if resolved_context else "",
                "\n\n[Output Format]\n"
                "Return ONLY the code. No explanations, no markdown code blocks."
            ]
            prompt = "\n".join(prompt_parts)
            
            # Request approval
            if not ui.request_confirmation(f"Generate code to {path} using Sub-LLM?"):
                return "::result fail\nUser denied approval."
            
            # Call Sub-LLM
            code = self.sub_llm.call_sub_llm(
                task_type="generate_code",
                input_data={"prompt": prompt}
            )
            
            # Save to file
            result = file_ops.write_file(path, code)
            
            # Return summary
            line_count = len(code.splitlines())
            return f"::result ok\nGenerated {line_count} lines of code to {path}."
        except Exception as e:
            logger.error(f"Sub-LLM call failed: {e}")
            return f"::result fail\nError generating code: {e}"
