import re
from collections import defaultdict

def analyze_logs():
    # Initialize dictionary to count errors by hour
    error_counts = defaultdict(int)
    
    # Read and process the log file
    with open('app.log', 'r') as f:
        for line in f:
            # Parse each log line to extract timestamp and level
            match = re.match(r'^(\d{4}-\d{2}-\d{2} \d{2}):\d{2}:\d{2} \[(\w+)\]', line.strip())
            if match:
                timestamp_hour = match.group(1)  # Format: "2024-01-01 10"
                level = match.group(2)
                
                # Count only ERROR entries
                if level == 'ERROR':
                    error_counts[timestamp_hour] += 1
    
    # Sort by timestamp
    sorted_hours = sorted(error_counts.keys())
    
    # Write results to CSV
    with open('stats.csv', 'w') as f:
        f.write("hour,count\n")
        for hour in sorted_hours:
            f.write(f"{hour},{error_counts[hour]}\n")
    
    print(f"Analyzed {len(error_counts)} hours with errors")
    print(f"Results saved to stats.csv")

if __name__ == "__main__":
    analyze_logs()
>>>

