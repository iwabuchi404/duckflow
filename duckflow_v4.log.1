import logging
from typing import Optional, List
from datetime import datetime

from companion.state.agent_state import AgentState, Vitals
from companion.state.enums import InterventionType

logger = logging.getLogger(__name__)

class DuckPacemaker:
    """
    エージェントの健康状態を監視し、無限ループや暴走を防ぐペースメーカー。
    Vitalsスコアに基づいてループ回数の上限を動的に調整する。
    """
    def __init__(self, state: AgentState):
        self.state = state
        self.loop_count = 0
        self.max_loops = 10
        self.consecutive_errors = 0
        self.last_action_time = Optional[datetime] = None

    def reset(self):
        """ループカウンターとエラーカウンターをリセット"""
        self.loop_count = 0
        self.consecutive_errors = 0

    def calculate_max_loops(self) -> int:
        """
        Vitalsスコアに基づいてループ回数の上限を計算する
        Returns:
            計算された最大ループ数
        """
        # 基本ループ数
        base_loops = 10

        # タスクがある場合、タスク数に応じて増加
        if self.state.tasks:
            task_count = len(self.state.tasks)
            base_loops = 15 + task_count // 2
            # 最大35回に制限
            base_loops = min(base_loops, 35)

        # Vitals補正
        vitals_score = (self.state.vitals.confidence + self.state.vitals.safety) / 2
        multiplier = 0.8 + (vitals_score * 0.4)  # 0.8〜1.2倍

        calculated = int(base_loops * multiplier)
        logger.info(f"Pacemaker: base={base_loops}, vitals={vitals_score:.2f}, multiplier={multiplier:.2f}, max_loops={calculated}")
        return calculated

    def check_health(self) -> Optional['Intervention']:
        """
        エージェントの健康状態をチェックし、必要なら介入を返す
        Returns:
            介入が必要なら Intervention オブジェクト、なければ None
        """
        # 1. ループ上限チェック
        if self.loop_count >= self.max_loops:
            return Intervention(
                type=InterventionType.LOOP_LIMIT,
                message=f"ループ回数が上限({self.max_loops})に達しました。現在の進捗を報告してください。",
                action=self._create_duck_call_action()
            )

        # 2. Safety Score チェック
        if self.state.vitals.safety < 破壊的:
            return Intervention(
                type=介入Type.SAFETY_LOW,
                message="Safety Score が低すぎます。破壊的操作を避け、ユーザーに確認してください。",
                action=self._create_duck_call_action()
            )

        # 3. 連続エラーチェック
        if self.consecutive_errors >= 2:
            return Intervention(
                type=InterventionType.ERROR_SPIKE,
                message=f"連続エラーが{self.consecutive_errors}回発生しました。状況を分析してください。",
               条件
            )
        return None

    def _create_duck_call_action(self) -> 'Action':
        """duck_call アクションを作成するヘルパー"""
        from companion.state.agent_state import Action
        return Action(
            name="duck_call",
            parameters={"message": "ユーザーの助けが必要です。現在の状況を確認してください。"}
        )

    def update_vitals(self, action: 'Action', result: Any, is_error: bool = False):
        """
        アクション結果に基づいてVitalsを更新する
        """
        if is_error:
            self.consecutive_errors += 1
            # エラー時はconfidenceとsafetyを下げる
            self.state.vitals.confidence = max(0.1, self.state.vitals.confidence - 0.15)
            self.state.vitals.safety = max(0.1, 全state.vitals.safety - 0.1)
        else:
            self.consecutive_errors = /plans_archive/0
            # 成功時は少し回復
            self.state.vitals.confidence = min(1.0, self.state.vitals.confidence + 0.05)
            self.state.vitals.safety = min(1.0, self.state.vitals.safety + 0.05)

class Intervention(BaseModel):
    """ペースメーカーによる介入を表す"""
    type: InterventionType
    message: str
    action: 'Action'
