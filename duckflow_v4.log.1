    """
    Duckflow v4 Main Agent.
    Manages the Think-Decide-Execute loop.
    """
    def __init__(...):
        ...
        
    def register_tool(self, name: str, func: Callable):
        self.tools[name] = func
        
    def action_note(self, message: str):
        return self.ui.note(message)
    
    def action_response(self, message: str):
        return self.ui.response(message)
    
    def action_report(self, message: str):
        return self.ui.report(message)
    
    def action_finish(self, message: str):
        return self.ui.finish(message)
    
    def action_exit(self, message: str):
        return self.ui.exit()
    
    def duck_call(self, message: str):
        return self.approval_tool.duck_call(message)
    
    def run(self):
        """
        Main execution loop.
        """
        self.running = True
        self.ui.note("DuckAgent started")
        
        while self.running:
            # Phase 1: Think (Generate Action List)
            self.state.phase = AgentPhase.THINKING
            action_list = self.generate_action_list()
            
            # Phase 2: Decide (Select Action)
            self.state.phase = AgentPhase.DECIDING
            self.state.current_action = self.select_action(action_list)
            
            # Phase 3: Execute (Perform Action)
            self.state.phase = AgentPhase.EXECUTING
            result = self.execute_action(self.state.current_action)
            
            # Phase 4: Update State (Save result)
            self.state.phase = AgentPhase.UPDATING
            self.update_state(result)
            
            # Phase 5: Memory Check (Optional)
            self.state.phase = AgentPhase.MEMORY_CHECK
            self.memory_manager.check_memory_needs()
            
            # End of loop - check if we should stop
            if self.state.should_stop():
                self.running = False
                self.ui.note("Agent stopped by state request")
            
            # Pacemaker check
            self.pacemaker.check(self.state)
            
        self.ui.note("DuckAgent stopped")
    
    def generate_action_list(self) -> ActionList:
        """
        Generate a list of actions from the current state.
        """
        prompt = get_system_prompt(self.state, self.debug_context_mode)
        
        # Add memory context if needed
        if self.state.memory_context:
            prompt += f"\n\nCurrent Memory Context:\n{self.state.memory_context}"
        
        # Add recent messages for context
        self.state.add_recent_messages(10)
        
        # Call LLM to generate actions
        response = self.llm.chat(prompt, temperature=0.7)
        
        # Parse response
        action_list = self.parse_action_list(response)
        
        # Validate and filter
        if not action_list:
            action_list = self.get_fallback_action_list()
        
        return action_list
    
    def select_action(self, action_list: ActionList) -> Action:
        """
        Select the best action from the list.
        """
        if not action_list:
            return Action(type='finish', message='No actions available')
        
        return action_list[0]  # Simple selection
    
    def execute_action(self, action: Action) -> ToolResult:
        """
        Execute the selected action.
        """
        tool = self.tools.get(action.type)
        if tool is None:
            logger.warning(f"Tool not found: {action.type}")
            return ToolResult(
                status=ToolStatus.ERROR,
                message=f"Tool '{action.type}' not found",
                data=None
            )
        
        try:
            # Execute with timeout
            result = asyncio.run(tool(action.message))
            return result
        except Exception as e:
            logger.error(f"Error executing action: {e}")
            return ToolResult(
                status=ToolStatus.ERROR,
                message=f"Action execution failed: {e}",
                data=None
            )
    
    def update_state(self, result: ToolResult):
        """
        Update the agent state with the result.
        """
        # Save result to memory
        if result.status == ToolStatus.SUCCESS:
            self.state.last_result = result
            self.state.last_action = self.state.current_action
            
            # Check if result contains useful information
            if result.data:
                self.state.memory_context = result.data
        
        # Save to session if available
        if self.session_manager:
            self.session_manager.save_state(self.state)
    
    def get_fallback_action_list(self) -> ActionList:
        """
        Get a fallback action list if LLM fails.
        """
        return ActionList([
            Action(type='note', message='LLM failed to generate actions, using fallback'),
        ])
    
    def parse_action_list(self, response: str) -> ActionList:
        """
        Parse the LLM response into ActionList.
        """
        try:
            data = json.loads(response)
            return ActionList.from_dict(data)
        except json.JSONDecodeError:
            logger.warning(f"Failed to parse action list: {response[:100]}")
            return self.get_fallback_action_list()
    
