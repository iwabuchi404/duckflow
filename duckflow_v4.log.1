import csv
from datetime import datetime
import re

def analyze_logs():
    # Read app.log and count ERRORs per hour
    error_counts = {}
    
    try:
        with open('app.log', 'r') as log_file:
            for line in log_file:
                if '[ERROR]' in line:
                    # Extract timestamp from line
                    timestamp_match = re.search(r'\[(.*?)\]', line)
                    if timestamp_match:
                        timestamp_str = timestamp_match.group(1)
                        
                        # Parse timestamp and get hour format
                        try:
                            dt = datetime.strptime(timestamp_str, '%Y-%m-%d %H:%M:%S')
                            hour_key = dt.strftime('%Y-%m-%d %H:%M')
                            
                            # Count error per hour
                            if hour_key in error_counts:
                                error_counts[hour_key] += 1
                            else:
                                error_counts[hour_key] = 1
                        except ValueError:
                            continue
                            
    except FileNotFoundError:
        print("Error: app.log not found. Run generate_logs.py first.")
        return
    
    # Save to CSV
    with open('stats.csv', 'w', newline='') as csv_file:
        writer = csv.writer(csv_file)
        writer.writerow(['timestamp', 'error_count'])
        
        # Sort timestamps and write
        for timestamp in sorted(error_counts.keys()):
            writer.writerow([timestamp, error_counts[timestamp]])
    
    print(f"Analysis complete. Error counts saved to stats.csv")
    print(f"Found {len(error_counts)} hours with errors")

if __name__ == "__main__":
    analyze_logs()
