#!/usr/bin/env python3
"""
Diff Benchmark Tool - Compares generate_tool outputs

Usage:
  diff_benchmark.py --baseline <dir> --candidate <dir>
  diff_benchmark.py (-h | --help)

Example:
  diff_benchmark.py --baseline baseline/ --candidate candidate/
"""

import difflib
import json
import os
import sys
from docopt import docopt

def validate_directory(path):
    """Ensure directory exists and contains files"""
    if not os.path.isdir(path):
        raise ValueError(f"Directory not found: {path}")
    if not any(os.scandir(path)):
        raise ValueError(f"Empty directory: {path}")

def calculate_metrics(baseline_file, candidate_file):
    """Compute comparison metrics for two files"""
    with open(baseline_file) as f1, open(candidate_file) as f2:
        baseline_lines = f1.readlines()
        candidate_lines = f2.readlines()
    
    diff = list(difflib.unified_diff(
        baseline_lines, candidate_lines,
        n=0, lineterm=''
    ))
    
    return {
        "line_count_diff": abs(len(baseline_lines) - len(candidate_lines)),
        "diff_lines": len(diff),
        "similarity_ratio": difflib.SequenceMatcher(
            None, baseline_lines, candidate_lines
        ).ratio()
    }

def compare_directories(baseline, candidate):
    """Compare all files in two directories"""
    validate_directory(baseline)
    validate_directory(candidate)
    
    results = {"files": {}}
    total_metrics = {"line_count_diff": 0, "diff_lines": 0, "similarity_ratio": 0}
    file_count = 0
    
    for filename in os.listdir(baseline):
        baseline_path = os.path.join(baseline, filename)
        candidate_path = os.path.join(candidate, filename)
        
        if not os.path.isfile(baseline_path) or not os.path.isfile(candidate_path):
            continue
            
        metrics = calculate_metrics(baseline_path, candidate_path)
        results["files"][filename] = metrics
        
        total_metrics["line_count_diff"] += metrics["line_count_diff"]
        total_metrics["diff_lines"] += metrics["diff_lines"]
        total_metrics["similarity_ratio"] += metrics["similarity_ratio"]
        file_count += 1
    
    if file_count > 0:
        total_metrics["similarity_ratio"] /= file_count
    
    results["summary"] = {
        "file_count": file_count,
        **total_metrics
    }
    return results

if __name__ == "__main__":
    args = docopt(__doc__)
    try:
        result = compare_directories(
            os.path.abspath(args['--baseline']),
            os.path.abspath(args['--candidate'])
        )
        print(json.dumps({"status": "ok", "data": result}, indent=2))
    except Exception as e:
        print(json.dumps({
            "status": "error",
            "message": str(e),
            "help": "Check if directories exist and contain matching files"
        }), file=sys.stderr)
        sys.exit(1)
