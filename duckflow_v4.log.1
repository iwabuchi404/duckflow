content: #!/usr/bin/env python3
"""
Core DuckAgent implementation for Duckflow v4.

This module contains the main DuckAgent class that orchestrates all components.
"""
import asyncio
import logging
from typing import Optional, Dict, Any, List
from dataclasses import dataclass

from companion.base import BaseAgent
from companion.state import AgentState
from companion.execution import ExecutionEngine
from companion.modules.session_manager import SessionManager
from companion.output import OutputHandler
from companion.utils import Logger

logger = logging.getLogger(__name__)


@dataclass
class DuckAgent:
    """
    Main DuckAgent class that orchestrates all components.

    Attributes:
        debug_context_mode: Debug mode for context messages
        session_manager: Session manager for saving/loading sessions
        resume_state: Resumed state from previous session
    """
    debug_context_mode: Optional[str] = None
    main_logger: Logger = None
    session_manager: Optional[SessionManager] = None
    resume_state: Optional[AgentState] = None

    def __post_init__(self):
        """Initialize the agent with its components."""
        self.main_logger = Logger()
        self.execution_engine = ExecutionEngine(
            debug_context_mode=self.debug_context_mode,
            main_logger=self.main_logger,
        )

    async def run(self):
        """
        Main entry point for the DuckAgent.

        This method orchestrates the agent's lifecycle:
        1. Initialize components
        2. Load or create session state
        3. Run the main event loop
        4. Handle cleanup on exit
        """
        try:
            logger.info("DuckAgent starting...")
            # Initialize components
            self.execution_engine.initialize()

            # Load or create session state
            if self.resume_state:
                self.execution_engine.set_state(self.resume_state)
            else:
                self.execution_engine.initialize_state()

            # Run the main event loop
            await self.execution_engine.run()

        except KeyboardInterrupt:
            logger.info("DuckAgent interrupted by user")
        except Exception as e:
            logger.error(f"DuckAgent error: {e}")
            raise
        finally:
            # Save session state
            if self.session_manager and self.execution_engine.state:
                self.session_manager.save(self.execution_engine.state)
            logger.info("DuckAgent stopped")

    def get_state(self) -> AgentState:
        """Get the current state of the agent."""
        return self.execution_engine.state

    def set_state(self, state: AgentState):
        """Set the state of the agent."""
        self.execution_engine.set_state(state)
        self.execution_engine.initialize_state()
        self.execution_engine.initialize()
