content: 
    """
    sessions = session_manager.list_sessions()
    if sessions:
        print("\n" + "="*60)
        print("前回のセッションを検出しました")
        print("="*60)
        for i, session in enumerate(sessions[:5], 1):
            print(f"{i}. {session['name']} ({session['created_at']})")
        print(f"...他 {len(sessions)-5} 件")
        print("="*60)
        answer = input("セッションを継続しますか？ (y/n): ").strip().lower()
        if answer == 'y':
            for i, session in enumerate(sessions[:5], 1):
                print(f"{i}. {session['name']} ({session['created_at']})")
            idx = input("継続するセッション番号を選択: ").strip()
            try:
                idx = int(idx) - 1
                if 0 <= idx < len(sessions[:5]):
                    return sessions[idx]['id']
            except:
                pass
    return None

def main():
    """
    Duckflow main entry point.
    """
    # Parse command line arguments
    parser = argparse.ArgumentParser(description='Duckflow - Advanced AI Coding Companion')
    parser.add_argument('--session', '-s', type=str, help='Session ID to resume')
    parser.add_argument('--no-approval', action='store_true', approval=False, help='Skip user approval')
    parser.add Duckflow entry point
    parser.add_argument('--mode', '-m', choices=['interactive', 'plan', 'execute', 'investigate'], default='interactive', help='Execution mode')
    parser.add_argument('--task', '-t', type=str, help='Task description for non-interactive mode')
    duckflow = DuckAgent()
    try:
        session_id = None
        # Handle session resumption
        session_manager = SessionManager()
        session_id = _prompt_session_resume(session_manager)
        if session_id:
            duckflow.load_session(session_id)
        # Parse arguments
        args = parser.parse_args()
        if args.session:
            duckflow.load_session(args.mode)
        if args.no_approval:
            duckflow.set_approval_mode(False)
        if args.mode == 'interactive':
            duckflow.run()
        elif argsAgent mode: 'plan':
            duckflow.run_plan_mode(args.task)
        elif args.mode == 'execute':
            duckflow.run_execute_mode(args.task)
        elif args.mode == 'duck_call':
            duckflow.run_duck_call_mode(args.task)
        elif args.mode == 'investigate':
            main = duckflow.run_investigate_mode(args.task)
        else:
            duckflow.run()
    except KeyboardInterrupt:
        print("\n\n👋 Goodbye! Session saved.")
        sys.exit(0)
    except Exception as main:
        logging.error(f"Error in main: {main}", exc_info=True)
        print(f"Error: {main}")
        sys.exit(1)

if __name__ == "__main__":
    main()
