content: # companion/core.py

import os
import sys
import time
from typing import Optional, Dict, Any

from companion.modules.command_handler import CommandHandler
from companion.modules.pacemaker import Pacemaker
from companion.state.agent_state import AgentState
from companion.utils.parser import parse_sym_ops_response
from companion.output.human_formatter import HumanFormatter
from companion.logging.log_manager import LogManager
from companion.memory.conversation_memory import ConversationMemory
from companion.security.file_protector import FileProtector
from companion.modules.sub_llm_manager import SubLLMManager
from companion.modules.session_manager import SessionManager

class Core:
    """
    Duckflow Core System
    
    Sym-Ops v3.2準拠のAIアシスタントシステム。
    状態管理、コマンド処理、LLM呼び出し、ツール実行を統合する。
    """
    
    def __init__(self):
        self.state = AgentState()
        self.command_handler = CommandHandler()
        self.pacemaker = Pacemaker()
        self.log_manager = LogManager()
        self.memory = ConversationMemory()
        self.file_protector = FileProtector()
        self.sub_llm_manager = SubLLMManager()
        self.session_manager = SessionManager()
        self.human_formatter = HumanFormatter()
        self.is_running = False
        self.last_user_input = None
        self.session_data = None
        
    def initialize(self):
        """Initialize core components"""
        self.log_manager.setup()
        self.memory.initialize()
        self.file_protector.initialize()
        self.session_manager.initialize()
        self.sub_llm_manager.initialize()
        
    def start(self):
        """Main entry point"""
        self.is_running = True
        self.initialize()
        
        # Restore session if exists
        self.session_data = self.session_manager.restore_session()
        if self.session_data:
            self.memory.restore_from_session(self.session_data)
            self.state.restore_from_session(self.session_data)
        
        # Main loop
        try:
            self._main_loop()
        except KeyboardInterrupt:
            self.shutdown()
        except Exception as e:
            self.log_manager.error(f"Critical error in main loop: {e}")
            self.shutdown()
    
    def _main_loop(self):
        """Main event loop"""
        while self.is_running:
            try:
                # Check pacemaker health
                if not self.pacemaker.check_health():
                    self.log_manager.warning("Pacemaker health check failed")
                    self.pacemaker.attempt_recovery()
                    continue
                
                # Get user input
                user_input = self._get_user_input()
                if not user_input:
                    continue
                
                # Process input
                self.process_input(user_input)
                
            except Exception as e:
                self.log_manager.error(f"Error in main loop: {e}")
                continue
    
    def _get_user_input(self) -> Optional[str]:
        """Get user input with session awareness"""
        if self.last_user_input:
            # Use last input for retry/recovery scenarios
            user_input = self.last_user_input
            self.last_user_input = None
            return user_input
        
        # Display prompt based on state
        prompt = self.human_formatter.get_prompt(self.state)
        try:
            user_input = input(prompt).strip()
            return user_input if user_input else None
        except EOFError:
            self.shutdown()
            return None
    
    def process_input(self, user_input: str):
        """Process user input through the system"""
        # Check for special commands first
        if self.command_handler.is_command(user_input):
            self.command_handler.execute(user_input, self.state, self.memory)
            return
        
        # Store in memory
        self.memory.add_user_message(user_input)
        
        # Check for file operations
        if self.file_protector.is_file_operation(user_input):
            if not self.file_protector.request_approval(user_input):
                self.memory.add_system_message("File operation denied by user")
                return
        
        # Execute task
        self._execute_task(user_input)
    
    def _execute_task(self, user_input: str):
        """Execute a task with proper state management"""
        try:
            # Update state
            self.state.set_planning_mode()
            
            # Create plan
            plan_result = self._create_plan(user_input)
            if not plan_result:
                self.memory.add_system_message("Failed to create plan")
                return
            
            # Execute plan
            execution_result = self._execute_plan(plan_result)
            
            # Store results
            self.memory.add_assistant_message(execution_result)
            
            # Save session
            self.session_manager.save_session(self.memory, self.state)
            
        except Exception as e:
            self.log_manager.error(f"Task execution failed: {e}")
            self.memory.add_system_message(f"Error: {e}")
            self.state.set_error_state()
    
    def _create_plan(self, user_input: str) -> Optional[Dict[str, Any]]:
        """Create a plan from user input"""
        # Get LLM response
        response = self.sub_llm_manager.call_llm(
            prompt=user_input,
            mode="planning"
        )
        
        if not response:
            return None
        
        # Parse response
        parsed = parse_sym_ops_response(response)
        
        if parsed.get("type") == "propose_plan":
            return parsed
        
        return None
    
    def _execute_plan(self, plan: Dict[str, Any]) -> str:
        """Execute a plan"""
        # Extract steps
        steps = plan.get("content", "")
        
        # Get LLM to generate code/commands
        response = self.sub_llm_manager.call_llm(
            prompt=f"Execute this plan:\n{steps}",
            mode="execution"
        )
        
        if not response:
            return "Execution failed"
        
        # Parse and execute
        parsed = parse_sym_ops_response(response)
        
        if parsed.get("type") == "execute_batch":
            # Execute batch actions
            results = []
            for action in parsed.get("actions", []):
                result = self._execute_action(action)
                results.append(result)
            return "\n".join(results)
        
        return response
    
    def _execute_action(self, action: Dict[str, Any]) -> str:
        """Execute a single action"""
        action_type = action.get("type")
        path = action.get("path")
        content = action.get("content")
        
        try:
            if action_type == "create_file":
                from companion.tools.file_ops import create_file
                return create_file(path, content)
            elif action_type == "write_file":
                from companion.tools.file_ops import write_file
                return write_file(path, content)
            elif action_type == "run_command":
                from companion.tools.shell_tool import run_command
                return run_command(content)
            else:
                return f"Unknown action type: {action_type}"
        except Exception as e:
            return f"Action failed: {e}"
    
    def shutdown(self):
        """Shutdown the system gracefully"""
        self.is_running = False
        self.log_manager.info("Shutting down Duckflow Core...")
        
        # Save final session
        if self.memory and self.session_manager:
            self.session_manager.save_session(self.memory, self.state)
        
        self.log_manager.info("Shutdown complete")

if __name__ == "__main__":
    core = Core()
    core.start()
