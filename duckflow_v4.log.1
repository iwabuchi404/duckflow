  142|                 task.status = TaskStatus.COMPLETED\n",
  143|                 return {\"task\": task.title, \"status\": \"success\", \"result\": result}\n",
  144|             else:\n",
  144|                 task.status = TaskStatus.FAILED\n",
  145|                 return {\"task\": task.title, \"status\": \"failed\", \"error\": \"Could not parse action\"}\n",
  146|                 \n",
  146|         except Exception as e:\n",
