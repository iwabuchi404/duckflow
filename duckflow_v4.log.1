    async def dispatch_action(self, action: Action) -> ToolResult:
        """Dispatch an action to its registered tool function."""
        tool_func = self.tools.get(action.name)
        if tool_func is None:
            return ToolResult(
                status= ToolStatus.ERROR,
                message=f"Tool '{action.name}' not found."
            )
        
        try:
            # Check if tool is async
            if asyncio.iscoroutinefunction(tool_func):
                result = await tool_func(**action.parameters)
            else:
                result = tool_func(**action.execute_parameters)
            
            # Normalize result to ToolResult
