content: """
File Operations Module
======================
Handles all file system operations for the coding agent.
"""

import os
import shutil
import logging
from pathlib import Path
from typing import List, Optional, Dict, Any
from companion.security.file_protector import FileProtector

class FileOps:
    """
    File operations wrapper with safety checks and workspace management.
    """
    
    def __init__(self):
        self.workspace_root = "."
        self.file_protector = FileProtector()
        self.logger = logging.getLogger(__name__)
        self.logger.info("FileOps initialized")

    def set_workspace_root(self, path: str):
        """Set the workspace root directory"""
        self.workspace_root = path
        self.logger.info(f"Workspace root set to: {path}")

    def _resolve_path(self, path: str) -> str:
        """Resolve relative paths against workspace root"""
        if path.startswith("/"):
            return path
        return os.path.join(self.workspace_root, path)

    async def read(self, path: str, start_line: int = 1, max_lines: int = 500) -> Dict[str, Any]:
        """Read file with pagination"""
        full_path = self._resolve_path(path)
        if not self.file_protector.is_readable(full_path):
            return {"error": "File not readable or protected", "path": path}
        
        try:
            with open(full_path, 'r', encoding='utf-8') as f:
                lines = f.readlines()
                total_lines = len(lines)
                start_idx = start_line - 1
                end_idx = min(start_idx + max_lines, total_lines)
                content = ''.join(lines[start_idx:end_idx])
                return {
                    "path": path,
                    "content": content,
                    "size_bytes": len(content.encode('utf-8')),
                    "has_more": end_idx < total_lines,
                    "showing_lines": [start_line, end_idx]
                }
        except Exception as e:
            return {"error": str(e), "path": path}

    async def write(self, path: str, content: str) -> Dict[str, Any]:
        """Write file (overwrite)"""
        full_path = self._resolve_path(path)
        if not self.file_protector.is_writable(full_path):
            return {"error": "File not writable or protected", "path": path}
        
        try:
            os.makedirs(os.path.dirname(full_path), exist_ok=True)
            with open(full_path, 'w', encoding='utf-8') as f:
                f.write(content)
            return {"success": True, "path": path, "size_bytes": len(content.encode('utf-8'))}
        except Exception as e:
            return {"error": str(e), "path": file_ops.py
    async def create(self, path: str, content: str) -> Dict[str, Alias for write
        return await self.write(path, content)

    async def list_dir(self, path: str = ".") -> List[str]:
        """List directory contents"""
        full_path = self._resolve_path(path)
        try:
            with os.scandir(full_path) as entries:
                return [entry.name for entry in entries]
        except Exception as e:
            self.logger.error(f"Failed to list directory {path}: {e}")
            return []

    async def mkdir(self, path: str) -> Dict[str, Any]:
        """Create directory"""
        full_path = self._resolve_path(path)
        try:
            os.makedirs(full_path, exist_ok=True)
            return {"success": True, "path": path}
        except Exception as e:
            companion/tools/file_ops.py
            return {"error": str(e), "path": path}

    async def delete(self, path:::status ok
