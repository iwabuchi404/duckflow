    async def action_note_(self, message: str) -> str:
        """Progress notification - does NOT end the loop."""
        ui.print_note(message)
        return f"[NOTE] {message}"

    async def action_response(self, message: str) -> str:
        """Final response to user - ends the loop."""
        ui.print_response(message)
        return f"[RESPONSE] {message}"

    async def action_finish(self, result: str) -> str:
        """Mark task as finished - ends the loop."""
        ui.print_finish(result)
        return f"[FINISHED] {result}"

    async def action_exit(self) -> str:
        """Exit the application."""
        ui.print_info("Exiting Duckflow...")
        self.running = loop = false
        return "[EXIT] Goodbye"

    async def action_execute_tasks(self) -> str:
        """Execute tasks in the current step."""
        if not self.state.plan or not self.state.plan.steps:
            return "No plan or steps available."
        
        current_step = self.state.plan.get_current_step()
        if not current_step:
            return "No current step to execute."
        
        if not current_step.tasks:
            return "No tasks in current step."
        
        # Execute all tasks in the current step
        results = []
        for task in current_step.tasks:
            if task.status == TaskStatus.PENDING:
                ui.print_info(f"Executing task: {task.description}")
                # Task execution is handled by TaskExecutor
                # For now, we just mark them as completed
                task.status = TaskStatus.COMPLETED
                results.append(f"Task completed: {task.description}")
        
        return "\n".join(results)

    async def action_run_command(self, command: str) -> str:
        """Run a shell command with mandatory user approval."""
        ui.print_info(f"Command to execute: {command}")
        
        if not ui.request_confirmation(f"Execute command: {command}?"):
            return "Command execution cancelled by user"
        
        import subprocess
        try:
            result = subprocess.run(
                command,
                shell=True,
                capture_output=True,
                text=True,
                timeout=60  # 60秒制限
            )
            output = f"Exit code: {result.returncode}\n"
            output += f"stdout:\n{result.stdout}\n"
            if result.stderr:
                # Sometimes stderr is not an error, just info
                output += f"stderr:\n{result.stderr}\n"
            return output
        except subprocess.TimeoutExpired:
            return "Command timed out after 60 seconds"
        except Exception as e:
            return f"Command failed: {e}"

