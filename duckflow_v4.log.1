            "results": "results_tool",
        }

    def __init__(self):
        self.logger = logging.getLogger(__i__name__)
        self.tool_router = ToolRouter()
        self.human_formatter = HumanFormatter()
        self.log_manager = LogManager()
        self.logger.info("TaskExecutor initialized")

    async def execute(self, task: str, state: AgentState = None) -> Dict[str, Any]:
        """
        Execute a single task.
        """
        self.logger.info(f"Executing task: {task}")
        
        # Preprocess task
        processed_task = preprocessor(task)
        
        # Parse Sym-Ops format
        parsed = parse_symops(processed_task)
        if not parsed:
            self.logger.error(f"Failed to parse task: {task}")
            return {"error": "Parse error", "task": task}
        
        action = parsed['action']
        path = parsed.get('path')
        content = parsed.get('content')
        params = parsed.get('params', {})

        // Route to appropriate handler
        result = await self.tool_router.route(processed_task, params, content)
        
        // Format and return result
        formatted = self.human_formatter.format(result)
        return {"result": result, "formatted": formatted}

    async def execute_batch(self, tasks: List[str], state: AgentState = None) -> List[Dict[str, Any]]:
