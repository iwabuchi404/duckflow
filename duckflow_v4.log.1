/**
 * サルベージ・メカノイド ゲームエンジン - コアエンジンクラス
 * シングルトンパターンを使用して、すべてのゲームシステムを管理します
 */
export class Engine {
    private static instance: Engine;
    private systems: Map<string, System> = new Map();
    private isInitialized = false;
    private isRunning = false;
    private lastTime = 0;
    private animationFrameId: number | null = null;

    private constructor() {}

    /**
     * エンジンのシングルトンインスタンスを取得
     */
    public static get instance(): Engine {
        if (!Engine.instance) {
            Engine.instance = new Engine();
        }
        return Engine.instance;
    }

    /**
     * システムをエンジンに登録
     * @param name システム名
     * @param system 登録するシステム
     */
    public registerSystem(name: string, system: System): void {
        if (this.isInitialized) {
            throw new Error(`システム '${name}' はエンジン初期化後に登録できません`);
        }
        if (this.systems.has(name)) {
            throw new Error(`システム '${name}' は既に登録されています`);
        }
        this.systems.set(name, system);
    }

    /**
     * 登録されたシステムを取得
     * @param name システム名
     * @returns システムインスタンス
     */
    public getSystem<T extends System>(name: string): T {
        const system = this.systems.get(name);
        if (!system) {
            throw new Error(`システム '${name}' が見つかりません`);
        }
        return system as T;
    }

    /**
     * すべてのシステムを初期化
     */
    public async initialize(): Promise<void> {
        if (this.isInitialized) {
            console.warn('エンジンは既に初期化されています');
            return;
        }

        console.log('ゲームエンジンを初期化中...');

        // システムを初期化
        for (const [name, system] of this.systems) {
            try {
                await system.initialize(this);
                console.log(`システム '${name}' の初期化が完了しました`);
            } catch (error) {
                throw new Error(`システム '${name}' の初期化に失敗しました: ${error}`);
            }
        }

        this.isInitialized = true;
        console.log('ゲームエンジンの初期化が完了しました');
    }

    /**
     * ゲームループを開始
     */
    public start(): void {
        if (!this.isInitialized) {
            throw new Error('エンジンが初期化されていません。initialize()を呼び出してください');
        }
        if (this.isRunning) {
            console.warn('ゲームループは既に実行中です');
            return;
        }

        console.log('ゲームループを開始します');
        this.isRunning = true;
        this.lastTime = performance.now();
        this.gameLoop();
    }

    /**
     * ゲームループを停止
     */
    public stop(): void {
        if (!this.isRunning) {
            console.warn('ゲームループは実行されていません');
            return;
        }

        console.log('ゲームループを停止します');
        this.isRunning = false;
        
        if (this.animationFrameId !== null) {
            cancelAnimationFrame(this.animationFrameId);
            this.animationFrameId = null;
        }
    }

    /**
     * ゲームループの実行
     */
    private gameLoop(): void {
        if (!this.isRunning) return;

        const currentTime = performance.now();
        const deltaTime = (currentTime - this.lastTime) / 1000; // 秒単位に変換
        this.lastTime = currentTime;

        // すべてのシステムを更新
        for (const [name, system] of this.systems) {
            try {
                system.update(deltaTime);
            } catch (error) {
                console.error(`システム '${name}' の更新中にエラーが発生しました: ${error}`);
            }
        }

        this.animationFrameId = requestAnimationFrame(() => this.gameLoop());
    }

    /**
     * エンジンが初期化されているかどうかを返す
     */
    public get isEngineInitialized(): boolean {
        return this.isInitialized;
    }

    /**
     * ゲームループが実行中かどうかを返す
     */
    public get isGameRunning(): boolean {
        return this.isRunning;
    }

    /**
     * 登録されたシステム名の一覧を返す
     */
    public getSystemNames(): string[] {
        return Array.from(this.systems.keys());
    }
}
