import logging
from typing import Dict, List, Optional, Callable, Any
from companion.core import DuckAgentState
from companion.modules.context_manager import ContextManager

logger = logging.getLogger(__name__)

class CommandHandler:
    """コマンド実行ハンドラ（スラッシュコマンド対応版）"""

    def __init__(self, agent_state: DuckAgentState, context_manager: ContextManager):
        self.agent_state = agent_state
        self.context_manager = context_manager
        self.commands: Dict[str, Dict] = {}
        self._register_core_commands()

    def _register_core_commands(self):
        """コアコマンドの登録"""
        self.register_command(
            name="help",
            description="利用可能なコマンド一覧を表示",
            handler=self._cmd_help,
            examples=["/help"]
        )
        self.register_command(
            name="status",
            description="現在のセッション状態を表示",
            handler=self._cmd_status,
            examples=["/status"]
        )
        self.register_command(
            name="new",
            description="新規セッションを開始",
            handler=self._cmd_new,
            examples=["/new"]
        )

    def register_command(self, *, name: str, description: str, handler: Callable, examples: List[str]):
        """コマンドを登録"""
        if name in self.commands:
            logger.warning(f"コマンドが上書きされました: {name}")
        self.commands[name] = {
            "description": description,
            "handler": handler,
            "examples": examples
        }

    async def execute(self, command_name: str, args: List[str], **kwargs) -> Dict[str, Any]:
        """コマンドを実行"""
        if command_name not in self.commands:
            return {
                "status": "error",
                "message": f"不明なコマンド: {command_name}"
            }
        
        try:
            handler = self.commands[command_name]["handler"]
            return await handler(args, **kwargs)
        except Exception as e:
            logger.exception(f"コマンド実行エラー: {command_name}")
            return {
                "status": "error",
                "message": f"実行エラー: {str(e)}"
            }

    # --- コアコマンド実装 ---
    async def _cmd_help(self, args: List[str], **kwargs) -> Dict[str, Any]:
        """ヘルプコマンド"""
        help_text = "【利用可能なコマンド】\n"
        for name, cmd in self.commands.items():
            examples = " ".join(cmd["examples"])
            help_text += f"/{name} - {cmd['description']}\n例: {examples}\n"
        return {"status": "success", "message": help_text}

    async def _cmd_status(self, args: List[str], **kwargs) -> Dict[str, Any]:
        """ステータスコマンド"""
        ctx = self.context_manager.get_current_context()
        return {
            "status": "success",
            "message": (
                f"セッションID: {self.agent_state.session_id}\n"
                f"コンテキスト: {ctx.name if ctx else 'なし'}\n"
                f"メモリ使用量: {len(self.agent_state.conversation_history)}件"
            )
        }

    async def _cmd_new(self, args: List[str], **kwargs) -> Dict[str, Any]:
        """新規セッションコマンド"""
        self.agent_state.reset()
        return {"status": "success", "message": "新規セッションを開始しました"}

