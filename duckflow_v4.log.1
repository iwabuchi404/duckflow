import csv
import re
from collections import defaultdict

def analyze_logs():
    """Read app.log and count ERRORs per hour, save to stats.csv"""
    # Read the log file
    with open('app.log', 'r') as f:
        log_lines = f.readlines()
    
    # Count ERRORs per hour
    error_counts = defaultdict(int)
    
    for line in log_lines:
        line = line.strip()
        if not line:
            continue
            
        # Parse timestamp and level
        match = re.match(r'^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}) \[(\w+)\]', line)
        if match:
            timestamp_str = match.group(1)
            level = match.group(2)
            
            if level == 'ERROR':
                # Extract hour (YYYY-MM-DD HH:00:00)
                hour_key = timestamp_str[:14] + '00:00'
                error_counts[hour_key] += 1
    
    # Write to CSV
    with open('stats.csv', 'w', newline='') as csvfile:
        writer = csv.writer(csvfile)
        writer.writerow(['timestamp', 'error_count'])
        
        # Sort by timestamp
        for timestamp in sorted(error_counts.keys()):
            writer.writerow([timestamp, error_counts[timestamp]])
    
    print(f"Analysis complete. Found {len(error_counts)} hours with ERRORs. Results saved to stats.csv")

if __name scripts.main():
    analyze_logs()
