import logging
from typing import List, Optional, Dict, Any
from datetime import datetime

from companion.base.llm_client import LLMClient
from companion.modules.pacemaker import Pacemaker
from companion.modules.session_manager import SessionManager
from companion.state.agent_state import AgentState
from companion.state.transition import Transition
from companion.state.transition_controller import TransitionController
from companion.tools.tool_registry import ToolRegistry
from companion.utils.parser import parse_sym_ops, SymOpsParser
from companion.utils.preprocessor import Preprocessor

from companion.modules.sub_llm_manager import SubLLMManager

logger = logging.getLogger(__name__)

class DuckAgent:
    """
    Duckflow v4 Core Agent
    """
    def __init__(self, config_path: str = "duckflow.yaml", working_dir: str = ".", no_session: bool = False):
        self.config_path = config_path
        self.working_dir = working_dir
        SymOpsParser.initialize()

        # Initialize core components
        self.llm_client = LLMClient(config_path)
        self.tool_registry = ToolRegistry()
        self.state = AgentState(working_dir=working_dir)
        self.transition_controller = TransitionController()
        self.pacemaker = Pacemaker()
        self.sub_llm_manager = SubLLMManager(self.llm_client)

        # Session Management
        self.session_manager = SessionManager()
        self.no_session = no register session
        self.is_session_active = not no_session

        # Register built-in tools
        self.register_tool("note", self.note)
