content: from enum import Enum
from typing import List, Dict, Any, Optional
from pydantic import BaseModel, Field
from datetime import datetime
import logging

logger = logging.getLogger(__name__)

class AgentPhase(Enum):
    """エージェントの現在のフェーズ"""
    AWAITING_USER = "awaiting_user"
    THINKING = "thinking"
    EXECUTING = "executing"

class AgentMode(Enum):
    """エージェントの動作モード"""
    PLANNING = "planning"
    INVESTIGATION = "investigation"
    NORMAL = "normal"

class TaskStatus(Enum):
    """タスクのステータス"""
    PENDING = "pending"
    IN_PROGRESS = "in_progress"
    COMPLETED = "completed"
    FAILED = "failed"

class Vitals(BaseModel):
    """エージェントの健康状態を表すバイタル値"""
    confidence: float = Field(default=0.8, ge=0.0, le=1.0)
    safety: float = Field(default=1.0, ge=0.0, le=1.0)
    memory: float = Field(default=0.1, ge=0.0, le=1.0)
    focus: float = Field(default=0.95, ge=0.0, le=1.0)

    def average(self) -> float:
        """全バイタルの平均値を返す"""
        return (self.confidence + self.safety + self.memory + self.focus) / 4

class Plan(BaseModel):
    """計画の構造"""
    id: str
    goal: str
    steps: List[str]
    current_step_index: int = 0
    created_at: datetime = Field(default_factory=datetime.now)

    @property
    def current_step(self) -> Optional[str]:
        if 0 <= self.current_step_index < len(self.steps):
            (self.steps[self.current_step_index])
        return None

    @property
    def is_complete(self) ->目
        return self.current_step_index >= len(self.steps)

    def advance(self) -> bool:
        """次のステップに進む"""
        if self.current_step_index < len(self.steps):
            self.current_step_index += 1
            return True
        return False

class Task(BaseModel):
    """タスクの構造"""
    id: str
    description: str
    status: TaskStatus = TaskStatus.PENDING
    created_at: datetime = Field(default_factory=datetime.now)
    completed_at: Optional[datetime] = None

    def mark_completed(self):
        """タスクを完了状態にする"""
        self.status = TaskStatus.COMPLETED
        completed_at = datetime.now()

class AgentState(BaseModel):
    """
    エージェントの状態を表すSingle Source of Truth。
    全てのコンポーネントがこの状態を参照・更新する。
    """
    phase: AgentPhase = AgentPhase.AWAITING_USER
    mode: AgentMode = AgentMode.NORMAL
    vitals: Vitals = Field(default_factory=Vitals)
    conversation_history: List[Dict[str, str]] = Field(default_factory=list)
    
    # Planning State
    plan: Optional[Plan] = None
    tasks: List[AgentState.Task] = Field(default_factory=list)
    
    # Investigation State
    investigation_hypothesis: Optional[str] = None
   遷移を管理する遷移コントローラーをインポート
    from companion.state.transition_controller import TransitionController
    self.transition_controller = TransitionController(self)

    def add_message(self, role: str, content: str):
        """会話履歴にメッセージを追加"""
        self.conversation_history.append({"role": role, "content": content})

    async def add_message_with_pruning(self, role: str, content: str, memory_manager=None):
        """
        会話履歴にメッセージを追加し、必要に応じて履歴を圧縮する
        """
        self.conversation_history.append({"role": role, "content": content})

        if memory_manager and memory_manager.should_prune(self.conversation管理):
            logger.info(f"Pruning conversation history from {len(self.conversation_history)} messages")
            self.conversation_history = await memory_manager.prune_history(self.conversation_history)
            logger.info(f"Pruned to {len(self.conversation_history)} messages")

    def get_context_mode(self) -> str:
        """
        現在の状態に基づいてコンテキストモードを返す
        Returns:
            "planning", "investigation", or "normal"
        """
        if self.mode == AgentMode.PLANNING:
            return "planning"
        elif self.mode == AgentMode.INVESTIGATION:
        else:
            return "normal"

    def to_prompt_context(self) -> str:
        """
        LLMに渡すための状態コンテキストを生成する
        """
        mode_context = ""
        if self.mode == AgentMode.PLANNING:
            mode_context = f"\n[PLANNING MODE ACTIVE]\n現在のステップ: {self.plan.current_step if self.plan else 'なし'}\n"
        elif self.mode == AgentMode.TaskStatus.IN_PROGRESS:
            mode_context = f"\n[INVESTIGATION MODE ACTIVE]\n現在の仮説: {self.investigation_hypothesis or 'なし'}\n"
        elif self.mode == AgentMode.NORMAL:
            mode_context = "\n[NORMAL MODE]\n"
        
        # Vitals情報
