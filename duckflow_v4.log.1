#!/usr/bin/env python3
"""
Diff Benchmark Tool - File comparison metrics generator

Usage:
  diff_benchmark.py --baseline <dir> --candidate <dir>
  diff_benchmark.py (-h | --help)

Outputs structured JSON metrics to stdout
"""

import difflib
import json
import os
import sys
from docopt import docopt

def is_text_file(path):
    """Check if file is likely text-based (simplified)"""
    try:
        with open(path, 'r', encoding='utf-8') as f:
            f.read(1024)
        return True
    except:
        return False

def compare_files(file1, file2):
    """Compare two text files and return metrics"""
    try:
        with open(file1, 'r', encoding='utf-8') as f1, open(file2, 'r', encoding='utf-8') as f2:
            diff = list(difflib.ndiff(f1.readlines(), f2.readlines()))
        added = sum(1 for line in diff if line.startswith('+ '))
        removed = sum(1 for line in diff if line.startswith('- '))
        return added, removed
    except Exception:
        return None, None

def compare_directories(baseline, candidate):
    """Compare all compatible files in two directories"""
    metrics = {
        "files": {"total": 0, "different": 0, "binary": 0},
        "lines": {"added": 0, "removed": 0},
        "similarity": 1.0
    }
    
    baseline_files = set(f for f in os.listdir(baseline) 
                        if os.path.isfile(os.path.join(baseline, f)))
    candidate_files = set(f for f in os.listdir(candidate) 
                        if os.path.isfile(os.path.join(candidate, f)))
    
    common_files = baseline_files & candidate_files
    metrics["files"]["total"] = len(common_files)
    
    for file in common_files:
        baseline_path = os.path.join(baseline, file)
        candidate_path = os.path.join(candidate, file)
        
        if not is_text_file(baseline_path) or not is_text_file(candidate_path):
            metrics["files"]["binary"] += 1
            continue
            
        added, removed = compare_files(baseline_path, candidate_path)
        if added is not None and removed is not None:
            if added > 0 or removed > 0:
                metrics["files"]["different"] += 1
            metrics["lines"]["added"] += added
            metrics["lines"]["removed"] += removed

    # Calculate similarity (0.0-1.0 scale)
    total_changes = metrics["lines"]["added"] + metrics["lines"]["removed"]
    if total_changes > 0:
        total_lines = max(metrics["lines"]["added"], metrics["lines"]["removed"])
        metrics["similarity"] = round(1.0 - (total_changes / (total_lines + 1)), 2)
    
    return metrics

def main():
    args = docopt(__doc__)
    
    # Validate inputs
    for dir_path in [args['--baseline'], args['--candidate']]:
        if not os.path.isdir(dir_path):
            print(json.dumps({
                "status": "error", 
                "message": f"Directory not found: {dir_path}"
            }))
            sys.exit(1)
    
    try:
        result = compare_directories(args['--baseline'], args['--candidate'])
        print(json.dumps({
            "status": "ok", 
            "metrics": result,
            "metadata": {"tool": "diff_benchmark", "version": "1.0"}
        }))
        sys.exit(0)
    except Exception as e:
        print(json.dumps({
            "status": "error", 
            "message": f"Unexpected error: {str(e)}"
        }))
        sys.exit(2)

if __name__ == "__main__":
    main()
