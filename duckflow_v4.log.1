/**
 * EntitySystem - エンティティとコンポーネントを管理するシステム
 */

import { BaseSystem } from '../systems/BaseSystem';
import { Entity } from './Entity';
import { Component } from './Component';

export class EntitySystem extends BaseSystem {
  private entities: Map<string, Entity> = new Map();
  private entityCounter: number = 0;

  public async initialize(): Promise<void> {
    await super.initialize(this.engine!);
    console.log('[EntitySystem] Initialized');
  }

  /**
   * 新しいエンティティを作成
   */
  public createEntity(id?: string): Entity {
    const entityId = id || `entity_${this.entityCounter++}`;
    const entity = new Entity(entityId);
    this.entities.set(entityId, entity);
    console.log(`[EntitySystem] Entity '${entityId}' created`);
    return entity;
  }

  /**
   * エンティティを取得
   */
  public getEntity(id: string): Entity | undefined {
    return this.entities.get(id);
  }

  /**
   * すべてのエンティティを取得
   */
  public getEntities(): Map<string, Entity> {
    return new Map(this.entities);
  }

  /**
   * アクティブなエンティティを取得
   */
  public getActiveEntities(): Entity[] {
    return Array.from(this.entities.values()).filter(entity => entity.getIsActive());
  }

  /**
   * エンティティを削除
   */
  public destroyEntity(id: string): boolean {
    const entity = this.entities.get(id);
    if (entity) {
      entity.clearComponents();
      this.entities.delete(id);
      console.log(`[EntitySystem] Entity '${id}' destroyed`);
      return true;
    }
    return false;
  }

  /**
   * すべてのエンティティを削除
   */
  public destroyAllEntities(): void {
    for (const entity of this.entities.values()) {
      entity.clearComponents();
    }
    this.entities.clear();
    console.log('[EntitySystem] All entities destroyed');
  }

  /**
   * 毎フレーム呼び出される
   */
  public update(deltaTime: number): void {
    for (const entity of this.getActiveEntities()) {
      const components = entity.getComponents();
      for (const component of components.values()) {
        if (component.update) {
          component.update(deltaTime);
        }
      }
    }
  }

  /**
   * エンティティ数を取得
   */
  public getEntityCount(): number {
    return this.entities.size;
  }
}
