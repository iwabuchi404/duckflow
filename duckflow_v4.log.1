  120|             task.status = TaskStatus.FAILED\n",
  121|             return f\"Task '{task.title}' failed: {str(e)}\"\n",
  122| \n",
  123| \n",
  124| class TaskExecutor:\n",
  124|     \"\"\"\n",
  125|     Executes tasks using the agent's tools.\n",
  126|     \"\"\"\n",
  126|     \n",
  127|     def __init__(self, agent):\n",
  127|         self.agent = agent\n",
  128|     \n",
  128|     async def execute_task_list(self, tasks: List[Task]) -> Dict[str, Any]:\n",
  129|         \"\"\"Execute a list of tasks and return summary.\"\"\"\n",
  130|         results = []\n",
  131|         for task in tasks:\n",
  132|             result = await self._execute_single_task(task)\n",
  132|             results.append(result)\n",
  133|         \n",
  134|         return self._summarize_results(results)\n",
  134|     \n",
  135|     async def _execute_single_task(self, task: Task) -> Dict[str, Any]:\n",
  135|         \"\"\"Execute a single task.\"\"\"\n",
  136|         task.status = TaskStatus.IN_PROGRESS\n",
  137|         try:\n",
  138|             # Parse task description to determine action\n",
  139|             action = self._parse_task_action(task.description)\n",
  140|             \n",
  140|             # Execute via agent tools\n",
  141|             if action:\n",
