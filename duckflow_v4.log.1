    async def edit_lines(self, path: str, start: int, end: int, content: str) -> str:
        """
        行番号ベースの安全なファイル編集。
        指定した行範囲を新しいコンテンツで置換し、前後のコンテキストを自動で返却する。
        """
        full_path = self._get_full_path(path)
        if not full_path.exists():
            raise FileNotFoundError(f"File not found: {path}")

        # 型変換とバリデーション
        start, end = int(start), int(end)
        if start < 1:
            return f"Error: start must be >= 1, got {start}"

        with open(full_path, 'r', encoding='utf-8') as f:
            lines = f.readlines()

        total_lines = len(lines)
        if start > total_lines + 1:
            return f"Error: start ({start}) exceeds file length ({total_lines} lines)"

        # 実際の置換処理
        end = min(end, total_lines)
        new_content_lines = content.split('\n')
        # 各行に改行を付与（最終行の扱いを統一）
        new_content_lines = [l + '\n' for l in new_content_lines]

        old_count = max(0, end - start + 1)
        lines[start - 1:end] = new_content_lines
        
        # ファイル書き込み
        with open(full_path, 'w', encoding='utf-8') as f:
            f.writelines(lines)

        # --- 事後検証用のコンテキスト抽出 ---
        # 編集箇所の前後5行を含めて読み直す
        context_start = max(1, start - 5)
        context_end = min(len(lines), start + len(new_content_lines) + 5)
        
        context_preview = []
        for i in range(context_start, context_end + 1):
            line_idx = i - 1
            if 0 <= line_idx < len(lines):
                prefix = ">>>" if start <= i < start + len(new_content_lines) else "   "
                context_preview.append(f"{prefix}{i:4d}| {lines[line_idx].rstrip()}")

        preview_text = "\n".join(context_preview)

        return (
            f"Successfully edited {path}.\n"
            f"Replaced lines {start}-{end} ({old_count} lines) with {len(new_content_lines)} lines.\n"
            f"File now has {len(lines)} lines.\n\n"
            f"--- Post-edit Preview ({context_start}-{context_end}) ---\n"
            f"{preview_text}\n"
            f"--- End of Preview ---"
        )
